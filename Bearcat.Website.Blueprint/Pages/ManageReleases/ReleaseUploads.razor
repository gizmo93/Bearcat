@using Bearcat.Domain.UseCases.ManageReleases.Dto

<section class="space-y-4">
    <div class="bearcat-section-header">
        <div>
            <h2 class="text-lg font-semibold">@L["Uploads"]</h2>
        </div>

        <div class="bearcat-upload-filter-row">
            <label class="bearcat-page-size">
                <span>@L["UploadConfig"]</span>
                <BbSelect TValue="int"
                          @bind-Value="selectedUploadConfigId"
                          @bind-Value:after="OnUploadConfigFilterChangedAsync"
                          Options="UploadConfigOptions"
                          Placeholder="@L["AllUploadConfigs"]"
                          Class="w-56" />
            </label>

            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RefreshUploadsAsync">
                <LucideIcon Name="refresh-cw" class="h-4 w-4" />
                @L["Refresh"]
            </BbButton>
        </div>
    </div>

    <BbDataTable TData="ReleaseUploadDto"
                 @key="UploadsTableKey"
                 Data="uploads"
                 ShowToolbar="false"
                 ShowPagination="false"
                 InitialPageSize="@pageSize"
                 IsLoading="isLoading"
                 AriaLabel="@L["ReleaseUploads"]"
                 Class="bearcat-data-table">
        <Columns>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="string"
                               Header="@L["UploadConfig"]"
                               Property="@(upload => upload.UploadConfigName)"
                               MinWidth="220px">
                <CellTemplate Context="upload">
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium" title="@upload.UploadConfigName">
                            @upload.UploadConfigName
                        </p>
                        <p class="truncate text-xs text-muted-foreground" title="@upload.HosterRegistrationName">
                            @upload.HosterRegistrationName
                        </p>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="string"
                               Header="@L["OnlineState"]"
                               Property="@(upload => upload.OnlineState.ToString())"
                               Width="150px">
                <CellTemplate Context="upload">
                    <OnlineStateBadge Value="@upload.OnlineState" />
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="string"
                               Header="@L["State"]"
                               Property="@(upload => upload.UploadState.ToString())"
                               Width="165px">
                <CellTemplate Context="upload">
                    <BbBadge Variant="@GetUploadVariant(upload.UploadState)">
                        @L.Localize(upload.UploadState)
                    </BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="DateTime?"
                               Header="@L["UploadedAt"]"
                               Property="@(upload => upload.UploadedAt)"
                               Width="190px">
                <CellTemplate Context="upload">
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium">
                            @(upload.UploadedAt?.ToString("g") ?? "-")
                        </p>
                        <p class="truncate text-xs text-muted-foreground">
                            @L["CreatedAt"]: @upload.CreatedAt.ToString("g")
                        </p>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="int"
                               Header="@L["Links"]"
                               Property="@(upload => upload.LinkCount)"
                               Width="110px">
                <CellTemplate Context="upload">
                    <BbBadge Variant="BadgeVariant.Outline">@upload.LinkCount</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseUploadDto" TValue="int"
                               Header=""
                               Property="@(upload => upload.UploadId)"
                               Width="64px">
                <CellTemplate Context="upload">
                    <div class="flex justify-end">
                        <BbButton Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconSmall"
                                  Disabled="@(upload.LinkCount == 0)"
                                  AriaLabel="@L["ViewUploadLinks"]"
                                  OnClick="@(() => ShowLinksDialogAsync(upload))">
                            <LucideIcon Name="list" class="h-4 w-4" />
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
        <EmptyTemplate>
            <div class="bearcat-release-empty">
                <LucideIcon Name="inbox" class="h-5 w-5" />
                <span>@L["NoUploadsFound"]</span>
            </div>
        </EmptyTemplate>
    </BbDataTable>

    <div class="bearcat-release-pagination">
        <p class="text-sm text-muted-foreground">
            @L["UploadResultsSummary", FirstResult, LastResult, totalCount]
        </p>

        <div class="bearcat-release-pagination-controls">
            <label class="bearcat-page-size">
                <span>@L["RowsPerPage"]</span>
                <BbSelect TValue="int"
                          @bind-Value="pageSize"
                          @bind-Value:after="OnPageSizeChangedAsync"
                          Options="PageSizeOptions"
                          Class="w-24" />
            </label>

            @if (TotalPages > 1)
            {
                <BbPagination Class="bearcat-release-page-nav">
                    <BbPaginationContent>
                        <BbPaginationItem>
                            <BbPaginationPrevious Disabled="@(CurrentPage <= 1)"
                                                  Text="@L["Previous"]"
                                                  OnClick="GoToPreviousPageAsync" />
                        </BbPaginationItem>

                        @foreach (var page in PaginationItems)
                        {
                            <BbPaginationItem>
                                @if (page is null)
                                {
                                    <BbPaginationEllipsis />
                                }
                                else
                                {
                                    <BbPaginationLink IsActive="@(page == CurrentPage)"
                                                      OnClick="@(() => GoToPageAsync(page.Value))">
                                        @(page.Value)
                                    </BbPaginationLink>
                                }
                            </BbPaginationItem>
                        }

                        <BbPaginationItem>
                            <BbPaginationNext Disabled="@(CurrentPage >= TotalPages)"
                                              Text="@L["Next"]"
                                              OnClick="GoToNextPageAsync" />
                        </BbPaginationItem>
                    </BbPaginationContent>
                </BbPagination>
            }
        </div>
    </div>
</section>
