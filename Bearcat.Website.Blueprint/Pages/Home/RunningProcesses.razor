@using Bearcat.Website.Blueprint.Pages.Home.RunningArchives
@using Bearcat.Website.Blueprint.Pages.Home.RunningUploads
@inherits OwningComponentBase

<section class="space-y-4">
    <BbCard Class="border-border/70 shadow-sm">
        <BbCardHeader Class="space-y-4">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <div class="space-y-2">
                    <div class="flex items-center gap-3">
                        <BbCardTitle>@L["RunningProcesses"]</BbCardTitle>
                        @if (autoRefresh)
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">@L["AutoRefresh"]</BbBadge>
                        }
                    </div>
                    <BbCardDescription>
                        @L["RunningProcessesDescription"]
                    </BbCardDescription>
                </div>

                <div class="flex items-center gap-2">
                    <BbButton Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Icon"
                              Disabled="refreshInProgress"
                              AriaLabel="@L["Refresh"]"
                              OnClick="@(LoadDataAsync)">
                        <LucideIcon Name="refresh-cw" class="@($"h-4 w-4 {(refreshInProgress ? "animate-spin" : string.Empty)}")" />
                    </BbButton>

                    <BbButton Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Small"
                              Disabled="refreshInProgress"
                              OnClick="@(ToggleAutoRefresh)">
                        <LucideIcon Name="@(autoRefresh ? "pause" : "play")" class="h-4 w-4" />
                        @(autoRefresh ? L["PauseRefresh"] : L["EnableRefresh"])
                    </BbButton>
                </div>
            </div>
        </BbCardHeader>

        <BbCardContent>
            @if (SomethingIsRunning)
            {
                <div class="space-y-6">
                    @if (runningUploads.Count > 0)
                    {
                        <RunningUploads Uploads="runningUploads" />
                    }

                    @if (runningArchives.Count > 0)
                    {
                        <RunningArchives Archives="runningArchives" />
                    }
                </div>
            }
            else
            {
                <div class="rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
                    @L["CurrentlyNothingRunning"]
                </div>
            }
        </BbCardContent>
    </BbCard>
</section>
