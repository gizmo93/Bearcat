<BbSidebarGroup>
    <BbSidebarGroupLabel>Workspace</BbSidebarGroupLabel>
    <BbSidebarGroupContent>
        <BbSidebarMenu>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="Home">
                    <LucideIcon Name="house" class="h-4 w-4" />
                    <span>Home</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/hoster-registrations" Match="NavLinkMatch.Prefix" Tooltip="Hosters">
                    <LucideIcon Name="key-round" class="h-4 w-4" />
                    <span>Hoster registrations</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/link-crypter-registrations" Match="NavLinkMatch.Prefix" Tooltip="Crypters">
                    <LucideIcon Name="shield" class="h-4 w-4" />
                    <span>Crypter registrations</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/releases" Match="NavLinkMatch.Prefix" Tooltip="Releases">
                    <LucideIcon Name="upload" class="h-4 w-4" />
                    <span>Releases</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
        </BbSidebarMenu>
    </BbSidebarGroupContent>
</BbSidebarGroup>
