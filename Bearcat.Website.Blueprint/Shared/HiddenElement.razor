@inject DialogService DialogService

<div class="flex items-center gap-3">
    @if (isVisible)
    {
        @ChildContent
    }
    else
    {
        <p class="text-sm text-muted-foreground">******</p>
    }

    <BbButton Variant="ButtonVariant.Ghost"
              Size="ButtonSize.IconSmall"
              AriaLabel="@L["ToggleVisibility"]"
              OnClick="OnToggleVisibilityAsync">
        <LucideIcon Name="@(isVisible ? "eye-off" : "eye")" class="h-4 w-4" />
    </BbButton>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    private bool isVisible;

    private async Task OnToggleVisibilityAsync()
    {
        if (isVisible)
        {
            isVisible = false;
            return;
        }

        var result = await DialogService.ConfirmAsync(
            L["ShowHiddenContent"],
            L["ShowHiddenContentConfirmation"],
            new ConfirmDialogOptions
            {
                ConfirmText = L["Yes"],
                CancelText = L["No"]
            });

        if (result.Confirmed)
        {
            isVisible = true;
        }
    }
}
