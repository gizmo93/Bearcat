<div class="bearcat-folder-dialog">
    <div class="shrink-0">
        <BbFormFieldInput TValue="string"
                          @bind-Value="searchText"
                          Label="Search"
                          Placeholder="Search folders"
                          HelperText="Filter the loaded folder tree." />
    </div>

    <div class="bearcat-folder-tree">
        <BbTreeView TItem="FolderNode"
                    Items="filteredRootNodes"
                    TextField="@(node => node.Name)"
                    ValueField="@(node => node.Path)"
                    ChildrenProperty="@(node => node.Children)"
                    SelectionMode="TreeSelectionMode.Single"
                    @bind-SelectedValue="selectedItem"
                    DefaultExpandDepth="1"
                    ShowIcons="true"
                    AriaLabel="Folder selection tree" />
    </div>

    @if (!string.IsNullOrWhiteSpace(selectedItem))
    {
        <div class="shrink-0 rounded-lg border border-border/70 bg-muted/30 px-3 py-2 text-sm">
            <span class="text-muted-foreground">Selected:</span>
            <span class="ml-2 break-all font-medium">@selectedItem</span>
        </div>
    }

    <div class="bearcat-folder-dialog-footer">
        <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
            Cancel
        </BbButton>
        <BbButton Disabled="@string.IsNullOrWhiteSpace(selectedItem)" OnClick="SaveAsync">
            Save
        </BbButton>
    </div>
</div>
