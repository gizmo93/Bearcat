<FluentGrid Spacing="2">
    <FluentGridItem xs="12" lg="12">
        @Header
    </FluentGridItem>
    @if (Menu is not null)
    {
        <FluentGridItem xs="12" lg="12">
            @Menu
        </FluentGridItem>   
    }
    <FluentGridItem xs="12" lg="12">
       @Body
    </FluentGridItem>
</FluentGrid>

@code {
    [Parameter] 
    [EditorRequired]
    public RenderFragment Header { get; set; } = null!;
    
    [Parameter]
    public RenderFragment? Menu { get; set; }
    
    [Parameter]
    [EditorRequired]
    public RenderFragment Body { get; set; } = null!;
}