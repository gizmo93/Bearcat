<MudDialog>
    <TitleContent>
        @MudDialog.Title
    </TitleContent>
    <DialogContent>
        <MudTreeView
            Hover
            @bind-SelectedValue="selectedItem"
            SelectionMode="SelectionMode.SingleSelection"
            Items="initialTreeItems"
            ServerData="@GetTreeViewItems"
            AutoExpand="true">
            <ItemTemplate>
                <MudTreeViewItem 
                    Text="@context.Text"
                    Value="@context.Value" 
                    Items="@context.Children" 
                    CanExpand="@context.Expandable"
                    Icon="@context.Icon" 
                    LoadingIconColor="Color.Info" 
                />
            </ItemTemplate>
        </MudTreeView>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="@(() => MudDialog.Close())" StartIcon="@Icons.Material.Filled.Cancel">
            Cancel
        </MudButton>
        <MudButton
            Color="Color.Primary"
            Disabled="@string.IsNullOrWhiteSpace(selectedItem)"
            OnClick="@(() => Save())"
            StartIcon="@Icons.Material.Filled.Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>