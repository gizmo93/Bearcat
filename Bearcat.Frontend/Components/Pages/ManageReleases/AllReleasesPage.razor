@page "/releases"

<PageTitle>Releases</PageTitle>


<MudStack Spacing="3" AlignItems="AlignItems.Start">
    <MudText Typo="Typo.h4">Releases</MudText>
    <MudButton
        Variant="Variant.Filled"
        OnClick="@(() => ShowAddReleaseDialogAsync())"
        StartIcon="@Icons.Material.Filled.Add">
        Add release
    </MudButton>
    <MudDataGrid Items="releases" SortMode="SortMode.Multiple">
        <Columns>
            <TemplateColumn Title="Name" Sortable="true" SortBy="@(row => row.Name)">
                <CellTemplate>
                    <MudLink OnClick="@(() => navigationManager.NavigateTo($"releases/{context.Item.ReleaseId}"))">
                        @context.Item.Name
                    </MudLink>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(row => row.ReleaseType)" Title="Release type"/>
            <PropertyColumn Property="@(row => row.ArchiveConfigCount)" Title="# Archive configs"/>
            <PropertyColumn Property="@(row => row.UploadConfigCount)" Title="# Upload configs"/>
        </Columns>
    </MudDataGrid>
</MudStack>