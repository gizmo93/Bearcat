@page "/HosterRegistration"
<h3>Hoster Registrations</h3>

<FluentGrid>
    <FluentGridItem xs="12" lg="12">
        <FluentToolbar id="toolbar-fluent-components">
            <FluentButton
                IconStart="@(new Icons.Filled.Size20.Add())"
                Appearance="Appearance.Accent"
                OnClick="@(ShowAddDialogAsync)">
                Add Hoster
            </FluentButton>
        </FluentToolbar>

        <FluentDataGrid Items="hosters" AutoFit="true" MultiLine="true">
            <PropertyColumn Property="@(row => row.Name)" Title="Name"/>
            <PropertyColumn Property="@(row => row.HosterName)" Title="Hoster"/>
            <TemplateColumn Title="Is active">
                @(context.IsActive ? "Yes" : "No")
            </TemplateColumn>
            <TemplateColumn Title="Config">
                <FluentDataGrid Items="@context.Configuration.AsQueryable()">
                    <TemplateColumn Title="Name" Context="item">
                        @item.Key
                    </TemplateColumn>
                    <TemplateColumn Title="Value" Context="item">
                        @item.Value
                    </TemplateColumn>
                </FluentDataGrid>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <FluentButton IconStart="@(new Icons.Filled.Size20.Edit())" Appearance="Appearance.Neutral" Title="Edit"  OnClick="@(() => ShowEditDialogAsync(context))" />
                <FluentButton IconStart="@(new Icons.Filled.Size20.Delete())" Appearance="Appearance.Neutral" Title="Delete" />
                
                @if (context.IsActive)
                {
                    <FluentButton IconStart="@(new Icons.Filled.Size20.Stop())" Appearance="Appearance.Neutral" Title="Disable" OnClick="@(() => ToggleIsActiveAsync(context))" />
                }
                else
                {
                    <FluentButton IconStart="@(new Icons.Filled.Size20.Play())" Appearance="Appearance.Neutral" Title="Enable" OnClick="@(() => ToggleIsActiveAsync(context))" />
                }
            </TemplateColumn>
        </FluentDataGrid>
    </FluentGridItem>
</FluentGrid>