@page "/hoster-registrations"
@using BearCat.Core.Domain.UseCases.ManageHosters.Dto
@using Bearcat.Frontend.Components.Shared
@inherits OwningComponentBase

<PageTitle>Hoster registrations</PageTitle>

<MudStack AlignItems="AlignItems.Start" Spacing="3">
    <MudText Typo="Typo.h4">Hoster registrations</MudText>
    
    <MudFab 
        Size="Size.Small"
        StartIcon="@Icons.Material.Filled.Add"
        OnClick="@(() => ShowAddDialogAsync())"
        Color="Color.Primary"
        Label="Add Hoster" />
    
    <MudDataGrid 
        T="HosterRegistrationDto"
        Items="hosters"
        Hover
        SortMode="SortMode.Multiple"
        RowContextMenuClick="@(OpenMenuContent)">
        <Columns>
            <PropertyColumn Property="@(row => row.Name)" Title="Name"/>
            <PropertyColumn Property="@(row => row.HosterName)" Title="Hoster name"/>
            <TemplateColumn Title="Is Active" SortBy="@(row => row.IsActive)" Sortable="true">
                <CellTemplate>
                    @(context.Item.IsActive ? "Yes" : "No")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Config">
                <CellTemplate>
                    <MudExpansionPanel>
                        <TitleContent>
                            Show configuration
                        </TitleContent>
                        <ChildContent>
                            <MudTable Items="context.Item.Configuration">
                                <HeaderContent>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Value</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="config">
                                    <MudTd>@config.Key</MudTd>
                                    <MudTd>
                                        @if (config.Key.ToLowerInvariant() == "password")
                                        {
                                            <HiddenElement>
                                                @config.Value
                                            </HiddenElement>
                                        }
                                        else
                                        {
                                            @config.Value
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn>
                <CellTemplate>
                    <MudButton OnClick="@(() => TryLoginAsync(context.Item!))">Try login</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    <MudMenu PositionAtCursor="true" @ref="contextMenu" id="contextMenu">
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ShowEditDialogAsync(contextMenuRow!))">
            Edit @contextMenuRow!.Name
        </MudMenuItem>
        <MudMenuItem Icon="@(contextMenuRow!.IsActive ? Icons.Material.Filled.ToggleOff : Icons.Material.Filled.ToggleOn)" OnClick="@(() => ToggleIsActiveAsync(contextMenuRow!))">
            @(contextMenuRow!.IsActive ? "Disable" : "Enable") @contextMenuRow!.Name
        </MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteAsync(contextMenuRow!))">
            Delete @contextMenuRow!.Name
        </MudMenuItem>
    </MudMenu>
</MudStack>