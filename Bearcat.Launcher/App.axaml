<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bearcat.Launcher.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
             
    <TrayIcon.Icons>
        <TrayIcons>
           <TrayIcon Icon="/Assets/trayicon.png" ToolTipText="Test">
               <TrayIcon.Menu>
                   <NativeMenu>
                       <NativeMenuItem Header="Open Bearcat Launcher Window" Click="OpenBearcatLauncherWindow_OnClick" />
                       <NativeMenuItemSeparator />
                       <NativeMenuItem Header="Exit Bearcat" Click="ExitBearcat_OnClick" />
                       <NativeMenuItem Header="Test">
                           <NativeMenu>
                               <NativeMenuItem Header="Option 1" />
                           </NativeMenu>
                       </NativeMenuItem>
                   </NativeMenu>
               </TrayIcon.Menu>
           </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>