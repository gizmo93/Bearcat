
@if (!isInitialized)
{
    return;
}

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldSelect TValue="int?"
                               @bind-Value="formModel.LinkCrypterRegistrationId"
                               @bind-Value:after="OnLinkCrypterRegistrationChanged"
                               Label="@L["LinkCrypter"]"
                               Placeholder="@L["SelectLinkCrypter"]"
                               Disabled="IsEdit"
                               Options="linkCrypterOptions
                                   .OrderBy(option => option.Name)
                                   .Select(option => new SelectOption<int?>(
                                       option.LinkCrypterRegistrationId,
                                       option.Name))" />

            <BbFormFieldInput TValue="string"
                              @bind-Value="formModel.Password"
                              Label="@L["ContainerPassword"]"
                              Placeholder="@L["ContainerPasswordPlaceholder"]" />

            @if (CanUseCaptcha)
            {
                <BbFormFieldSwitch @bind-Checked="formModel.EnableCaptcha"
                                   Label="@L["Captcha"]" />
            }

            @if (CanUseContainerDownload)
            {
                <BbFormFieldSwitch @bind-Checked="formModel.EnableContainerDownload"
                                   Label="@L["ContainerDownload"]" />
            }

            @if (CanUseClickAndLoad)
            {
                <BbFormFieldSwitch @bind-Checked="formModel.EnableClickAndLoad"
                                   Label="@L["ClickAndLoad"]" />
            }
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
