<div class="space-y-6">
    <div class="space-y-1">
        <div class="flex flex-wrap items-start justify-between gap-2">
            <h2 class="text-xl font-semibold tracking-tight">@L["Hoster"]</h2>
            <a href="@PostInstallationDocumentationUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="inline-flex items-center gap-1 text-sm font-medium text-primary underline-offset-4 hover:underline">
                @L["FirstStartSetupLearnMore"]
                <LucideIcon Name="external-link" class="h-3.5 w-3.5" />
            </a>
        </div>
        <p class="text-sm text-muted-foreground">@L["FirstStartSetupHosterDescription"]</p>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Small" />
            <span>@L["Loading"]</span>
        </div>
    }
    else if (hosterRegistrations.Count == 0)
    {
        <BbEmpty Title="@L["FirstStartSetupNoHosterRegistrations"]"
                 Description="@L["FirstStartSetupNoHosterRegistrationsDescription"]"
                 Size="EmptySize.Small">
            <Icon>
                <LucideIcon Name="server" class="h-6 w-6 text-muted-foreground" />
            </Icon>
        </BbEmpty>
    }
    else
    {
        <ul class="divide-y divide-border/70 rounded-md border border-border/70">
            @foreach (var hosterRegistration in hosterRegistrations)
            {
                var checkboxId = $"first-start-setup-hoster-{hosterRegistration.Id}";
                var loginResult = GetLoginResult(hosterRegistration.Id);

                <li class="flex flex-col gap-2 px-3 py-3">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex min-w-0 items-center gap-3">
                            <BbCheckbox Id="@checkboxId"
                                        Checked="@WizardState.SelectedHosterRegistrationIds.Contains(hosterRegistration.Id)"
                                        CheckedChanged="@(isChecked => SetHosterRegistrationSelected(hosterRegistration.Id, isChecked))"
                                        AriaLabel="@hosterRegistration.Name" />
                            <label for="@checkboxId" class="flex min-w-0 cursor-pointer flex-col">
                                <span class="truncate text-sm font-medium">@hosterRegistration.Name</span>
                                <span class="truncate text-xs text-muted-foreground">@hosterRegistration.HosterName</span>
                            </label>
                            @if (!hosterRegistration.IsActive)
                            {
                                <BbBadge Variant="BadgeVariant.Outline">@L["Inactive"]</BbBadge>
                            }
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            @if (hosterRegistration is { SupportsCaptchaVerification: true, RequiresCaptchaVerification: true })
                            {
                                <BbButton Class="bearcat-captcha-action-button"
                                          Variant="ButtonVariant.Destructive"
                                          Size="ButtonSize.Small"
                                          Disabled="@hosterRegistration.HasUnreadableSecrets"
                                          OnClick="@(() => ShowCaptchaDialogAsync(hosterRegistration))">
                                    <LucideIcon Name="shield-alert" class="h-4 w-4" />
                                    <span>@L["SolveCaptchaShort"]</span>
                                </BbButton>
                            }
                            <BbButton Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Small"
                                      Loading="@hosterRegistrationIdsWithRunningLogin.Contains(hosterRegistration.Id)"
                                      Disabled="@hosterRegistration.HasUnreadableSecrets"
                                      OnClick="@(() => TryLoginAsync(hosterRegistration.Id))">
                                @L["TryLogin"]
                            </BbButton>
                        </div>
                    </div>

                    @if (hosterRegistration.HasUnreadableSecrets)
                    {
                        <UnreadableSecretsBadge />
                    }

                    @if (loginResult is { IsSuccess: true })
                    {
                        <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideIcon Name="check" class="h-3.5 w-3.5 shrink-0" />
                            @L["FirstStartSetupLoginSuccessful"]
                        </span>
                    }
                    else if (loginResult is { IsSuccess: false })
                    {
                        <span class="flex items-start gap-1.5 text-xs text-destructive">
                            <LucideIcon Name="circle-alert" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
                            <span class="break-words">@L["FirstStartSetupLoginFailed", loginResult.ErrorMessage ?? string.Empty]</span>
                        </span>
                    }
                </li>
            }
        </ul>
    }

    <div>
        <BbButton Variant="ButtonVariant.Outline" OnClick="ShowAddHosterDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["AddHoster"]
        </BbButton>
    </div>

    @if (!WizardState.HasSelectedHosterRegistrationWithSuccessfulLogin())
    {
        <p class="text-xs text-muted-foreground">@L["FirstStartSetupHosterNextRequirement"]</p>
    }

    <FirstStartSetupStepNavigation OnBack="OnBack" OnSkip="OnSkip">
        <BbButton Disabled="!WizardState.HasSelectedHosterRegistrationWithSuccessfulLogin()"
                  OnClick="@(() => OnNext.InvokeAsync())">
            @L["Next"]
            <LucideIcon Name="arrow-right" class="h-4 w-4" />
        </BbButton>
    </FirstStartSetupStepNavigation>
</div>
