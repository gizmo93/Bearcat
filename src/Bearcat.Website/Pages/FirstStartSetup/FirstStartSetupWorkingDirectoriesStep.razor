<div class="space-y-6">
    <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-tight">@L["WorkingDirectories"]</h2>
        <p class="text-sm text-muted-foreground">@L["FirstStartSetupWorkingDirectoriesDescription"]</p>
    </div>

    @if (Status.WorkingDirectoryStatuses.Count == 0)
    {
        <div class="flex items-start gap-2 rounded-md border border-destructive/40 bg-destructive/5 px-3 py-2 text-sm text-destructive">
            <LucideIcon Name="circle-alert" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>@L["FirstStartSetupNoWorkingDirectoryConfigured"]</span>
        </div>
    }
    else
    {
        <ul class="divide-y divide-border/70 rounded-md border border-border/70">
            @foreach (var workingDirectoryStatus in Status.WorkingDirectoryStatuses)
            {
                <li class="flex flex-col gap-2 px-3 py-2.5 sm:flex-row sm:items-center sm:justify-between">
                    <span class="flex min-w-0 items-center gap-2 text-sm">
                        <LucideIcon Name="folder" class="h-4 w-4 shrink-0 text-muted-foreground" />
                        <span class="break-all font-mono text-xs">@workingDirectoryStatus.Path</span>
                    </span>
                    @if (!workingDirectoryStatus.Exists)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive" Class="self-start sm:self-auto">@L["FirstStartSetupWorkingDirectoryMissing"]</BbBadge>
                    }
                    else if (!workingDirectoryStatus.IsWritable)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive" Class="self-start sm:self-auto">@L["FirstStartSetupWorkingDirectoryNotWritable"]</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Secondary" Class="self-start sm:self-auto">@L["FirstStartSetupWorkingDirectoryOk"]</BbBadge>
                    }
                </li>
            }
        </ul>
    }

    <div class="flex items-start gap-2 rounded-md border border-border/70 bg-muted/30 px-3 py-2 text-sm text-muted-foreground">
        <LucideIcon Name="info" class="mt-0.5 h-4 w-4 shrink-0" />
        <span>
            @(isRunningInContainer
                ? L["FirstStartSetupWorkingDirectoriesContainerHint"]
                : L["FirstStartSetupWorkingDirectoriesDesktopHint"])
        </span>
    </div>

    <FirstStartSetupStepNavigation OnBack="OnBack" OnSkip="OnSkip">
        <BbButton Variant="ButtonVariant.Outline" Loading="isCheckingAgain" OnClick="CheckAgainAsync">
            <LucideIcon Name="refresh-cw" class="h-4 w-4" />
            @L["FirstStartSetupCheckAgain"]
        </BbButton>
        <BbButton Disabled="!Status.HasExistingWritableWorkingDirectory()" OnClick="@(() => OnNext.InvokeAsync())">
            @L["Next"]
            <LucideIcon Name="arrow-right" class="h-4 w-4" />
        </BbButton>
    </FirstStartSetupStepNavigation>
</div>
