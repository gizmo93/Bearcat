<div class="space-y-6">
    <h2 class="text-xl font-semibold tracking-tight">@L["FirstStartSetupWelcomeTitle"]</h2>

    <ol class="flex flex-wrap items-center gap-2" aria-label="@L["FirstStartSetupLifecycle"]">
        @LifecycleStage("folder", L["Folder"], isLastStage: false)
        @LifecycleStage("package", L["Release"], isLastStage: false)
        @LifecycleStage("archive", L["Archive"], isLastStage: false)
        @LifecycleStage("upload", L["Upload"], isLastStage: false)
        @LifecycleStage("link", L["FirstStartSetupLinkCheck"], isLastStage: false)
        @LifecycleStage("refresh-cw", L["Reupload"], isLastStage: true)
    </ol>

    <div class="space-y-1 text-sm text-muted-foreground">
        <p>@L["FirstStartSetupWelcomeDescription"]</p>
        <p>@L["FirstStartSetupWelcomeWizardDescription"]</p>
    </div>

    <div class="flex flex-col-reverse gap-2 border-t border-border/70 pt-4 sm:flex-row sm:justify-end">
        <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => OnSkipSetup.InvokeAsync())">
            @L["FirstStartSetupSkipSetup"]
        </BbButton>
        <BbButton OnClick="@(() => OnStart.InvokeAsync())">
            @L["FirstStartSetupStartSetup"]
            <LucideIcon Name="arrow-right" class="h-4 w-4" />
        </BbButton>
    </div>
</div>

@code {
    private static RenderFragment LifecycleStage(string iconName, string label, bool isLastStage) =>
        @<li class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-sm">
                <LucideIcon Name="@iconName" class="h-4 w-4 text-muted-foreground" />
                @label
            </span>
            @if (!isLastStage)
            {
                <LucideIcon Name="arrow-right" class="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
            }
        </li>;
}
