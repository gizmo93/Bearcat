@using Bearcat.Domain.UseCases.ImportLinkCrypterContainers.Preview
@using Bearcat.Website.Pages.ManageReleases.Results

@{
    RenderFragment<LinkCrypterImportMirror> mirrorSummary = mirror =>
        @<span class="[overflow-wrap:anywhere]">
            <span class="font-medium text-foreground">@L["MirrorNumber", mirror.MirrorNumber]</span>
            · @GetHosterName(mirror.HosterClassName)
            @if (mirror.Decision is { } decision)
            {
                <span> · @L.Localize(decision)</span>
            }
            @if (mirror.UploadByBearcatReason is { } uploadByBearcatReason)
            {
                <span> (@L.Localize(uploadByBearcatReason))</span>
            }
        </span>;
}

<div class="space-y-4">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="@L["Status"]">
        <BbButton Variant="@(selectedStatus is null ? ButtonVariant.Default : ButtonVariant.Outline)"
                  Size="ButtonSize.Small"
                  OnClick="@(() => SelectStatusAsync(null))">
            @L["All"] <span class="tabular-nums">@Detail.ContainerCountsByStatus.Sum(count => count.Count)</span>
        </BbButton>
        @foreach (var statusCount in Detail.ContainerCountsByStatus)
        {
            <BbButton Variant="@(selectedStatus == statusCount.Status ? ButtonVariant.Default : ButtonVariant.Outline)"
                      Size="ButtonSize.Small"
                      OnClick="@(() => SelectStatusAsync(statusCount.Status))">
                @L.Localize(statusCount.Status) <span class="tabular-nums">@statusCount.Count</span>
            </BbButton>
        }
        <BbInput Value="@searchText"
                 ValueChanged="SearchAsync"
                 UpdateTiming="UpdateTiming.Debounced"
                 DebounceInterval="300"
                 Placeholder="@L["LinkCrypterImportSearchPlaceholder"]"
                 AriaLabel="@L["Search"]"
                 autocomplete="off"
                 spellcheck="false"
                 Class="w-full sm:ml-auto sm:w-80" />
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        @if (CanChangeSelection)
        {
            <div class="flex items-center gap-2">
                <BbCheckbox Id="link-crypter-import-select-all-selectable"
                            Checked="AreAllSelectableContainersSelected"
                            Indeterminate="AreSomeSelectableContainersSelected"
                            CheckedChanged="SetSelectionOfAllSelectableContainersAsync" />
                <label for="link-crypter-import-select-all-selectable" class="text-sm font-medium">
                    @(IsFilterActive ? L["SelectAllInResult"] : L["SelectAll"])
                </label>
            </div>
        }

        @if (CanChangeReleases && SelectedReleaseCount > 0)
        {
            <div class="flex flex-wrap items-center gap-1 sm:ml-auto">
                @if (isSettingReleaseTemplate)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Disabled="true">
                        <LucideIcon Name="loader-circle" class="h-4 w-4 animate-spin" />
                        @L["SetReleaseTemplateForReleases", SelectedReleaseCount]
                    </BbButton>
                }
                else
                {
                    @if (Detail.SeriesReleaseTemplateId is not null)
                    {
                        <ReleaseBulkActionMenuButton TValue="int"
                                                     Label="@L["SetReleaseTemplateForReleases", SelectedReleaseCount]"
                                                     Icon="layout-template"
                                                     Options="ReleaseTemplateOptions"
                                                     OnSelect="StartSettingReleaseTemplate" />
                    }
                    <ReleaseBulkActionMenuButton TValue="string"
                                                 Label="@L["SetPrimaryLanguageForReleases", SelectedReleaseCount]"
                                                 Icon="languages"
                                                 Options="PrimaryLanguageOptions"
                                                 OnSelect="SetPrimaryLanguageAsync" />
                }
            </div>
        }
    </div>

    @if (releases.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-border/70 px-4 py-8 text-sm text-muted-foreground">
            @L["NoLinkCrypterImportReleasesFound"]
        </div>
    }
    else
    {
        <div class="bearcat-config-list">
            <div class="@($"bearcat-config-header {ReleaseGridClass}")">
                <span>@L["Release"]</span>
                <span>@L["ReleaseAction"]</span>
                <span>@L["LocalFiles"]</span>
                <span>@L["ReleaseTemplate"]</span>
            </div>
            @foreach (var (release, releaseNumber) in releases.Select((release, position) => (release, position)))
            {
                var checkboxId = $"link-crypter-import-release-{releaseNumber}";

                <div class="bearcat-config-item">
                    <div class="@($"bearcat-config-row {ReleaseGridClass}")">
                        <div class="flex min-w-0 items-start gap-3">
                            @if (CanChangeSelection && release.HasSelectableContainers)
                            {
                                <BbCheckbox Id="@checkboxId"
                                            Class="mt-0.5"
                                            Checked="release.IsSelected"
                                            Indeterminate="IsReleasePartlySelected(release)"
                                            CheckedChanged="@(isSelected => SetReleaseSelectionAsync(release, isSelected))"
                                            AriaLabel="@release.ReleaseName" />
                            }
                            @if (release.ReleaseName == releaseNameBeingEdited)
                            {
                                <form class="flex min-w-0 flex-1 flex-wrap items-center gap-2" @onsubmit="RenameReleaseAsync">
                                    <BbInput @bind-Value="editedReleaseName"
                                             UpdateTiming="UpdateTiming.Immediate"
                                             AriaLabel="@L["ReleaseName"]"
                                             autocomplete="off"
                                             spellcheck="false"
                                             data-autofocus
                                             class="min-w-48 flex-1" />
                                    <BbButton Type="ButtonType.Submit"
                                              Size="ButtonSize.Small"
                                              Disabled="@(isRenaming || string.IsNullOrWhiteSpace(editedReleaseName))">
                                        @L["Save"]
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Outline"
                                              Size="ButtonSize.Small"
                                              Disabled="isRenaming"
                                              OnClick="CancelRenaming">
                                        @L["Cancel"]
                                    </BbButton>
                                </form>
                            }
                            else
                            {
                                <div class="flex min-w-0 items-start gap-1">
                                    <label for="@checkboxId" class="block text-sm font-semibold [overflow-wrap:anywhere]">@release.ReleaseName</label>
                                    @if (CanChangeReleases)
                                    {
                                        <BbButton Variant="ButtonVariant.Ghost"
                                                  Size="ButtonSize.IconSmall"
                                                  Class="-my-1 shrink-0"
                                                  AriaLabel="@L["RenameRelease"]"
                                                  title="@L["RenameRelease"]"
                                                  OnClick="@(() => StartRenaming(release))">
                                            <LucideIcon Name="pencil" class="h-3.5 w-3.5" />
                                        </BbButton>
                                    }
                                </div>
                            }
                        </div>

                        <div class="min-w-0 space-y-1">
                            <p class="bearcat-mobile-label">@L["ReleaseAction"]</p>
                            @if (release.ReleaseAction is { } releaseAction)
                            {
                                @if (release.ExistingReleaseId is { } existingReleaseId)
                                {
                                    <a href="@($"/releases/{existingReleaseId}")"
                                       class="flex items-center gap-1 text-sm text-primary hover:underline">
                                        <LucideIcon Name="package" class="h-3.5 w-3.5 shrink-0" />
                                        @L.Localize(releaseAction)
                                    </a>
                                }
                                else
                                {
                                    <p class="text-sm">@L.Localize(releaseAction)</p>
                                }
                            }
                            else
                            {
                                <p class="text-sm text-muted-foreground">-</p>
                            }
                        </div>

                        <div class="min-w-0 space-y-1">
                            <p class="bearcat-mobile-label">@L["LocalFiles"]</p>
                            <p class="text-sm text-muted-foreground [overflow-wrap:anywhere]">
                                @GetLocalFilesText(release)
                            </p>
                        </div>

                        <div class="min-w-0 space-y-0.5">
                            <p class="bearcat-mobile-label">@L["ReleaseTemplate"]</p>
                            <p class="text-sm [overflow-wrap:anywhere]">@release.ReleaseTemplateName</p>
                            <p class="text-xs text-muted-foreground">
                                @L["Language"]: <span class="text-foreground">@GetLanguageDisplayName(release.PrimaryLanguageCode)</span>
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 border-t border-border/70 bg-muted/20 px-4 py-2">
                        @foreach (var container in release.Containers)
                        {
                            <div class="space-y-1">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                    <BbBadge Variant="@GetStatusBadgeVariant(container.Status)">@L.Localize(container.Status)</BbBadge>
                                    <a href="@container.ContainerUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="@L["OpenCrypterFolder"]"
                                       class="inline-flex min-w-0 items-center gap-1 text-primary hover:underline [overflow-wrap:anywhere]">
                                        <LucideIcon Name="external-link" class="h-3.5 w-3.5 shrink-0" />
                                        @container.ContainerName
                                    </a>
                                    @if (container.NotImportableReason is { } notImportableReason)
                                    {
                                        <span>@L.Localize(notImportableReason)</span>
                                    }
                                    @if (container.Preview.Releases is { Count: > 1 })
                                    {
                                        @if (container.Preview.ReleaseCollectionName is { } releaseCollectionName)
                                        {
                                            <span class="[overflow-wrap:anywhere]">@L["LinkCrypterImportReleaseCollection", releaseCollectionName]</span>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var mirror in GetMirrorsOfSingleRelease(container.Preview))
                                        {
                                            @mirrorSummary(mirror)
                                        }
                                    }
                                    @if (container.ImportedReleaseId is { } importedReleaseId)
                                    {
                                        <a href="@($"/releases/{importedReleaseId}")"
                                           class="inline-flex items-center gap-1 text-primary hover:underline">
                                            <LucideIcon Name="package" class="h-3.5 w-3.5 shrink-0" />
                                            @L["OpenImportedRelease"]
                                        </a>
                                    }
                                    @if (container.ImportedReleaseCollectionId is { } importedReleaseCollectionId)
                                    {
                                        <a href="@($"/release-collections/{importedReleaseCollectionId}")"
                                           class="inline-flex items-center gap-1 text-primary hover:underline">
                                            <LucideIcon Name="library" class="h-3.5 w-3.5 shrink-0" />
                                            @L["OpenImportedReleaseCollection"]
                                        </a>
                                    }
                                </div>
                                @if (container.Preview.Releases is { Count: > 1 } releasePreviews)
                                {
                                    var mirrorsWithoutRelease = GetMirrorsWithoutRelease(container.Preview);

                                    @if (mirrorsWithoutRelease.Count > 0)
                                    {
                                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                            <span>@L["LinkCrypterImportMirrorsWithoutRelease"]</span>
                                            @foreach (var mirror in mirrorsWithoutRelease)
                                            {
                                                @mirrorSummary(mirror)
                                            }
                                        </div>
                                    }

                                    <div class="space-y-2 border-l border-border/70 pl-3">
                                        @foreach (var releasePreview in releasePreviews)
                                        {
                                            <div class="space-y-0.5 text-xs text-muted-foreground">
                                                <div class="@($"grid gap-x-3 gap-y-0.5 {ReleaseGridClass}")">
                                                    <span class="font-medium text-foreground [overflow-wrap:anywhere]">@releasePreview.ReleaseName</span>
                                                    @if (releasePreview.ExistingReleaseId is { } existingReleaseId)
                                                    {
                                                        <a href="@($"/releases/{existingReleaseId}")"
                                                           class="inline-flex items-center gap-1 text-primary hover:underline">
                                                            <LucideIcon Name="package" class="h-3.5 w-3.5 shrink-0" />
                                                            @L.Localize(releasePreview.ReleaseAction)
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span>@L.Localize(releasePreview.ReleaseAction)</span>
                                                    }
                                                    <span class="[overflow-wrap:anywhere]">@GetLocalFilesText(container, releasePreview)</span>
                                                </div>
                                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                                    @if (releasePreview.NotImportableReason is { } releaseNotImportableReason)
                                                    {
                                                        <span>@L.Localize(releaseNotImportableReason)</span>
                                                    }
                                                    @foreach (var mirror in releasePreview.Mirrors)
                                                    {
                                                        @mirrorSummary(mirror)
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (container.ErrorMessages.Count > 0)
                                {
                                    <p class="text-xs whitespace-pre-wrap text-destructive [overflow-wrap:anywhere]">
                                        @string.Join(Environment.NewLine, container.ErrorMessages)
                                    </p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="bearcat-release-pagination">
        <p class="text-sm text-muted-foreground">
            @L["LinkCrypterImportReleaseResultsSummary", FirstResult, LastResult, totalCount]
        </p>

        <PageNavigation CurrentPage="CurrentPage"
                        TotalPages="TotalPages"
                        OnPageSelected="GoToPageAsync" />
    </div>
</div>
