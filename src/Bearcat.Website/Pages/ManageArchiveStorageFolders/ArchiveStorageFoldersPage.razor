@page "/archive-storage-folders"
@using Bearcat.Website.Formatting

<PageTitle>@L["ArchiveStorageFolders"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div class="min-w-0 space-y-2">
            <h1 class="text-3xl font-semibold tracking-tight">@L["ArchiveStorageFolders"]</h1>
            <p class="text-sm text-muted-foreground">@L["ArchiveStorageFoldersIntro"]</p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewArchiveStorageFolder"]
        </BbButton>
    </div>

    @if (storageFolders.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-border/70 px-4 py-8 text-sm text-muted-foreground">
            @L["NoArchiveStorageFoldersYet"]
        </div>
    }
    else
    {
        <div class="bearcat-config-list">
            <div class="bearcat-config-header lg:grid-cols-[minmax(0,2fr)_5rem_minmax(0,1fr)_6rem_minmax(0,1fr)_7rem_84px]">
                <span>@L["Name"]</span>
                <span>@L["Priority"]</span>
                <span>@L["AvailableFreeSpace"]</span>
                <span>@L["Archives"]</span>
                <span>@L["Reupload"]</span>
                <span>@L["Status"]</span>
                <span class="text-right">@L["Actions"]</span>
            </div>
            @foreach (var item in storageFolders)
            {
                var storageFolder = item.StorageFolder;

                <div class="bearcat-config-item">
                    <div class="bearcat-config-row lg:grid-cols-[minmax(0,2fr)_5rem_minmax(0,1fr)_6rem_minmax(0,1fr)_7rem_84px]">
                        <div class="min-w-0 space-y-1">
                            <p class="truncate text-sm font-semibold" title="@storageFolder.Name">@storageFolder.Name</p>
                            <p class="truncate font-mono text-xs text-muted-foreground" title="@storageFolder.Path">@storageFolder.Path</p>
                        </div>

                        <div>
                            <p class="bearcat-mobile-label">@L["Priority"]</p>
                            <span class="text-sm tabular-nums">@storageFolder.Priority</span>
                        </div>

                        <div class="min-w-0">
                            <p class="bearcat-mobile-label">@L["AvailableFreeSpace"]</p>
                            <div class="flex flex-col text-xs tabular-nums">
                                @if (item.AvailableFreeSpaceBytes is { } availableFreeSpaceBytes)
                                {
                                    <span class="whitespace-nowrap text-sm">@TransferFormatting.FormatBytes(availableFreeSpaceBytes)</span>
                                }
                                else
                                {
                                    <span class="whitespace-nowrap text-sm text-destructive">@L["FreeSpaceUnavailable"]</span>
                                }
                                <span class="whitespace-nowrap text-muted-foreground">@L["MinimumFreeSpaceValue", storageFolder.MinimumFreeSpaceGb]</span>
                            </div>
                        </div>

                        <div>
                            <p class="bearcat-mobile-label">@L["Archives"]</p>
                            <span class="text-sm tabular-nums">@storageFolder.StoredArchiveCount</span>
                        </div>

                        <div class="min-w-0">
                            <p class="bearcat-mobile-label">@L["Reupload"]</p>
                            <span class="text-sm">
                                @(storageFolder.UseLocalWorkingCopyForReuploads ? L["UseLocalWorkingCopyForReuploadsEnabled"] : L["UseLocalWorkingCopyForReuploadsDisabled"])
                            </span>
                        </div>

                        <div>
                            <p class="bearcat-mobile-label">@L["Status"]</p>
                            <BbBadge Variant="@(storageFolder.IsActive ? BadgeVariant.Default : BadgeVariant.Outline)">
                                @(storageFolder.IsActive ? L["Active"] : L["Inactive"])
                            </BbBadge>
                        </div>

                        <div class="bearcat-config-actions">
                            <BbDropdownMenu>
                                <BbDropdownMenuTrigger>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["Actions"]">
                                        <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                    </BbButton>
                                </BbDropdownMenuTrigger>
                                <BbDropdownMenuContent Align="PopoverAlign.End" Strategy="PositioningStrategy.Fixed">
                                    <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(storageFolder))">
                                        @L["Edit"]
                                    </BbDropdownMenuItem>
                                    <BbDropdownMenuItem OnClick="@(async _ => await ToggleIsActiveAsync(storageFolder))">
                                        @(storageFolder.IsActive ? L["Disable"] : L["Enable"])
                                    </BbDropdownMenuItem>
                                    <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(storageFolder))">
                                        @L["Delete"]
                                    </BbDropdownMenuItem>
                                </BbDropdownMenuContent>
                            </BbDropdownMenu>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
