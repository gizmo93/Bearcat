@page "/release-collections"
@using Bearcat.Domain.UseCases.ManageReleaseCollections.Dto
@using Bearcat.Website.Pages.ManageReleaseCollections.Results
@using Bearcat.Website.Pages.ManageReleaseCollections.Search
@using Bearcat.Website.Pages.ManageReleases.Search

<PageTitle>@L["ReleaseCollections"] - Bearcat</PageTitle>

<section class="@SectionClass">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["ReleaseCollections"]</h1>
            <p class="mt-1 text-sm text-muted-foreground">@ReleaseCollectionTotalCountText</p>
        </div>
    </div>

    <div class="space-y-3">
        <ReleaseCollectionSearchBar SearchTerm="@searchQuery.SearchTerm"
                                    OnSearchTermChanged="ApplySearchTermAsync"
                                    OnSearchTermTyped="ApplyTypedSearchTermAsync" />

        <ReleaseCollectionSearchFilters Query="searchQuery"
                                        ReleaseGroups="releaseGroups"
                                        OnQueryChanged="ApplySearchAsync" />

        <div class="flex flex-wrap items-center justify-between gap-2">
            <ReleaseOnlineStateSegments Counts="onlineStateCounts"
                                        SelectedOnlineState="searchQuery.OnlineState"
                                        SelectedOnlineStateChanged="ApplyOnlineStateAsync" />
            <SearchSortOrderSelect TSortOrder="ReleaseCollectionSearchSortOrder"
                                   Value="searchQuery.SortOrder"
                                   ValueChanged="ApplySortOrderAsync"
                                   Options="SortOrderOptions" />
        </div>
    </div>

    <ReleaseCollectionSearchResultList ReleaseCollections="releaseCollections"
                                       Selection="selection"
                                       SearchTerm="@searchQuery.SearchTerm"
                                       IsLoading="isLoading"
                                       HasActiveFilters="HasActiveFilters"
                                       OnResetFilters="ResetFiltersAsync"
                                       OnSelectionChanged="StateHasChanged" />

    <SearchResultsPagination TotalCount="totalCount"
                             PageIndex="pageIndex"
                             PageSize="pageSize"
                             ResultsSummaryResourceKey="ReleaseCollectionResultsSummary"
                             GetPageUrl="GetPageUri"
                             PageSizeChanged="ChangePageSize" />

    <ReleaseCollectionBulkActionBar Selection="selection"
                                    VisibleReleaseCollections="VisibleReleaseCollections"
                                    OnSelectionChanged="StateHasChanged"
                                    OnReleaseCollectionsDeleted="RefreshReleaseCollectionsAsync" />
</section>
