@using Bearcat.Domain.UseCases.ManageReleaseCollections
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase

<div class="space-y-6">
    <BbFormFieldSelect TValue="ReleaseContentType"
                       @bind-Value="contentType"
                       Label="@L["ReleaseContentType"]"
                       DisplayTextSelector="GetContentTypeDisplayText"
                       Options="ReleaseContentTypeOptions" />

    <div class="flex justify-end gap-2">
        <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
            @L["Cancel"]
        </BbButton>
        <BbButton OnClick="SaveAsync">
            @L["Save"]
        </BbButton>
    </div>
</div>

@code {
    [CascadingParameter]
    public IDialogReference DialogRef { get; set; } = null!;

    [Parameter]
    public int ReleaseCollectionId { get; set; }

    [Parameter]
    public ReleaseContentType ContentType { get; set; }

    private ReleaseContentType contentType;

    private IEnumerable<SelectOption<ReleaseContentType>> ReleaseContentTypeOptions =>
        Enum.GetValues<ReleaseContentType>()
            .Select(type => new SelectOption<ReleaseContentType>(type, L.Localize(type)));

    protected override void OnInitialized()
    {
        contentType = ContentType;
    }

    private string GetContentTypeDisplayText(ReleaseContentType releaseContentType)
    {
        return L.Localize(releaseContentType);
    }

    private async Task SaveAsync()
    {
        var service = ScopedServices.GetRequiredService<ReleaseCollectionService>();
        await service.UpdateContentTypeAsync(ReleaseCollectionId, contentType);
        await DialogRef.CloseAsync(DialogResult.Ok(contentType));
    }

    private async Task CancelAsync()
    {
        await DialogRef.CancelAsync();
    }
}
