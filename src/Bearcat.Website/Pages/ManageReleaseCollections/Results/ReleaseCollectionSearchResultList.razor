<SearchResultStates Items="ReleaseCollections"
                    IsLoading="IsLoading"
                    HasActiveFilters="HasActiveFilters"
                    OnResetFilters="OnResetFilters"
                    NoResultsText="@L["NoReleaseCollectionsFound"]"
                    NoMatchingResultsText="@L["NoReleaseCollectionsMatch"]"
                    NoMatchingResultsHintText="@L["NoReleaseCollectionsMatchHint"]"
                    ContainerClass="bearcat-config-list bearcat-release-result-list">
    <SkeletonContent>
        @for (var skeletonIndex = 0; skeletonIndex < SkeletonRowCount; skeletonIndex++)
        {
            <div class="bearcat-config-row bearcat-release-result-row @GridColumnsClass">
                <BbSkeleton Width="16px" Height="16px" />
                <div class="min-w-0 space-y-2">
                    <BbSkeleton Height="14px" Class="w-3/5" />
                    <BbSkeleton Height="10px" Class="w-2/5" />
                </div>
                <div class="bearcat-release-result-details">
                    <BbSkeleton Width="64px" Height="12px" />
                    <BbSkeleton Width="72px" Height="12px" />
                    <BbSkeleton Width="80px" Height="12px" />
                    <BbSkeleton Width="20px" Height="12px" />
                    <BbSkeleton Width="20px" Height="12px" />
                    <BbSkeleton Width="56px" Height="12px" />
                </div>
                <div></div>
            </div>
        }
    </SkeletonContent>
    <ChildContent>
        <div class="bearcat-config-header bearcat-release-result-header @GridColumnsClass">
            <div class="flex items-center">
                <BbCheckbox Checked="AreAllVisibleReleaseCollectionsSelected"
                            Indeterminate="AreSomeVisibleReleaseCollectionsSelected"
                            AriaLabel="@L["SelectAllOnPage"]"
                            CheckedChanged="@(_ => ToggleAllVisibleReleaseCollectionsAsync())" />
            </div>
            <span>@L["ReleaseCollection"]</span>
            <span>@L["OnlineState"]</span>
            <span>@L["ReleaseContentType"]</span>
            <span>@L["ReleaseGroup"]</span>
            <span>@L["Releases"]</span>
            <span>@L["LanguageShort"]</span>
            <span>@L["Added"]</span>
            <span></span>
        </div>
        @foreach (var releaseCollection in ReleaseCollections!)
        {
            <ReleaseCollectionSearchResultRow @key="releaseCollection.ReleaseCollectionId"
                                              ReleaseCollection="releaseCollection"
                                              SearchTerm="@SearchTerm"
                                              IsSelected="Selection.IsSelected(releaseCollection.ReleaseCollectionId)"
                                              OnSelectionToggled="@(extendRange => ToggleReleaseCollectionAsync(releaseCollection.ReleaseCollectionId, extendRange))" />
        }
    </ChildContent>
</SearchResultStates>
