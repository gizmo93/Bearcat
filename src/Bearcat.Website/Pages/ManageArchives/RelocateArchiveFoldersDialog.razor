@using Bearcat.Domain.UseCases.ManageArchives.ArchiveFolderRelocations

<div class="space-y-6">
    <div class="space-y-2">
        <label class="text-sm font-medium">@L["ArchiveFolderSearchBasePath"]</label>
        <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
            <p class="min-h-9 rounded-md border border-border/70 px-3 py-2 text-sm [overflow-wrap:anywhere] @(basePath is null ? "text-muted-foreground" : "")">
                @(basePath ?? L["NoArchiveFolderSearchBasePathSelected"])
            </p>
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Class="justify-center whitespace-nowrap"
                      Disabled="@(isLoadingPreview || isRelocating)"
                      OnClick="SelectBasePathAsync">
                <LucideIcon Name="folder-open" class="h-4 w-4" />
                @L["Browse"]
            </BbButton>
        </div>
        <p class="text-xs text-muted-foreground">@L["ArchiveFolderSearchBasePathHelp"]</p>
    </div>

    @if (isLoadingPreview)
    {
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Small" />
            <span>@L["SearchingArchiveFolders"]</span>
        </div>
    }

    @if (previewItems is not null)
    {
        <div class="space-y-2">
            <p class="text-sm font-medium">@L["ArchiveFolderRelocationSummary", RelocatableArchiveCount, previewItems.Count]</p>

            @foreach (var previewItem in previewItems)
            {
                <div class="space-y-1 rounded-md border px-3 py-2 text-sm @(previewItem.IsRelocatable ? "border-border/70" : "border-destructive/50")">
                    <p class="font-medium [overflow-wrap:anywhere]">@previewItem.ReleaseName</p>
                    <p class="text-xs text-muted-foreground [overflow-wrap:anywhere]">
                        #@previewItem.ArchiveId · @previewItem.ArchiveConfigName
                    </p>
                    <p class="flex items-start gap-1.5 text-xs text-muted-foreground" title="@L["FoundArchiveFolder"]">
                        <LucideIcon Name="folder" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
                        <span class="[overflow-wrap:anywhere]">@(previewItem.FoundArchiveFolderPath ?? "-")</span>
                    </p>
                    @if (previewItem.NotRelocatableReason is { } notRelocatableReason)
                    {
                        <p class="text-xs text-destructive">@L.Localize(notRelocatableReason)</p>
                    }
                </div>
            }
        </div>
    }

    <div class="flex flex-wrap items-center justify-end gap-2">
        @if (isRelocating)
        {
            <div class="mr-auto flex items-center gap-2 text-sm text-muted-foreground">
                <BbSpinner Size="SpinnerSize.Small" />
                <span>@L["ChangingArchiveFolders"]</span>
            </div>
        }
        <BbButton Variant="ButtonVariant.Outline" Disabled="isRelocating" OnClick="CancelAsync">
            @L["Cancel"]
        </BbButton>
        <BbButton Disabled="@(!CanRelocate)" OnClick="RelocateAsync">
            @L["ChangeArchiveFolders"]
        </BbButton>
    </div>
</div>
