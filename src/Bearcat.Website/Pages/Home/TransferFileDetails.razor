@using Bearcat.Domain.Shared.Transfers

<section class="rounded-lg border border-border/70 bg-background">
    <div class="border-b border-border/70 px-4 py-3">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="text-sm font-medium">@Title</p>
                <p class="text-xs text-muted-foreground">
                    @Subtitle
                </p>
            </div>

            <BbBadge Variant="BadgeVariant.Default">
                @StateLabel
            </BbBadge>
        </div>
    </div>

    <BbDataTable TData="TransferFileProgressSnapshot"
                 Data="Snapshot.Files"
                 ShowToolbar="false"
                 ShowPagination="@(Snapshot.Files.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@FileProgressLabel"
                 Class="border-0">
        <Columns>
            <BbDataTableColumn TData="TransferFileProgressSnapshot" TValue="string"
                               Header="@L["File"]"
                               Property="@(file => file.FileName)"
                               Sortable="true"
                               Filterable="true" />
            <BbDataTableColumn TData="TransferFileProgressSnapshot" TValue="string"
                               Header="@L["Source"]"
                               Property="@(file => file.SourceName)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="file">
                    <div class="flex flex-wrap items-center gap-2">
                        <span>@file.SourceName</span>
                        <ProxyServerBadge ProxyServerNames="GetProxyServerNames(file)" />
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="TransferFileProgressSnapshot" TValue="double"
                               Header="@L["Progress"]"
                               Property="@(file => file.Percentage)"
                               Sortable="true"
                               MinWidth="200px">
                <CellTemplate Context="file">
                    <div class="flex items-center gap-3">
                        <div class="flex min-w-[9rem] flex-1 items-center gap-3">
                            <BbProgress Value="file.Percentage" Class="w-full" />
                            <span class="w-12 text-right text-xs text-muted-foreground">@file.Percentage%</span>
                        </div>
                        <span class="text-xs tabular-nums text-muted-foreground">@FormatTransferred(file)</span>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
