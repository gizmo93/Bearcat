@using Bearcat.Domain.UseCases.DownloadArchivesFromMirror.Progress

<section class="space-y-3">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-lg font-semibold">@L["RunningTransfers"]</h2>
        </div>

        @{
            var totalUploadSpeed = FormatSpeed(TotalUploadBytesPerSecond);
            var totalDownloadSpeed = FormatSpeed(TotalDownloadBytesPerSecond);
        }
        @if (totalUploadSpeed is not null || totalDownloadSpeed is not null)
        {
            <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
                @if (totalUploadSpeed is not null)
                {
                    <div class="bearcat-total-speed">
                        <span class="bearcat-total-speed-value">@totalUploadSpeed</span>
                        <span class="bearcat-total-speed-label">@L["TotalUploadSpeed"]</span>
                    </div>
                }
                @if (totalDownloadSpeed is not null)
                {
                    <div class="bearcat-total-speed">
                        <span class="bearcat-total-speed-value">@totalDownloadSpeed</span>
                        <span class="bearcat-total-speed-label">@L["TotalDownloadSpeed"]</span>
                    </div>
                }
            </div>
        }
    </div>

    @if (Uploads.Count > 0)
    {
        <div class="bearcat-transfer-direction">
            <LucideIcon Name="upload" class="h-4 w-4" />
            <span>@L["Uploads"]</span>
        </div>

        <BbDataTable TData="Upload"
                     Data="SortedUploads"
                     ShowToolbar="false"
                     ShowPagination="@(Uploads.Count > 10)"
                     InitialPageSize="10"
                     AriaLabel="@L["RunningUploads"]"
                     Class="bearcat-data-table bearcat-running-uploads-table rounded-lg border border-border/70">
            <Columns>
                <BbDataTableColumn TData="Upload" TValue="int"
                                   Header="@L["Id"]"
                                   Property="@(upload => upload.Id)"
                                   Sortable="true">
                    <CellTemplate Context="upload">
                        <span class="bearcat-mobile-cell-label">@L["Id"]</span>
                        <span class="tabular-nums">@upload.Id</span>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="string"
                                   Header="@L["Release"]"
                                   Property="@(upload => upload.UploadConfig.Release.Name)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="upload">
                        <a class="bearcat-upload-release-name text-primary transition hover:underline" href="@($"/releases/{upload.UploadConfig.ReleaseId}")">
                            @upload.UploadConfig.Release.Name
                        </a>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="string"
                                   Header="@L["UploadConfig"]"
                                   Property="@(upload => upload.UploadConfig.Name)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="upload">
                        <span class="bearcat-mobile-cell-label">@L["UploadConfig"]</span>
                        @upload.UploadConfig.Name
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="string"
                                   Header="@L["Hoster"]"
                                   Property="@(upload => upload.UploadConfig.HosterRegistration.Name)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="upload">
                        <span class="bearcat-mobile-cell-label">@L["Hoster"]</span>
                        @upload.UploadConfig.HosterRegistration.Name
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="string"
                                   Header="@L["State"]"
                                   Property="@(upload => upload.UploadState.ToString())"
                                   Sortable="true">
                    <CellTemplate Context="upload">
                        <BbBadge Variant="@GetUploadVariant(upload.UploadState)">
                            @L.Localize(upload.UploadState)
                        </BbBadge>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="double"
                                   Header="@L["Progress"]"
                                   Property="@(GetUploadProgress)"
                                   Sortable="true"
                                   MinWidth="200px">
                    <CellTemplate Context="upload">
                        @{
                            var percentage = GetUploadProgress(upload);
                            var isExpanded = showDetailIds.Contains(upload.Id);
                        }
                        @if (upload.UploadState is UploadState.Uploading or UploadState.CancellationRequested)
                        {
                            var uploadSpeed = FormatUploadSpeed(upload.Id);
                            <span class="bearcat-mobile-cell-label">@L["Progress"]</span>
                            <div class="flex items-center gap-3 sm:justify-end">
                                <div class="flex min-w-[9rem] flex-1 items-center gap-3 sm:flex-none">
                                    <BbProgress Value="percentage" Class="w-full" />
                                    <span class="w-12 text-right text-xs text-muted-foreground">@percentage%</span>
                                </div>
                                @if (uploadSpeed is not null)
                                {
                                    <span class="w-20 text-right text-xs font-medium tabular-nums text-muted-foreground">@uploadSpeed</span>
                                }
                                <BbButton Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.IconSmall"
                                          AriaLabel="@L["ToggleUploadDetails"]"
                                          OnClick="@(_ => ToggleShowUploadDetails(upload.Id))">
                                    <LucideIcon Name="@(isExpanded ? "chevron-up" : "chevron-down")" class="h-4 w-4" />
                                </BbButton>
                            </div>
                        }
                        else
                        {
                            <span class="bearcat-mobile-cell-label">@L["Progress"]</span>
                            <span class="text-xs text-muted-foreground">-</span>
                        }
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Upload" TValue="int"
                                   Header=""
                                   Property="@(upload => upload.Id)"
                                   Width="56px">
                    <CellTemplate Context="upload">
                        <div class="flex justify-end">
                            <BbButton Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.IconSmall"
                                      Disabled="@(!CanCancelUpload(upload))"
                                      AriaLabel="@L["CancelUpload"]"
                                      OnClick="@(() => CancelUploadAsync(upload))">
                                <LucideIcon Name="ban" class="h-4 w-4" />
                            </BbButton>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
        </BbDataTable>

        @if (ExpandedUploads.Count > 0)
        {
            <div class="space-y-4">
                @foreach (var upload in ExpandedUploads)
                {
                    <FileDetails Upload="upload" />
                }
            </div>
        }
    }

    @if (RestoringArchives.Count > 0)
    {
        <div class="bearcat-transfer-direction">
            <LucideIcon Name="download" class="h-4 w-4" />
            <span>@L["MirrorDownloads"]</span>
        </div>

        <BbDataTable TData="Archive"
                     Data="RestoringArchives"
                     ShowToolbar="false"
                     ShowPagination="@(RestoringArchives.Count > 10)"
                     InitialPageSize="10"
                     AriaLabel="@L["MirrorDownloads"]"
                     Class="bearcat-data-table bearcat-running-downloads-table rounded-lg border border-border/70">
            <Columns>
                <BbDataTableColumn TData="Archive" TValue="int"
                                   Header="@L["Id"]"
                                   Property="@(archive => archive.Id)"
                                   Sortable="true">
                    <CellTemplate Context="archive">
                        <span class="bearcat-mobile-cell-label">@L["Id"]</span>
                        <span class="tabular-nums">@archive.Id</span>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="string"
                                   Header="@L["Release"]"
                                   Property="@(archive => archive.ArchiveConfig.Release.Name)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="archive">
                        <a class="bearcat-upload-release-name text-primary transition hover:underline" href="@($"/releases/{archive.ArchiveConfig.ReleaseId}")">
                            @archive.ArchiveConfig.Release.Name
                        </a>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="string"
                                   Header="@L["ArchiveConfig"]"
                                   Property="@(archive => archive.ArchiveConfig.Name)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="archive">
                        <span class="bearcat-mobile-cell-label">@L["ArchiveConfig"]</span>
                        @archive.ArchiveConfig.Name
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="string"
                                   Header="@L["Hoster"]"
                                   Property="@(GetDownloadHosterName)"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="archive">
                        <span class="bearcat-mobile-cell-label">@L["Hoster"]</span>
                        @GetDownloadHosterName(archive)
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="string"
                                   Header="@L["State"]"
                                   Property="@(archive => archive.ArchiveState.ToString())"
                                   Sortable="true">
                    <CellTemplate Context="archive">
                        <BbBadge Variant="BadgeVariant.Default">
                            @L.Localize(archive.ArchiveState)
                        </BbBadge>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="double"
                                   Header="@L["Progress"]"
                                   Property="@(GetDownloadProgress)"
                                   Sortable="true"
                                   MinWidth="200px">
                    <CellTemplate Context="archive">
                        @{
                            var percentage = GetDownloadProgress(archive);
                            var downloadSpeed = FormatDownloadSpeed(archive.Id);
                            var isExpanded = showDownloadDetailIds.Contains(archive.Id);
                        }
                        <span class="bearcat-mobile-cell-label">@L["Progress"]</span>
                        <div class="flex items-center gap-3 sm:justify-end">
                            <div class="flex min-w-[9rem] flex-1 items-center gap-3 sm:flex-none">
                                <BbProgress Value="percentage" Class="w-full" />
                                <span class="w-12 text-right text-xs text-muted-foreground">@percentage%</span>
                            </div>
                            @if (downloadSpeed is not null)
                            {
                                <span class="w-20 text-right text-xs font-medium tabular-nums text-muted-foreground">@downloadSpeed</span>
                            }
                            <BbButton Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.IconSmall"
                                      Disabled="@(GetDownloadSnapshot(archive.Id) is null)"
                                      AriaLabel="@L["ToggleDownloadDetails"]"
                                      OnClick="@(_ => ToggleShowDownloadDetails(archive.Id))">
                                <LucideIcon Name="@(isExpanded ? "chevron-up" : "chevron-down")" class="h-4 w-4" />
                            </BbButton>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="Archive" TValue="int"
                                   Header=""
                                   Property="@(archive => archive.Id)"
                                   Width="56px">
                    <CellTemplate Context="archive">
                        <div class="flex justify-end">
                            <BbButton Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.IconSmall"
                                      AriaLabel="@L["CancelDownload"]"
                                      OnClick="@(() => CancelDownloadAsync(archive))">
                                <LucideIcon Name="ban" class="h-4 w-4" />
                            </BbButton>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
        </BbDataTable>

        @if (ExpandedRestores.Count > 0)
        {
            <div class="space-y-4">
                @foreach (var archive in ExpandedRestores)
                {
                    <DownloadDetails Archive="archive" Snapshot="GetDownloadSnapshot(archive.Id)!" />
                }
            </div>
        }
    }
</section>
