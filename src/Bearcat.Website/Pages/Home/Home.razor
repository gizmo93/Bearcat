@page "/"
@using Bearcat.Website.Pages.Home.Setup

<PageTitle>@L["Activity"] - Bearcat</PageTitle>

@if (setupStatus is not null)
{
    <div class="space-y-6">
        <RunningProcesses>
            <ContentBelowHeader>
                @if (!setupStatus.IsRequiredSetupComplete)
                {
                    <FirstStartSetupIncompleteBanner SetupStatus="setupStatus" />
                }
            </ContentBelowHeader>
        </RunningProcesses>

        @if (ShowsOptionalSetupChecklist)
        {
            <FirstStartOptionalSetupChecklist OptionalSetupStatus="setupStatus.OptionalSetupStatus"
                                              OnHide="HideOptionalSetupChecklistAsync" />
        }
    </div>
}
