<div class="flex flex-col gap-3 rounded-md border border-border/70 bg-muted/30 px-3 py-2 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex min-w-0 items-start gap-2 text-sm text-muted-foreground sm:items-center">
        <LucideIcon Name="list-checks" class="mt-0.5 h-4 w-4 shrink-0 sm:mt-0" />
        <span class="min-w-0">@MissingPartsText</span>
    </div>
    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="/setup" Class="shrink-0 self-start sm:self-auto">
        @L["FirstStartSetupContinue"]
        <LucideIcon Name="arrow-right" class="h-4 w-4" />
    </BbButton>
</div>
