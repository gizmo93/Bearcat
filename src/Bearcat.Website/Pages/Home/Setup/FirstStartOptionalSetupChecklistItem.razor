<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between @(IsDone ? "text-muted-foreground" : null)">
    <div class="flex min-w-0 items-start gap-3">
        <LucideIcon Name="@(IsDone ? "circle-check" : IconName)"
                    class="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" />
        <div class="min-w-0 space-y-0.5">
            <p class="text-sm font-medium">
                @Title
                @if (IsDone)
                {
                    <span class="sr-only">(@L["FirstStartOptionalSetupDone"])</span>
                }
            </p>
            <p class="text-sm text-muted-foreground">@Description</p>
        </div>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2 pl-7 sm:pl-0">
        @ChildContent
    </div>
</li>
