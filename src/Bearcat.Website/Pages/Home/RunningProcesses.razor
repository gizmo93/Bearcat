@using Bearcat.Website.Pages.Home.Archives
@using Bearcat.Website.Pages.Home.Downloads
@using Bearcat.Website.Pages.Home.ReleaseFolderExtractions
@using Bearcat.Website.Pages.Home.Summary
@using Bearcat.Website.Pages.Home.Uploads
@implements IDisposable

<section class="space-y-6">
    <div class="bearcat-page-header">
        <div class="min-w-0 space-y-1">
            <h1 class="text-3xl font-semibold tracking-tight">@L["Activity"]</h1>
            <p class="bearcat-activity-status">
                <span class="bearcat-activity-status-dot @(autoRefresh ? "bearcat-activity-status-dot-live" : null)" aria-hidden="true"></span>
                <span>@StatusText</span>
                @if (!autoRefresh)
                {
                    <span>· @L["AutoRefreshPaused"]</span>
                }
            </p>
        </div>

        <div class="bearcat-page-action flex items-center gap-2">
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Icon"
                      Disabled="refreshInProgress"
                      AriaLabel="@L["Refresh"]"
                      title="@L["Refresh"]"
                      OnClick="@(LoadDataAsync)">
                <LucideIcon Name="refresh-cw" class="@($"h-4 w-4 {(refreshInProgress ? "animate-spin" : string.Empty)}")" />
            </BbButton>

            <BbButton Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Small"
                      Disabled="refreshInProgress"
                      OnClick="@(ToggleAutoRefresh)">
                <LucideIcon Name="@(autoRefresh ? "pause" : "play")" class="h-4 w-4" />
                @(autoRefresh ? L["PauseRefresh"] : L["EnableRefresh"])
            </BbButton>
        </div>
    </div>

    @if (SomethingIsRunning)
    {
        <ActivitySummary UploadBytesPerSecond="TotalUploadBytesPerSecond"
                         DownloadBytesPerSecond="TotalDownloadBytesPerSecond"
                         UploadSpeedHistory="uploadSpeedHistory"
                         DownloadSpeedHistory="downloadSpeedHistory"
                         RunningArchives="archivesInCreationOrHashChange"
                         ArchiveProgress="archiveCreationOrHashChangeProgress"
                         QueuedUploadCount="QueuedUploadCount" />

        @if (runningUploads.Count > 0)
        {
            <UploadLane Uploads="runningUploads"
                        UploadProgress="uploadProgress"
                        OnUploadCanceled="LoadDataAsync" />
        }

        @if (restoringArchives.Count > 0 || remoteDownloads.Count > 0)
        {
            <DownloadLane RestoringArchives="restoringArchives"
                          MirrorDownloadProgress="downloadProgress"
                          RemoteDownloads="remoteDownloads"
                          RemoteDownloadProgress="remoteDownloadProgress"
                          OnRemoteDownloadCanceled="LoadDataAsync" />
        }

        @if (releaseFolderExtractionProgress.Count > 0)
        {
            <ReleaseFolderExtractionLane Snapshots="releaseFolderExtractionProgress" />
        }

        @if (archivesInCreationOrHashChange.Count > 0)
        {
            <ArchiveLane Archives="archivesInCreationOrHashChange"
                         ArchiveProgress="archiveCreationOrHashChangeProgress" />
        }
    }
    else
    {
        <BbEmpty Title="@L["AllQuiet"]"
                 Description="@L["NoUploadsDownloadsOrArchivesRunning"]"
                 Class="bearcat-activity-empty">
            <Icon>
                <span class="bearcat-activity-empty-icon">
                    <LucideIcon Name="moon" class="h-7 w-7" />
                </span>
            </Icon>
        </BbEmpty>
    }
</section>
