@using Bearcat.Domain.Shared.Transfers
@using Bearcat.Website.Pages.Home.Activity

<section class="bearcat-activity-lane" aria-label="@L["Archives"]">
    <ActivityLaneHeading IconName="file-archive" Label="@L["Archives"]" Count="Archives.Count" />

    @foreach (var archive in Archives)
    {
        var snapshot = ArchiveProgress.GetValueOrDefault(archive.ArchiveId);
        RenderFragment? files = snapshot is null ? null : @<TransferFileList Snapshot="snapshot" />;
        RenderFragment? phases = null;
        if (snapshot is { Identifier.Type: TransferType.ArchiveHashChange })
        {
            phases = @<BbBadge Variant="BadgeVariant.Secondary">@L["ArchivePhaseChangingMd5HashesOfExistingArchive"]</BbBadge>;
        }
        else if (snapshot is not null)
        {
            phases = @<TransferPhaseSteps Phases="ArchiveCreationPhases"
                                          CurrentPhase="snapshot.Identifier.Type"
                                          AriaLabel="@L["ArchiveCreationPhases"]" />;
        }
        <ActivityCard @key="archive.ArchiveId"
                      IconName="file-archive"
                      IsActive="@(snapshot is not null)"
                      Title="@archive.ReleaseName"
                      TitleHref="@($"/releases/{archive.ReleaseId}")"
                      Snapshot="snapshot"
                      Phases="phases"
                      Files="files"
                      CancelLabel="@L["CancelArchiveCreation"]"
                      OnCancel="@(() => CancelArchiveCreationAsync(archive))">
            <Chips>
                <ActivityChip IconName="sliders-horizontal" Text="@archive.ArchiveConfigName" />
                <ActivityChip IconName="archive" Text="@archive.ArchiverName" />
            </Chips>
            <StateBadge>
                <ArchiveStateBadge State="archive.ArchiveState" />
            </StateBadge>
        </ActivityCard>
    }
</section>
