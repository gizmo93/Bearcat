@using Bearcat.Domain.UseCases.ManageArchives.ReadModels
@using Bearcat.Website.Formatting

<section class="space-y-3">
    <div>
        <h2 class="text-lg font-semibold">@L["RunningArchives"]</h2>
    </div>

    <BbDataTable TData="RunningArchiveReadModel"
                 Data="Archives"
                 ShowToolbar="false"
                 ShowPagination="@(Archives.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["RunningArchives"]"
                 Class="bearcat-data-table bearcat-running-archives-table rounded-lg border border-border/70">
        <Columns>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="int"
                               Header="@L["Id"]"
                               Property="@(archive => archive.ArchiveId)"
                               Sortable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["Id"]</span>
                    <span class="tabular-nums">@archive.ArchiveId</span>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="string"
                               Header="@L["Release"]"
                               Property="@(archive => archive.ReleaseName)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    @archive.ReleaseName
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="string"
                               Header="@L["ArchiveConfig"]"
                               Property="@(archive => archive.ArchiveConfigName)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["ArchiveConfig"]</span>
                    @archive.ArchiveConfigName
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="string"
                               Header="@L["Archiver"]"
                               Property="@(archive => archive.ArchiverName)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["Archiver"]</span>
                    @archive.ArchiverName
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="double"
                               Header="@L["Progress"]"
                               Property="@(GetProgress)"
                               Sortable="true"
                               MinWidth="200px">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["Progress"]</span>
                    @if (ArchiveProgress.TryGetValue(archive.ArchiveId, out var snapshot))
                    {
                        <div class="flex flex-col gap-1.5">
                            <BbBadge Variant="BadgeVariant.Secondary" Class="self-start sm:self-end">@GetPhaseLabel(snapshot)</BbBadge>
                            <TransferProgressCell Percentage="snapshot.Percentage"
                                                  Speed="@TransferFormatting.FormatSpeed(snapshot.BytesPerSecond)"
                                                  IsExpanded="showDetailIds.Contains(archive.ArchiveId)"
                                                  ToggleAriaLabel="@L["ToggleArchiveDetails"]"
                                                  OnToggleDetails="@(() => ToggleShowDetails(archive.ArchiveId))" />
                        </div>
                    }
                    else
                    {
                        <span class="text-xs text-muted-foreground">-</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunningArchiveReadModel" TValue="int"
                               Header=""
                               Property="@(archive => archive.ArchiveId)"
                               Width="56px">
                <CellTemplate Context="archive">
                    <div class="flex justify-end">
                        <BbButton Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconSmall"
                                  AriaLabel="@L["CancelArchiveCreation"]"
                                  OnClick="@(() => CancelArchiveCreationAsync(archive))">
                            <LucideIcon Name="ban" class="h-4 w-4" />
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    @if (ExpandedArchives.Count > 0)
    {
        <div class="space-y-4">
            @foreach (var archive in ExpandedArchives)
            {
                <TransferFileDetails Snapshot="ArchiveProgress[archive.ArchiveId]"
                                     Subtitle="@L["ArchiveCreationStatusSubtitle", archive.ArchiveId, archive.ReleaseName]"
                                     StateLabel="@L.Localize(archive.ArchiveState)" />
            }
        </div>
    }
</section>
