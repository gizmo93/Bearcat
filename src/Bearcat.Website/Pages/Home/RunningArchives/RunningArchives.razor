<section class="space-y-3">
    <div>
        <h2 class="text-lg font-semibold">@L["RunningArchives"]</h2>
        <p class="text-sm text-muted-foreground">@L["RunningArchivesDescription"]</p>
    </div>

    <BbDataTable TData="Archive"
                 Data="Archives"
                 ShowToolbar="false"
                 ShowPagination="@(Archives.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["RunningArchives"]"
                 Class="rounded-lg border border-border/70">
        <Columns>
            <BbDataTableColumn TData="Archive" TValue="int"
                               Header="@L["Id"]"
                               Property="@(archive => archive.Id)"
                               Sortable="true" />
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["Release"]"
                               Property="@(archive => archive.ArchiveConfig.Release.Name)"
                               Sortable="true"
                               Filterable="true" />
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["ArchiveConfig"]"
                               Property="@(archive => archive.ArchiveConfig.Name)"
                               Sortable="true"
                               Filterable="true" />
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["Archiver"]"
                               Property="@(archive => archive.ArchiveConfig.ArchiverName)"
                               Sortable="true"
                               Filterable="true" />
        </Columns>
    </BbDataTable>
</section>
