<section class="space-y-3">
    <div>
        <h2 class="text-lg font-semibold">@L["RunningArchives"]</h2>
        <p class="text-sm text-muted-foreground">@L["RunningArchivesDescription"]</p>
    </div>

    <BbDataTable TData="Archive"
                 Data="Archives"
                 ShowToolbar="false"
                 ShowPagination="@(Archives.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["RunningArchives"]"
                 Class="bearcat-data-table bearcat-running-archives-table rounded-lg border border-border/70">
        <Columns>
            <BbDataTableColumn TData="Archive" TValue="int"
                               Header="@L["Id"]"
                               Property="@(archive => archive.Id)"
                               Sortable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["Id"]</span>
                    <span class="tabular-nums">@archive.Id</span>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["Release"]"
                               Property="@(archive => archive.ArchiveConfig.Release.Name)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    @archive.ArchiveConfig.Release.Name
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["ArchiveConfig"]"
                               Property="@(archive => archive.ArchiveConfig.Name)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["ArchiveConfig"]</span>
                    @archive.ArchiveConfig.Name
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="Archive" TValue="string"
                               Header="@L["Archiver"]"
                               Property="@(archive => archive.ArchiveConfig.ArchiverName)"
                               Sortable="true"
                               Filterable="true">
                <CellTemplate Context="archive">
                    <span class="bearcat-mobile-cell-label">@L["Archiver"]</span>
                    @archive.ArchiveConfig.ArchiverName
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
