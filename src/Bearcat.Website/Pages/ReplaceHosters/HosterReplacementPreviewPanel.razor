@{
    var counts = new (string Label, int Count)[]
    {
        (L["UploadConfigurations"], Preview.UploadConfigCount),
        (L["ReplaceHostersUploadConfigsInTemplates"], Preview.UploadConfigTemplateCount),
        (L["ReplaceHostersUnstartedUploads"], Preview.UnstartedUploadCount),
        (L["ReplaceHostersAccountsToDeactivate"], Preview.AccountCountToDeactivate),
        (L["ReplaceHostersUploadsToMarkOffline"], Preview.UploadCountToMarkOffline),
    };
}

<div class="space-y-4">
    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        @foreach (var (label, count) in counts)
        {
            <div class="rounded-md border border-border/70 px-3 py-2">
                <dt class="text-xs text-muted-foreground">@label</dt>
                <dd class="text-2xl font-semibold tabular-nums">@count</dd>
            </div>
        }
    </dl>

    @if (Preview.UploadCountStayingOnSourceHoster > 0)
    {
        <div class="flex items-start gap-2 rounded-md border border-destructive/40 bg-destructive/5 px-3 py-2 text-sm text-destructive">
            <LucideIcon Name="triangle-alert" class="mt-0.5 h-4 w-4 shrink-0" />
            @L["ReplaceHostersUploadsStayingOnSourceHoster", Preview.UploadCountStayingOnSourceHoster]
        </div>
    }

    @if (Preview.UploadConfigCountWithoutArchiveSource > 0)
    {
        <div class="flex items-start gap-2 rounded-md border border-destructive/40 bg-destructive/5 px-3 py-2 text-sm text-destructive">
            <LucideIcon Name="triangle-alert" class="mt-0.5 h-4 w-4 shrink-0" />
            @L["ReplaceHostersUploadConfigsWithoutArchiveSource", Preview.UploadConfigCountWithoutArchiveSource]
        </div>
    }

    @if (Preview.SkippedUploadConfigs.Count > 0)
    {
        <div class="space-y-2">
            <h3 class="text-sm font-semibold">@L["ReplaceHostersSkippedUploadConfigs", Preview.SkippedUploadConfigs.Count]</h3>
            <div class="bearcat-config-list">
                <div class="@($"bearcat-config-header {SkippedRowGridClass}")">
                    <span>@L["Release"]</span>
                    <span>@L["ReplaceHostersUploadConfig"]</span>
                    <span>@L["ReplaceHostersSkipReason"]</span>
                </div>
                @foreach (var skippedUploadConfig in Preview.SkippedUploadConfigs.Take(MaximumRenderedSkippedRows))
                {
                    <div class="bearcat-config-item" @key="skippedUploadConfig.UploadConfigId">
                        <div class="@($"bearcat-config-row {SkippedRowGridClass}")">
                            <div class="min-w-0">
                                <a class="block truncate text-sm text-primary hover:underline"
                                   href="@($"/releases/{skippedUploadConfig.ReleaseId}")"
                                   title="@skippedUploadConfig.ReleaseName">@skippedUploadConfig.ReleaseName</a>
                            </div>
                            <div class="min-w-0">
                                <p class="bearcat-mobile-label">@L["ReplaceHostersUploadConfig"]</p>
                                <p class="truncate text-sm" title="@skippedUploadConfig.UploadConfigName">@skippedUploadConfig.UploadConfigName</p>
                            </div>
                            <div class="min-w-0">
                                <p class="bearcat-mobile-label">@L["ReplaceHostersSkipReason"]</p>
                                <p class="text-sm text-muted-foreground">@L.Localize(skippedUploadConfig.SkipReason)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Preview.SkippedUploadConfigs.Count > MaximumRenderedSkippedRows)
            {
                <p class="text-xs text-muted-foreground">@L["ReplaceHostersAndMore", Preview.SkippedUploadConfigs.Count - MaximumRenderedSkippedRows]</p>
            }
        </div>
    }

    @if (Preview.SkippedUploadConfigTemplates.Count > 0)
    {
        <div class="space-y-2">
            <h3 class="text-sm font-semibold">@L["ReplaceHostersSkippedUploadConfigsInTemplates", Preview.SkippedUploadConfigTemplates.Count]</h3>
            <div class="bearcat-config-list">
                <div class="@($"bearcat-config-header {SkippedRowGridClass}")">
                    <span>@L["ReleaseTemplate"]</span>
                    <span>@L["ReplaceHostersUploadConfig"]</span>
                    <span>@L["ReplaceHostersSkipReason"]</span>
                </div>
                @foreach (var skippedTemplate in Preview.SkippedUploadConfigTemplates.Take(MaximumRenderedSkippedRows))
                {
                    <div class="bearcat-config-item" @key="skippedTemplate.UploadConfigTemplateId">
                        <div class="@($"bearcat-config-row {SkippedRowGridClass}")">
                            <div class="min-w-0">
                                <a class="block truncate text-sm text-primary hover:underline"
                                   href="@($"/release-templates/{skippedTemplate.ReleaseTemplateId}")"
                                   title="@skippedTemplate.ReleaseTemplateName">@skippedTemplate.ReleaseTemplateName</a>
                            </div>
                            <div class="min-w-0">
                                <p class="bearcat-mobile-label">@L["ReplaceHostersUploadConfig"]</p>
                                <p class="truncate text-sm" title="@skippedTemplate.UploadConfigTemplateDisplayName">@skippedTemplate.UploadConfigTemplateDisplayName</p>
                            </div>
                            <div class="min-w-0">
                                <p class="bearcat-mobile-label">@L["ReplaceHostersSkipReason"]</p>
                                <p class="text-sm text-muted-foreground">@L.Localize(skippedTemplate.SkipReason)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Preview.SkippedUploadConfigTemplates.Count > MaximumRenderedSkippedRows)
            {
                <p class="text-xs text-muted-foreground">@L["ReplaceHostersAndMore", Preview.SkippedUploadConfigTemplates.Count - MaximumRenderedSkippedRows]</p>
            }
        </div>
    }

    @if (Preview.SourceAccountsInUnselectedPools.Count > 0 || Preview.SourcePoolsBecomingUnused.Count > 0)
    {
        <ul class="space-y-1 rounded-md border border-border/70 bg-muted/30 px-3 py-2 text-sm text-muted-foreground">
            @foreach (var account in Preview.SourceAccountsInUnselectedPools)
            {
                <li class="flex items-start gap-2">
                    <LucideIcon Name="info" class="mt-0.5 h-4 w-4 shrink-0" />
                    <a class="hover:underline" href="/hoster-account-pools">
                        @L["ReplaceHostersAccountInOtherPool", account.HosterRegistrationName, account.HosterAccountPoolName]
                    </a>
                </li>
            }
            @foreach (var pool in Preview.SourcePoolsBecomingUnused)
            {
                <li class="flex items-start gap-2">
                    <LucideIcon Name="info" class="mt-0.5 h-4 w-4 shrink-0" />
                    <a class="hover:underline" href="/hoster-account-pools">
                        @L["ReplaceHostersPoolBecomesUnused", pool.HosterAccountPoolName]
                    </a>
                </li>
            }
        </ul>
    }
</div>
