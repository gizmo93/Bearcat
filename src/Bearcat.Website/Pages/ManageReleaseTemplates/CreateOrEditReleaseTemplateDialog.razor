@inherits OwningComponentBase

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="FormModel.Name"
                              Label="@L["Name"]"
                              Placeholder="@L["ReleaseTemplateNamePlaceholder"]" />

            @if (releaseGroups.Count > 0)
            {
                <BbFormFieldSelect TValue="int"
                                   @bind-Value="FormModel.ReleaseGroupId"
                                   Label="@L["ReleaseGroup"]"
                                   Placeholder="@L["SelectReleaseGroup"]"
                                   DisplayTextSelector="GetReleaseGroupDisplayText"
                                   Options="ReleaseGroupOptions" />
            }

            <BbFormFieldSelect TValue="ReleaseType"
                               @bind-Value="FormModel.ReleaseType"
                               Label="@L["ReleaseType"]"
                               Disabled="FormModel.IsEdit"
                               DisplayTextSelector="GetReleaseTypeDisplayText"
                               Options="ReleaseTypeOptions" />

            <BbFormFieldSelect TValue="ReleaseContentType"
                               @bind-Value="FormModel.ReleaseContentType"
                               Label="@L["ReleaseContentType"]"
                               DisplayTextSelector="GetReleaseContentTypeDisplayText"
                               Options="ReleaseContentTypeOptions" />
        </div>

        <div class="space-y-4 rounded-md border border-border/70 p-4">
            <div class="flex items-center gap-2">
                <BbCheckbox @bind-Checked="FormModel.UseReleaseCollections"
                            Id="use-release-collections"
                            AriaLabel="@L["UseReleaseCollections"]" />
                <BbLabel For="use-release-collections">
                    @L["UseReleaseCollections"]
                </BbLabel>
            </div>

            @if (FormModel.UseReleaseCollections)
            {
                <BbFormFieldSelect TValue="ReleaseCollectionDetectionMode"
                                   @bind-Value="FormModel.ReleaseCollectionDetectionMode"
                                   Label="@L["ReleaseCollectionDetectionMode"]"
                                   Options="ReleaseCollectionDetectionModeOptions" />

                @if (FormModel.ReleaseCollectionDetectionMode is ReleaseCollectionDetectionMode.CustomRegex)
                {
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="FormModel.ReleaseCollectionPattern"
                                      Label="@L["ReleaseCollectionPattern"]"
                                      Placeholder="^(?<title>.+?)\.S(?<season>\d{2})E(?<episode>\d{2})\.(?<variant>.+)$" />

                    <div class="grid gap-4 md:grid-cols-2">
                        <BbFormFieldInput TValue="string"
                                          @bind-Value="FormModel.ReleaseCollectionKeyTemplate"
                                          Label="@L["ReleaseCollectionKeyTemplate"]"
                                          Placeholder="{title}.S{season}.{variant}" />

                        <BbFormFieldInput TValue="string"
                                          @bind-Value="FormModel.ReleaseCollectionNameTemplate"
                                          Label="@L["ReleaseCollectionNameTemplate"]"
                                          Placeholder="{title}.S{season}.{variant}" />
                    </div>
                }
            }
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
