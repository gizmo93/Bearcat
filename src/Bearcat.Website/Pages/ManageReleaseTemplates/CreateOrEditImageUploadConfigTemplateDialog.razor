
@if (!isInitialized)
{
    return;
}

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="FormModel.Name"
                              Label="@L["Name"]"
                              Placeholder="@L["NameImageUploadConfigPlaceholder"]" />

            <BbFormFieldSelect TValue="int?"
                               @bind-Value="FormModel.ImageHosterRegistrationId"
                               Label="@L["ImageHosterRegistration"]"
                               Placeholder="@L["SelectImageHosterRegistration"]"
                               Options="ImageHosterRegistrationOptions" />

            <div class="space-y-4 rounded-md border border-border/70 p-4">
                <p class="text-sm font-semibold">@L["ImageUploadContent"]</p>

                <BbFormFieldSwitch @bind-Checked="FormModel.UploadCover"
                                   Label="@L["UploadCover"]" />

                <BbFormFieldSwitch @bind-Checked="FormModel.UploadScreenshots"
                                   Label="@L["UploadScreenshots"]" />

                <BbFormFieldSwitch @bind-Checked="FormModel.UploadScreenshotGrid"
                                   Label="@L["UploadScreenshotGrid"]"
                                   HelperText="@L["UploadScreenshotsHelp"]" />
            </div>
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
