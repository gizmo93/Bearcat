@inherits OwningComponentBase

@if (!isInitialized)
{
    return;
}

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="FormModel.Name"
                              Label="@L["Name"]"
                              Placeholder="@L["UseHosterNamePlaceholder"]"
                              HelperText="@L["UploadConfigTemplateNameHelp"]" />

            <BbFormFieldSelect TValue="int?"
                               @bind-Value="FormModel.HosterRegistrationId"
                               @bind-Value:after="OnHosterRegistrationChanged"
                               Label="@L["HosterRegistration"]"
                               Placeholder="@L["SelectHosterRegistration"]"
                               Options="HosterOptions" />

            @if (CanUsePremiumOnlyDownload)
            {
                <BbFormFieldSwitch @bind-Checked="FormModel.PremiumOnlyDownload"
                                   Label="@L["PremiumOnlyDownload"]"
                                   HelperText="@L["PremiumOnlyDownloadHelp"]" />
            }

            @if (!isUnmanagedReleaseTemplate)
            {
                <BbFormFieldSelect TValue="int?"
                                   @bind-Value="FormModel.ArchiveConfigTemplateId"
                                   Label="@L["ArchiveConfiguration"]"
                                   Placeholder="@L["SelectArchiveConfiguration"]"
                                   Options="ArchiveConfigOptions" />
            }

            <div class="space-y-4 rounded-md border border-border/70 p-4">
                <div class="space-y-1">
                    <p class="text-sm font-medium">@L["CollectionUploadSlot"]</p>
                    <p class="text-xs text-muted-foreground">
                        @L["CollectionUploadSlotHelp"]
                    </p>
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="FormModel.CollectionUploadSlotKey"
                                      Label="@L["CollectionUploadSlotKey"]"
                                      Placeholder="forum-a-rg-passworded" />

                    <BbFormFieldInput TValue="string"
                                      @bind-Value="FormModel.CollectionUploadSlotName"
                                      Label="@L["CollectionUploadSlotName"]"
                                      Placeholder="@L["CollectionUploadSlotNamePlaceholder"]" />
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <BbFormFieldSelect TValue="CollectionUploadSlotPasswordPolicy"
                                       @bind-Value="FormModel.CollectionUploadSlotPasswordPolicy"
                                       Label="@L["PasswordPolicy"]"
                                       Options="PasswordPolicyOptions" />

                    <div class="flex items-end pb-2">
                        <div class="flex items-center gap-2">
                            <BbCheckbox @bind-Checked="FormModel.CollectionUploadSlotIsRequired"
                                        Id="collection-upload-slot-required"
                                        AriaLabel="@L["Required"]" />
                            <BbLabel For="collection-upload-slot-required">
                                @L["Required"]
                            </BbLabel>
                        </div>
                    </div>
                </div>

                @if (FormModel.CollectionUploadSlotPasswordPolicy is CollectionUploadSlotPasswordPolicy.MustEqualExpectedValue)
                {
                    <BbFormFieldInput TValue="string"
                                      @bind-Value="FormModel.CollectionUploadSlotExpectedArchivePassword"
                                      Label="@L["ExpectedArchivePassword"]" />
                }
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-sm font-medium">@L["LinksDistributedTo"]</p>
                        <p class="text-xs text-muted-foreground">
                            @L["LinksDistributedToHelp"]
                        </p>
                    </div>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddLinkDistributedTo">
                        <LucideIcon Name="plus" class="h-4 w-4" />
                        @L["Add"]
                    </BbButton>
                </div>

                @foreach (var index in Enumerable.Range(0, FormModel.LinksDistributedTo.Count))
                {
                    <div class="flex items-center gap-2">
                        <BbInput @bind-Value="FormModel.LinksDistributedTo[index]" class="flex-1" />
                        <BbButton Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconSmall"
                                  AriaLabel="@L["DeleteLink"]"
                                  OnClick="@(() => DeleteLinkDistributedTo(index))">
                            <LucideIcon Name="trash-2" class="h-4 w-4" />
                        </BbButton>
                    </div>
                }
            </div>
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
