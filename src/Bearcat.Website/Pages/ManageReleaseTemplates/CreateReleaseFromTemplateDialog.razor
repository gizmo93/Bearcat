
<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldSelect TValue="int?"
                               @bind-Value="formModel.ReleaseTemplateId"
                               @bind-Value:after="HandleTemplateChangedAsync"
                               Label="@L["ReleaseTemplate"]"
                               Placeholder="@L["SelectReleaseTemplate"]"
                               Options="ReleaseTemplateOptions" />

            <BbFormFieldSwitch @bind-Checked="formModel.CreateOneReleasePerSubfolder"
                               @bind-Checked:after="HandleCreateOneReleasePerSubfolderChangedAsync"
                               Label="@L["CreateOneReleasePerSubfolder"]"
                               HelperText="@L["CreateOneReleasePerSubfolderHelp"]"
                               Disabled="isCreating" />

            <div class="space-y-2">
                <label class="text-sm font-medium">@L["ReleaseFolder"]</label>
                <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                    <BbInput Value="@formModel.FolderPath" Disabled="true" Class="sm:flex-1" />
                    <BbButton Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Small"
                              Class="justify-center whitespace-nowrap"
                              AriaLabel="@L["BrowseReleaseFolders"]"
                              Disabled="isCreating"
                              OnClick="OpenFolderDialogAsync">
                        <LucideIcon Name="folder-open" class="h-4 w-4" />
                        @L["Browse"]
                    </BbButton>
                </div>
                @if (!string.IsNullOrWhiteSpace(folderValidationMessage))
                {
                    <p class="text-sm text-destructive">@folderValidationMessage</p>
                }
            </div>

            @if (!formModel.CreateOneReleasePerSubfolder)
            {
                <BbFormFieldInput TValue="string"
                                  @bind-Value="formModel.Name"
                                  Label="@L["Name"]"
                                  Placeholder="@L["NameYourRelease"]" />
            }
            else if (subfolderPreview is not null)
            {
                <div class="space-y-2 rounded-md border border-border/70 p-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-sm font-medium">@L["Subfolders"]</p>
                        <div class="flex gap-2">
                            <BbButton Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Small"
                                      Disabled="isCreating"
                                      OnClick="SelectAllSubfoldersThatCanBecomeReleases">
                                @L["SelectAll"]
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Small"
                                      Disabled="isCreating"
                                      OnClick="DeselectAllSubfolders">
                                @L["DeselectAll"]
                            </BbButton>
                        </div>
                    </div>

                    @if (subfolderPreview.MatchingFolderCount == 0)
                    {
                        <p class="text-sm text-muted-foreground">@L["NoSubfoldersFound"]</p>
                    }
                    else
                    {
                        <ul class="max-h-72 space-y-2 overflow-y-auto">
                            @foreach (var subfolder in subfolderPreview.MatchingFolders)
                            {
                                <li @key="subfolder.FolderPath" class="space-y-1 text-sm" title="@subfolder.FolderPath">
                                    <div class="flex min-w-0 items-center gap-2">
                                        <BbCheckbox Checked="selectedSubfolderPaths.Contains(subfolder.FolderPath)"
                                                    CheckedChanged="@(isSelected => SetSubfolderSelected(subfolder.FolderPath, isSelected))"
                                                    Disabled="@(isCreating || !CanSubfolderBecomeRelease(subfolder))"
                                                    AriaLabel="@subfolder.FolderName" />
                                        <span class="min-w-0 flex-1 truncate">@subfolder.FolderName</span>
                                        @if (createdSubfolderPaths.Contains(subfolder.FolderPath))
                                        {
                                            <BbBadge Variant="BadgeVariant.Outline" Class="shrink-0 text-muted-foreground">
                                                @L["Created"]
                                            </BbBadge>
                                        }
                                        else if (subfolder.IsUsedByReleaseArchiveOrRemoteDownload)
                                        {
                                            <BbBadge Variant="BadgeVariant.Outline" Class="shrink-0 text-muted-foreground">
                                                @L["ReleaseFolderPreviewInUse"]
                                            </BbBadge>
                                        }
                                    </div>
                                    @if (subfolderErrorMessagesByFolderPath.TryGetValue(subfolder.FolderPath, out var errorMessage))
                                    {
                                        <p class="text-xs text-destructive">@errorMessage</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            <BbFormFieldCombobox TValue="string"
                                 @bind-Value="formModel.PrimaryLanguageCode"
                                 Label="@L["PrimaryLanguage"]"
                                 SearchPlaceholder="@L["SearchLanguage"]"
                                 EmptyMessage="@L["NoLanguagesFound"]"
                                 InputClass="w-full"
                                 MatchTriggerWidth="true"
                                 Options="LanguageOptions" />

            @if (selectedTemplate is not null)
            {
                <div class="space-y-3 rounded-md border border-border/70 bg-muted/20 p-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <BbBadge Variant="BadgeVariant.Outline">@L.Localize(selectedTemplate.ReleaseType)</BbBadge>
                        <BbBadge Variant="BadgeVariant.Secondary">@selectedTemplate.ReleaseGroupName</BbBadge>
                    </div>

                    <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                            <p class="text-xs text-muted-foreground">@L["ArchiveConfigurations"]</p>
                            <p class="text-sm font-medium">@selectedTemplate.ArchiveConfigTemplates.Count</p>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground">@L["UploadConfigurations"]</p>
                            <p class="text-sm font-medium">@selectedTemplate.UploadConfigTemplates.Count</p>
                        </div>
                    </div>

                    @if (selectedTemplate.ArchiveConfigTemplates.Count > 0)
                    {
                        <div class="space-y-2">
                            <p class="text-xs text-muted-foreground">@L["ArchiveConfigurations"]</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var archiveConfig in selectedTemplate.ArchiveConfigTemplates)
                                {
                                    <BbBadge Variant="BadgeVariant.Outline">@archiveConfig.Name</BbBadge>
                                }
                            </div>
                        </div>
                    }

                    @if (selectedTemplate.UploadConfigTemplates.Count > 0)
                    {
                        <div class="space-y-2">
                            <p class="text-xs text-muted-foreground">@L["UploadConfigurations"]</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var uploadConfig in selectedTemplate.UploadConfigTemplates)
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">@uploadConfig.DisplayName</BbBadge>
                                    @if (uploadConfig.PremiumOnlyDownload)
                                    {
                                        <BbBadge Variant="BadgeVariant.Outline">@L["PremiumOnlyDownload"]</BbBadge>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" Disabled="isCreating" OnClick="CancelAsync">
                @(createdSubfolderPaths.Count > 0 ? L["Close"] : L["Cancel"])
            </BbButton>
            <BbButton Type="ButtonType.Submit"
                      Disabled="@(releaseTemplates.Count == 0 || isCreating)"
                      Loading="isCreating">
                @SubmitButtonText
            </BbButton>
        </div>
    </div>
</EditForm>
