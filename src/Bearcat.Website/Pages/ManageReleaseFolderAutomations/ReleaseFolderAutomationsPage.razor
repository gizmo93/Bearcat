@page "/release-folder-automations"

<PageTitle>@L["ReleaseFolderAutomations"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["ReleaseFolderAutomations"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["ReleaseFolderAutomationsIntro"]
            </p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewReleaseFolderAutomation"]
        </BbButton>
    </div>

    <BbDataTable TData="ReleaseFolderAutomationReadModel"
                 Data="automations"
                 ShowToolbar="false"
                 ShowPagination="@(automations.Count > 10)"
                 InitialPageSize="10"
                 IsLoading="isLoading"
                 AriaLabel="@L["ReleaseFolderAutomations"]"
                 Class="bearcat-data-table bearcat-folder-automations-table">
        <Columns>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["ReleaseBasePath"]"
                               Property="@(automation => automation.BasePath)"
                               Width="34%">
                <CellTemplate Context="automation">
                    <p class="bearcat-release-list-path" title="@automation.BasePath">
                        @automation.BasePath
                    </p>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["FolderNamePattern"]"
                               Property="@(automation => automation.FolderNamePattern ?? string.Empty)"
                               Width="180px">
                <CellTemplate Context="automation">
                    @if (string.IsNullOrWhiteSpace(automation.FolderNamePattern))
                    {
                        <span class="text-sm text-muted-foreground">@L["AllFolders"]</span>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Outline">@automation.FolderNamePattern</BbBadge>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["ReleaseTemplate"]"
                               Property="@(automation => automation.ReleaseTemplateName)"
                               Width="220px">
                <CellTemplate Context="automation">
                    <BbBadge Variant="BadgeVariant.Secondary">@automation.ReleaseTemplateName</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["ReleaseType"]"
                               Property="@(automation => automation.ReleaseType.ToString())"
                               Width="140px">
                <CellTemplate Context="automation">
                    <BbBadge Variant="BadgeVariant.Outline">@L.Localize(automation.ReleaseType)</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["ReleaseContentType"]"
                               Property="@(automation => automation.ReleaseContentType.ToString())"
                               Width="150px">
                <CellTemplate Context="automation">
                    <BbBadge Variant="BadgeVariant.Secondary">@L.Localize(automation.ReleaseContentType)</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header="@L["PrimaryLanguage"]"
                               Property="@(automation => automation.PrimaryLanguageCode ?? string.Empty)"
                               Width="170px">
                <CellTemplate Context="automation">
                    @if (string.IsNullOrWhiteSpace(automation.PrimaryLanguageCode))
                    {
                        <span class="text-sm text-muted-foreground">@L["NotSet"]</span>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Outline">
                            @GetLanguageDisplayName(automation.PrimaryLanguageCode)
                        </BbBadge>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="bool"
                               Header="@L["Status"]"
                               Property="@(automation => automation.IsEnabled)"
                               Width="250px">
                <CellTemplate Context="automation">
                    <div class="flex items-center gap-1.5 whitespace-nowrap">
                        <BbBadge Variant="@(automation.IsEnabled ? BadgeVariant.Default : BadgeVariant.Outline)">
                            @(automation.IsEnabled ? L["Enabled"] : L["Disabled"])
                        </BbBadge>
                        @if (ShouldExtractArchives(automation))
                        {
                            <BbBadge Variant="BadgeVariant.Outline" Class="text-muted-foreground" title="@L["ExtractArchivesBeforeReleaseCreation"]">
                                <BbBadgeIcon Name="file-archive" />
                                @L["ExtractsArchives"]
                            </BbBadge>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseFolderAutomationReadModel" TValue="string"
                               Header=""
                               Property="@(automation => automation.BasePath)"
                               Width="56px">
                <CellTemplate Context="automation">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenReleaseFolderAutomationActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End" Strategy="PositioningStrategy.Fixed">
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(automation))">
                                    @L["Edit"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ToggleEnabledAsync(automation))">
                                    @(automation.IsEnabled ? L["Disable"] : L["Enable"])
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(automation))">
                                    @L["Delete"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
        <EmptyTemplate>
            <div class="bearcat-release-empty">
                <LucideIcon Name="inbox" class="h-5 w-5" />
                <span>@L["NoReleaseFolderAutomationsFound"]</span>
            </div>
        </EmptyTemplate>
    </BbDataTable>

    @if (failedExtractions.Count > 0)
    {
        <div class="space-y-3 pt-4">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold tracking-tight">@L["FailedReleaseFolderExtractions"]</h2>
                <p class="text-sm text-muted-foreground">@L["FailedReleaseFolderExtractionsIntro"]</p>
            </div>

            <div class="bearcat-config-list">
                <div class="bearcat-config-header lg:grid-cols-[minmax(0,1fr)_minmax(0,0.3fr)_auto]">
                    <span>@L["Folder"]</span>
                    <span>@L["FailedAt"]</span>
                    <span class="text-right">@L["Actions"]</span>
                </div>
                @foreach (var failedExtraction in failedExtractions)
                {
                    <div class="bearcat-config-item">
                        <div class="bearcat-config-row lg:grid-cols-[minmax(0,1fr)_minmax(0,0.3fr)_auto]">
                            <div class="min-w-0 space-y-1">
                                <p class="text-sm font-semibold [overflow-wrap:anywhere]">@GetFolderName(failedExtraction.FolderPath)</p>
                                <p class="flex min-w-0 items-center gap-1.5 text-xs text-muted-foreground" title="@failedExtraction.FolderPath">
                                    <LucideIcon Name="folder" class="h-3.5 w-3.5 shrink-0" />
                                    <span class="truncate">@failedExtraction.FolderPath</span>
                                </p>
                            </div>

                            <div class="min-w-0">
                                <p class="bearcat-mobile-label">@L["FailedAt"]</p>
                                <p class="text-sm tabular-nums">@failedExtraction.FailedAt.ToString("g")</p>
                            </div>

                            <div class="bearcat-config-actions">
                                <BbButton Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Small"
                                          OnClick="@(() => RetryExtractionAsync(failedExtraction))">
                                    <LucideIcon Name="rotate-ccw" class="h-4 w-4" />
                                    @L["RetryReleaseFolderExtraction"]
                                </BbButton>
                            </div>
                        </div>

                        <p class="border-t border-border/70 px-4 py-2 text-xs whitespace-pre-wrap text-destructive [overflow-wrap:anywhere]">
                            @failedExtraction.ErrorMessage
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</section>
