
<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <div class="space-y-2">
                <label class="text-sm font-medium">@L["ReleaseBasePath"]</label>
                <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                    <BbInput @bind-Value="FormModel.BasePath"
                             @bind-Value:after="RefreshPreviewAsync"
                             UpdateTiming="UpdateTiming.Debounced"
                             class="sm:flex-1" />
                    <BbButton Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Small"
                              Class="justify-center whitespace-nowrap"
                              AriaLabel="@L["BrowseReleaseFolders"]"
                              OnClick="OpenFolderDialogAsync">
                        <LucideIcon Name="folder-open" class="h-4 w-4" />
                        @L["Browse"]
                    </BbButton>
                </div>
            </div>

            <BbFormFieldInput TValue="string"
                              @bind-Value="FormModel.FolderNamePattern"
                              @bind-Value:after="RefreshPreviewAsync"
                              UpdateTiming="UpdateTiming.Debounced"
                              Label="@L["FolderNamePattern"]"
                              Placeholder="@L["FolderNamePatternPlaceholder"]"
                              HelperText="@L["FolderNamePatternHelp"]" />

            <BbFormFieldSwitch @bind-Checked="FormModel.IgnoreExistingOnFirstScan"
                               Label="@L["IgnoreExistingOnFirstScan"]"
                               HelperText="@L["ReleaseFolderIgnoreExistingOnFirstScanHelp"]" />

            @if (!string.IsNullOrWhiteSpace(FormModel.BasePath))
            {
                <div class="space-y-2 rounded-md border border-border/70 p-3">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-sm font-medium">@L["ReleaseFolderPreview"]</p>
                        <BbButton Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconSmall"
                                  AriaLabel="@L["RefreshReleaseFolderPreview"]"
                                  Disabled="isLoadingPreview"
                                  OnClick="RefreshPreviewAsync">
                            <LucideIcon Name="refresh-cw" class="h-4 w-4" />
                        </BbButton>
                    </div>

                    @if (preview is null)
                    {
                        <p class="text-sm text-muted-foreground">@L["Loading"]</p>
                    }
                    else if (!preview.BasePathExists)
                    {
                        <p class="text-sm text-destructive">@L["ReleaseFolderPreviewBasePathMissing"]</p>
                    }
                    else if (preview.MatchingFolderCount == 0)
                    {
                        <p class="text-sm text-muted-foreground">@L["ReleaseFolderPreviewNoMatchingFolders"]</p>
                    }
                    else
                    {
                        <p class="text-sm">@L["ReleaseFolderPreviewSummary", preview.MatchingFolderCount, preview.UsedFolderCount]</p>

                        @if (StartsInitialScan && preview.UnusedFolderCount > 0)
                        {
                            @if (FormModel.IgnoreExistingOnFirstScan)
                            {
                                <p class="text-sm text-muted-foreground">@L["ReleaseFolderPreviewIgnoredFolders", preview.UnusedFolderCount]</p>
                            }
                            else
                            {
                                <p class="text-sm font-medium text-destructive">@L["ReleaseFolderPreviewFoldersBecomeReleases", preview.UnusedFolderCount]</p>
                            }
                        }

                        <ul class="max-h-48 space-y-1 overflow-y-auto">
                            @foreach (var folder in preview.MatchingFolders.Take(MaxPreviewFolderCount))
                            {
                                <li class="flex min-w-0 items-center justify-between gap-2 text-sm" title="@folder.FolderPath">
                                    <span class="truncate">@folder.FolderName</span>
                                    @if (folder.IsUsedByReleaseArchiveOrRemoteDownload)
                                    {
                                        <BbBadge Variant="BadgeVariant.Outline" Class="shrink-0 text-muted-foreground">
                                            @L["ReleaseFolderPreviewHasRelease"]
                                        </BbBadge>
                                    }
                                </li>
                            }
                        </ul>

                        @if (preview.MatchingFolderCount > MaxPreviewFolderCount)
                        {
                            <p class="text-xs text-muted-foreground">@L["ReleaseFolderPreviewMoreFolders", preview.MatchingFolderCount - MaxPreviewFolderCount]</p>
                        }
                    }
                </div>
            }

            <BbFormFieldSelect TValue="int?"
                               @bind-Value="FormModel.ReleaseTemplateId"
                               Label="@L["ReleaseTemplate"]"
                               Placeholder="@L["SelectReleaseTemplate"]"
                               Options="ReleaseTemplateOptions" />

            <BbFormFieldCombobox TValue="string"
                                 @bind-Value="FormModel.PrimaryLanguageCode"
                                 Label="@L["PrimaryLanguage"]"
                                 SearchPlaceholder="@L["SearchLanguage"]"
                                 EmptyMessage="@L["NoLanguagesFound"]"
                                 InputClass="w-full"
                                 MatchTriggerWidth="true"
                                 Options="LanguageOptions" />

            @if (SelectedReleaseType is ReleaseType.Managed)
            {
                <BbFormFieldSwitch @bind-Checked="FormModel.ExtractArchivesBeforeReleaseCreation"
                                   Label="@L["ExtractArchivesBeforeReleaseCreation"]"
                                   HelperText="@L["ReleaseFolderExtractArchivesBeforeReleaseCreationHelp"]" />
            }

            <div class="flex items-center gap-2">
                <BbCheckbox @bind-Checked="FormModel.IsEnabled"
                            Id="release-folder-automation-enabled"
                            AriaLabel="@L["Enabled"]" />
                <BbLabel For="release-folder-automation-enabled">
                    @L["Enabled"]
                </BbLabel>
            </div>
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
