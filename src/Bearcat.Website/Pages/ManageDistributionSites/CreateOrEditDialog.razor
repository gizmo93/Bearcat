<div class="space-y-6">
    <BbFormFieldSelect TValue="string"
                       Value="selectedClassName"
                       ValueChanged="OnDistributionSiteChanged"
                       Label="@L["DistributionSite"]"
                       Disabled="IsEdit"
                       Placeholder="@L["SelectDistributionSite"]"
                       Options="distributionSites.Select(distributionSite => new SelectOption<string>(distributionSite.ClassName, distributionSite.Name))" />

    @if (schema is null)
    {
        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Disabled="true">
                @L["Save"]
            </BbButton>
        </div>
    }
    else
    {
        <BbDynamicForm @key="selectedClassName"
                       Schema="schema"
                       @bind-Values="values"
                       ShowSubmitButton="false"
                       OnValidSubmit="SaveAsync"
                       Class="space-y-6">
            @if (errorMessage is not null)
            {
                <p class="text-sm text-destructive">@errorMessage</p>
            }

            <div class="flex justify-end gap-2">
                <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                    @L["Cancel"]
                </BbButton>
                <BbButton Type="ButtonType.Submit" Disabled="isSaving">
                    @L["Save"]
                </BbButton>
            </div>
        </BbDynamicForm>
    }
</div>
