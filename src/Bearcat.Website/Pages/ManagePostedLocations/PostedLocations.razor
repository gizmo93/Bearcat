<section class="space-y-3">
    <div class="bearcat-overview-section-header">
        <h2 class="bearcat-overview-section-heading">
            <LucideIcon Name="globe" class="h-4 w-4" />
            @L["PostedLocations"]
            <span class="bearcat-overview-count-pill">@locations.Count</span>
        </h2>

        @if (!isAdding)
        {
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Disabled="isBusy"
                      OnClick="StartAdding">
                <LucideIcon Name="plus" class="h-4 w-4" />
                @L["Add"]
            </BbButton>
        }
    </div>

    <div class="bearcat-overview-card">
        @if (locations.Count == 0 && !isAdding)
        {
            <p class="bearcat-posted-location-empty">@L["NoPostedLocationsYet"]</p>
        }

        @foreach (var location in locations)
        {
            var display = PostedLocationDisplay.FromUrl(location.Url);
            <div class="bearcat-posted-location-row">
                <span class="bearcat-posted-location-avatar" aria-hidden="true">@display.Initial</span>
                <div class="min-w-0 flex-1" title="@location.Url">
                    <p class="truncate text-sm font-semibold">@display.Title</p>
                    @if (display.Subtitle is not null)
                    {
                        <p class="truncate text-xs text-muted-foreground">@display.Subtitle</p>
                    }
                </div>
                <div class="flex shrink-0 items-center gap-1">
                    <BbButton Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.IconSmall"
                              Href="@location.Url"
                              target="_blank"
                              rel="noopener noreferrer"
                              AriaLabel="@L["Open"]"
                              title="@L["Open"]">
                        <LucideIcon Name="external-link" class="h-4 w-4" />
                    </BbButton>
                    <CopyButton Value="@location.Url"
                                Label="@L["CopyLink"]"
                                Variant="ButtonVariant.Ghost" />
                    @if (location.DistributionSiteRegistrationId is not null)
                    {
                        <BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
                            <BbTooltipTrigger AsChild="true">
                                <BbButton Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.IconSmall"
                                          AriaLabel="@L["UpdatePostedLocationTitle"]"
                                          Disabled="isBusy"
                                          OnClick="@(() => UpdateAsync(location))">
                                    <LucideIcon Name="file-pen" class="h-4 w-4" />
                                </BbButton>
                            </BbTooltipTrigger>
                            <BbTooltipContent Class="max-w-xs text-xs">
                                <p class="font-medium">@L["UpdatePostedLocationTitle"]</p>
                                <p>@L["UpdatePostedLocationDescription"]</p>
                            </BbTooltipContent>
                        </BbTooltip>
                    }
                    <BbButton Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.IconSmall"
                              AriaLabel="@L["Delete"]"
                              title="@L["Delete"]"
                              Disabled="isBusy"
                              OnClick="@(() => DeleteAsync(location.PostedLocationId))">
                        <LucideIcon Name="trash-2" class="h-4 w-4" />
                    </BbButton>
                </div>
            </div>
        }

        @if (isAdding)
        {
            <form class="bearcat-posted-location-add-form"
                  novalidate
                  @onsubmit="AddAsync"
                  @onsubmit:preventDefault
                  @onkeydown="HandleAddFormKeyDown">
                <BbInput @ref="urlInput"
                         @bind-Value="newUrl"
                         Type="InputType.Url"
                         Class="min-w-0 flex-1"
                         Placeholder="@L["PostedLocationUrlPlaceholder"]"
                         AriaLabel="@L["PostedLocationUrlPlaceholder"]" />
                <BbButton Type="ButtonType.Submit"
                          Size="ButtonSize.Small"
                          Disabled="isBusy">
                    @L["Add"]
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Disabled="isBusy"
                          OnClick="CancelAdding">
                    @L["Cancel"]
                </BbButton>
            </form>
        }
    </div>

    @if (errorMessage is not null)
    {
        <p class="text-sm text-destructive">@errorMessage</p>
    }
</section>
