@page "/configurations"
@using Bearcat.Website.Pages.ManageApplicationConfigurations.Navigation
@using Bearcat.Website.Pages.ManageApplicationConfigurations.Sections

<PageTitle>@L["Configurations"] - Bearcat</PageTitle>

@{
    var visibleSections = VisibleSections;
}

<section @ref="pageElement" class="mx-auto flex w-full max-w-6xl flex-col gap-6">
    <div class="bearcat-page-header">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight">@L["Configurations"]</h1>
            @if (!isLoading)
            {
                <p class="mt-1 text-sm tabular-nums text-muted-foreground">
                    @L["ConfigurationSettingsSummary", TotalSettingCount, ChangedSettingCount]
                </p>
            }
        </div>

        <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
            <BbInputGroup Class="w-full sm:w-72">
                <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                    <LucideIcon Name="search" class="h-4 w-4 text-muted-foreground" />
                </BbInputGroupAddon>
                <BbInputGroupInput @bind-Value="searchTerm"
                                   Type="InputType.Search"
                                   Placeholder="@L["SearchConfigurations"]"
                                   AriaLabel="@L["SearchConfigurations"]"
                                   UpdateTiming="UpdateTiming.Immediate" />
            </BbInputGroup>

            <BbToggleGroup TValue="ConfigurationSettingFilter"
                           @bind-Value="settingFilter"
                           Required="true"
                           Variant="ToggleVariant.Outline"
                           Size="ToggleSize.Small"
                           Class="shrink-0 self-start sm:self-auto"
                           aria-label="@L["ConfigurationFilter"]">
                <BbToggleGroupItem Value="ConfigurationSettingFilter.All">@L["All"]</BbToggleGroupItem>
                <BbToggleGroupItem Value="ConfigurationSettingFilter.Changed" Class="tabular-nums">
                    @L["ConfigurationFilterChanged", ChangedSettingCount]
                </BbToggleGroupItem>
            </BbToggleGroup>
        </div>
    </div>

    @if (isLoading)
    {
        <BbCard Class="border-border/70 shadow-sm">
            <BbCardContent Class="py-8">
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <BbSpinner Size="SpinnerSize.Small" />
                    <span>@L["Loading"]</span>
                </div>
            </BbCardContent>
        </BbCard>
    }
    else if (visibleSections.Count == 0)
    {
        <div class="bearcat-release-empty">
            <LucideIcon Name="search-x" class="h-5 w-5" />
            <span>@EmptyStateText</span>
        </div>
    }
    else
    {
        <ConfigurationSectionChipRow Sections="visibleSections" />

        <div class="grid grid-cols-[minmax(0,1fr)] gap-8 xl:grid-cols-[14rem_minmax(0,1fr)]">
            <ConfigurationSectionNavigation Sections="visibleSections" />

            <div class="flex min-w-0 flex-col gap-6">
                @foreach (var section in visibleSections)
                {
                    <ConfigurationSectionCard @key="section.Configuration.Key"
                                              Section="section"
                                              OnSave="SaveSettingAsync"
                                              OnReset="ResetSettingAsync" />
                }
            </div>
        </div>
    }
</section>
