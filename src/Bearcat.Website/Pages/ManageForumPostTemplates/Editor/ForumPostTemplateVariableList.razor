<div class="bearcat-forum-template-editor-list-header">
    <BbInput Type="InputType.Search"
             Value="@SearchTerm"
             ValueChanged="SearchTermChanged"
             UpdateTiming="UpdateTiming.Immediate"
             Placeholder="@L["SearchVariables"]"
             AriaLabel="@L["SearchVariables"]"
             Class="bearcat-forum-template-editor-compact-input" />
</div>

<div class="bearcat-forum-template-editor-scroll">
    @if (FilteredVariables.Count == 0)
    {
        <div class="bearcat-release-empty">
            <LucideIcon Name="search-x" class="h-5 w-5" />
            <span>@L["NoVariablesFound"]</span>
        </div>
    }
    else
    {
        foreach (var variable in FilteredVariables)
        {
            <div class="bearcat-forum-template-editor-variable">
                <code>@variable.Path</code>
                <p>@variable.Description</p>
            </div>
        }
    }
</div>
