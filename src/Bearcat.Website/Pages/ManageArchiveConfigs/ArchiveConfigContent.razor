<div class="space-y-4">
    <div class="grid gap-4 md:grid-cols-2">
        <div class="space-y-2">
            <p class="text-xs text-muted-foreground">@L["Password"]</p>
            @if (Config.ArchivePassword is null)
            {
                <p class="text-sm">-</p>
            }
            else
            {
                <HiddenElement>
                    <span class="text-sm">@Config.ArchivePassword</span>
                </HiddenElement>
            }
        </div>

        <div class="space-y-2">
            <p class="text-xs text-muted-foreground">@L["SizePerArchiveMb"]</p>
            <p class="text-sm"><NullableElement Value="Config.ArchiveFileSizeMb" /></p>
        </div>

        <div class="space-y-2">
            <p class="text-xs text-muted-foreground">@L["ArchiveName"]</p>
            <p class="text-sm">
                @if (!string.IsNullOrWhiteSpace(Config.ArchiveNamePrefix))
                {
                    @Config.ArchiveNameWithExtension
                }
                else
                {
                    <span class="text-muted-foreground">@L["RandomArchiveNameWillBeGenerated"]</span>
                }
            </p>
        </div>

        <div class="space-y-2">
            <p class="text-xs text-muted-foreground">@L["ArchiveFilesBasePath"]</p>
            <p class="truncate text-sm">@Config.ArchiveFilesBasePath</p>
        </div>
    </div>

    @if (Config.ArchiveSummaries.Count > 0)
    {
        <div class="space-y-3">
            <p class="text-sm font-medium">@L["Archives"]</p>
            <BbDataTable TData="ArchiveConfigReadModel.ArchiveSummary"
                         Data="Config.ArchiveSummaries"
                         ShowToolbar="false"
                         ShowPagination="@(Config.ArchiveSummaries.Count > 10)"
                         InitialPageSize="10"
                         AriaLabel="@L["ArchiveSummaries"]"
                         Class="rounded-lg border border-border/70">
                <Columns>
                    <BbDataTableColumn TData="ArchiveConfigReadModel.ArchiveSummary" TValue="string"
                                       Header="@L["State"]"
                                       Property="@(summary => summary.ArchiveState.ToString())"
                                       Sortable="true"
                                       Width="180px">
                        <CellTemplate Context="summary">
                            <div class="flex items-center gap-2">
                                <BbBadge Variant="@GetArchiveVariant(summary.ArchiveState)">
                                    @L.Localize(summary.ArchiveState)
                                </BbBadge>
                                <ErrorMessagesTooltip Messages="summary.ErrorMessages" />
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ArchiveConfigReadModel.ArchiveSummary" TValue="int"
                                       Header="@L["FileCount"]"
                                       Property="@(summary => summary.ArchiveFileCount)"
                                       Sortable="true"
                                       Width="130px">
                        <CellTemplate Context="summary">
                            <BbButton Variant="ButtonVariant.Link"
                                      AriaLabel="@L["OpenArchiveDetails"]"
                                      OnClick="@(() => ShowArchiveDialogAsync(summary.ArchiveId))">
                                @summary.ArchiveFileCount
                            </BbButton>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ArchiveConfigReadModel.ArchiveSummary" TValue="DateTime"
                                       Header="@L["CreatedAt"]"
                                       Property="@(summary => summary.CreatedAt)"
                                       Sortable="true"
                                       Width="180px">
                        <CellTemplate Context="summary">
                            <span class="text-sm">@summary.CreatedAt.ToString("g")</span>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        </div>
    }
</div>
