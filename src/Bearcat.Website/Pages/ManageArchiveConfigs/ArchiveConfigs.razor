@inherits OwningComponentBase

<BbCard Class="border-border/70 shadow-sm">
    <BbCardHeader>
        <div class="bearcat-section-header">
            <div class="flex items-center gap-2">
                <LucideIcon Name="archive" class="h-4 w-4" />
                <div>
                    <BbCardTitle class="text-base">@L["ArchiveConfigurations"]</BbCardTitle>
                    <BbCardDescription>@L["ArchiveConfigurationsDescription"]</BbCardDescription>
                </div>
            </div>
            @if (ReleaseType is ReleaseType.Managed)
            {
                <BbButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="ShowAddDialogAsync">
                    <LucideIcon Name="plus" class="h-4 w-4" />
                    @L["Add"]
                </BbButton>
            }
        </div>
    </BbCardHeader>
    <BbCardContent>
        @if (archiveConfigs.Count == 0)
        {
            <div class="rounded-lg border border-dashed border-border/70 px-4 py-8 text-sm text-muted-foreground">
                @L["NoArchiveConfigurationsYet"]
            </div>
        }
        else
        {
            <div class="bearcat-config-list">
                <div class="@($"bearcat-config-header {ArchiveGridClass}")">
                    <span>@L["Configuration"]</span>
                    <span>@L["Archiver"]</span>
                    <span>@L["Archives"]</span>
                    @if (ReleaseType is ReleaseType.Managed)
                    {
                        <span>@L["Size"]</span>
                        <span>@L["ArchiveName"]</span>
                    }
                    <span class="text-right">@L["Actions"]</span>
                </div>
                @foreach (var config in archiveConfigs)
                {
                    <BbCollapsible Class="@($"bearcat-config-item {(FocusArchiveConfigId == config.ArchiveConfigId ? "bearcat-config-item-focused" : string.Empty)}")">
                        <div class="@($"bearcat-config-row {ArchiveGridClass}")">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-sm font-semibold">@config.Name</span>
                                </div>
                                <p class="mt-1 truncate text-xs text-muted-foreground" title="@config.ArchiveFilesBasePath">
                                    @config.ArchiveFilesBasePath
                                </p>
                            </div>

                            <div>
                                <p class="bearcat-mobile-label">@L["Archiver"]</p>
                                <BbBadge Variant="BadgeVariant.Outline">@config.ArchiverDisplayName</BbBadge>
                            </div>

                            <div>
                                <p class="bearcat-mobile-label">@L["Archives"]</p>
                                <p class="text-sm font-medium">@config.ArchiveSummaries.Count</p>
                            </div>

                            @if (ReleaseType is ReleaseType.Managed)
                            {
                                <div>
                                    <p class="bearcat-mobile-label">@L["Size"]</p>
                                    <p class="text-sm font-medium">@config.ArchiveFileSizeMb MB</p>
                                </div>

                                <div class="min-w-0">
                                    <p class="bearcat-mobile-label">@L["ArchiveName"]</p>
                                    <p class="truncate text-sm font-medium" title="@(config.ArchiveNameWithExtension ?? "-")">
                                        @(config.ArchiveNameWithExtension ?? "-")
                                    </p>
                                </div>
                            }

                            <div class="bearcat-config-actions">
                                @if (ReleaseType is ReleaseType.Managed)
                                {
                                    <BbDropdownMenu>
                                        <BbDropdownMenuTrigger>
                                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenArchiveConfigActions"]">
                                                <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                            </BbButton>
                                        </BbDropdownMenuTrigger>
                                        <BbDropdownMenuContent Align="PopoverAlign.End" Strategy="PositioningStrategy.Fixed">
                                            <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(config))">
                                                @L["EditConfig"]
                                            </BbDropdownMenuItem>
                                            <BbDropdownMenuItem OnClick="@(async _ => await DeleteConfigAsync(config))">
                                                @L["DeleteConfig"]
                                            </BbDropdownMenuItem>
                                        </BbDropdownMenuContent>
                                    </BbDropdownMenu>
                                }
                                else
                                {
                                    <BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
                                        <BbTooltipTrigger>
                                            <span class="inline-flex">
                                                <BbButton Variant="ButtonVariant.Ghost"
                                                          Size="ButtonSize.IconSmall"
                                                          OnClick="@(async _ => await ChangeArchiveFolderAsync(config))"
                                                          AriaLabel="@L["ChangeArchiveFolder"]">
                                                    <LucideIcon Name="folder-sync" class="h-4 w-4" />
                                                </BbButton>
                                            </span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent Class="max-w-xs text-xs">
                                            @L["ChangeArchiveFolderTooltip"]
                                        </BbTooltipContent>
                                    </BbTooltip>
                                }
                                <BbCollapsibleTrigger>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["ToggleArchiveConfigDetails"]">
                                        <LucideIcon Name="chevron-down" class="h-4 w-4" />
                                    </BbButton>
                                </BbCollapsibleTrigger>
                            </div>
                        </div>
                        <BbCollapsibleContent Class="border-t border-border/70 bg-muted/5 px-4 pb-4 pt-4">
                            <ArchiveConfigContent Config="config" ReleaseType="ReleaseType" />
                        </BbCollapsibleContent>
                    </BbCollapsible>
                }
            </div>
        }
    </BbCardContent>
</BbCard>
