@page "/hoster-registrations"

<PageTitle>@L["HosterRegistrations"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["HosterRegistrations"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["HosterRegistrationsIntro"]
            </p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewHoster"]
        </BbButton>
    </div>

    <BbDataTable TData="HosterRegistrationReadModel"
                 Data="hosters"
                 ShowToolbar="false"
                 ShowPagination="@(hosters.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["HosterRegistrations"]"
                 Class="bearcat-data-table bearcat-registrations-table bearcat-hosters-table">
        <Columns>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Name"]"
                               Property="@(hoster => hoster.Name)"
                               Sortable="true"
                               Filterable="true"
                               Width="165px" />
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Hoster"]"
                               Property="@(hoster => hoster.HosterName)"
                               Sortable="true"
                               Filterable="true"
                               Width="175px" />
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["ParallelUploads"]"
                               Property="@(hoster => hoster.HosterName)"
                               Width="135px">
                <CellTemplate Context="hoster">
                    <p class="bearcat-hosters-cell-label">@L["ParallelUploads"]</p>
                    @if (hoster.HasFixedParallelUploadLimit)
                    {
                        <span class="text-sm text-muted-foreground">@L["ParallelUploadsViaApi"]</span>
                    }
                    else if (hoster.MaxParallelUploadsOverride is { } overrideValue)
                    {
                        <div class="flex flex-col gap-0.5">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@overrideValue</span>
                                <BbBadge Variant="BadgeVariant.Secondary">@L["Override"]</BbBadge>
                            </div>
                            <span class="text-xs text-muted-foreground">
                                @L["DefaultValueWithNumber", hoster.DefaultMaximumParallelUploads ?? 0]
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="text-sm">@(hoster.DefaultMaximumParallelUploads?.ToString() ?? "-")</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Reupload"]"
                               Property="@(hoster => hoster.HosterName)"
                               Width="185px">
                <CellTemplate Context="hoster">
                    <p class="bearcat-hosters-cell-label">@L["Reupload"]</p>
                    @if (hoster.NumberOfHoursUntilReuploadOverride is null && hoster.ReuploadTriggerOverride is null)
                    {
                        <span class="text-sm text-muted-foreground">@L["ReuploadFollowsReleaseGroup"]</span>
                    }
                    else
                    {
                        <div class="flex flex-col gap-1.5">
                            @if (hoster.NumberOfHoursUntilReuploadOverride is { } hours)
                            {
                                <span class="inline-flex items-center gap-1.5 text-sm font-medium">
                                    <LucideIcon Name="clock" class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                                    @L["HoursShort", hours]
                                </span>
                            }
                            @if (hoster.ReuploadTriggerOverride is { } trigger)
                            {
                                <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <LucideIcon Name="@(trigger is ReuploadTrigger.OnlyWhenFullyOffline ? "cloud-off" : "signal-low")"
                                                class="h-3.5 w-3.5 shrink-0" />
                                    @L.Localize(trigger)
                                </span>
                            }
                        </div>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="bool"
                               Header="@L["Active"]"
                               Property="@(hoster => hoster.IsActive)"
                               Sortable="true"
                               Width="120px">
                <CellTemplate Context="hoster">
                    @if (hoster.RequiresCaptchaVerification)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">
                            @L["CaptchaRequired"]
                        </BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="@(hoster.IsActive ? BadgeVariant.Default : BadgeVariant.Outline)">
                            @(hoster.IsActive ? L["Active"] : L["Inactive"])
                        </BbBadge>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Login"]"
                               Property="@(hoster => hoster.Name)"
                               Width="190px">
                <CellTemplate Context="hoster">
                    <div class="flex items-center gap-2 whitespace-nowrap">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => TryLoginAsync(hoster))">
                            @L["TryLogin"]
                        </BbButton>
                        @if (hoster is { SupportsCaptchaVerification: true, RequiresCaptchaVerification: true })
                        {
                            <BbButton Class="bearcat-captcha-action-button"
                                      Variant="ButtonVariant.Destructive"
                                      Size="ButtonSize.IconSmall"
                                      AriaLabel="@L["SolveCaptcha"]"
                                      title="@L["SolveCaptcha"]"
                                      OnClick="@(() => ShowCaptchaDialogAsync(hoster))">
                                <LucideIcon Name="shield-alert" class="h-4 w-4" />
                                <span>@L["SolveCaptchaShort"]</span>
                            </BbButton>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header=""
                               Property="@(hoster => hoster.Name)"
                               Width="56px">
                <CellTemplate Context="hoster">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenHosterActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End" Strategy="PositioningStrategy.Fixed">
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(hoster))">
                                    @L["EditRegistration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ToggleIsActiveAsync(hoster))">
                                    @(hoster.IsActive ? L["Disable"] : L["Enable"])
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(hoster))">
                                    @L["DeleteRegistration"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
