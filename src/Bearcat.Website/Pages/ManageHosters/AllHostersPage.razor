@page "/hoster-registrations"
@inherits OwningComponentBase

<PageTitle>@L["HosterRegistrations"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["HosterRegistrations"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["HosterRegistrationsIntro"]
            </p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewHoster"]
        </BbButton>
    </div>

    <BbDataTable TData="HosterRegistrationReadModel"
                 Data="hosters"
                 ShowToolbar="false"
                 ShowPagination="@(hosters.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["HosterRegistrations"]"
                 Class="bearcat-data-table bearcat-registrations-table">
        <Columns>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Name"]"
                               Property="@(hoster => hoster.Name)"
                               Sortable="true"
                               Filterable="true"
                               Width="20%" />
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Hoster"]"
                               Property="@(hoster => hoster.HosterName)"
                               Sortable="true"
                               Filterable="true"
                               Width="16%" />
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="bool"
                               Header="@L["Active"]"
                               Property="@(hoster => hoster.IsActive)"
                               Sortable="true"
                               Width="150px">
                <CellTemplate Context="hoster">
                    @if (hoster.RequiresCaptchaVerification)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">
                            @L["CaptchaRequired"]
                        </BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="@(hoster.IsActive ? BadgeVariant.Default : BadgeVariant.Outline)">
                            @(hoster.IsActive ? L["Active"] : L["Inactive"])
                        </BbBadge>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Configuration"]"
                               Property="@(hoster => hoster.Name)"
                               MinWidth="280px">
                <CellTemplate Context="hoster">
                    @{
                        var previewKeys = hoster.Configuration.Keys.OrderBy(key => key).Take(2).ToList();
                        var extraCount = Math.Max(0, hoster.Configuration.Count - previewKeys.Count);
                    }
                    <BbCollapsible Class="bearcat-registration-config">
                        <div class="bearcat-registration-config-summary">
                            <div class="min-w-0">
                                <p class="text-sm font-medium">@L["FieldCount", hoster.Configuration.Count]</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @string.Join(", ", previewKeys)@(extraCount > 0 ? $" +{extraCount}" : string.Empty)
                                </p>
                            </div>
                            <BbCollapsibleTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["ToggleConfigurationDetails"]">
                                    <LucideIcon Name="chevrons-up-down" class="h-4 w-4" />
                                </BbButton>
                            </BbCollapsibleTrigger>
                        </div>
                        <BbCollapsibleContent>
                            <div class="bearcat-registration-config-details">
                                @foreach (var config in hoster.Configuration.OrderBy(config => config.Key))
                                {
                                    <div class="bearcat-registration-config-row">
                                        <p class="text-xs font-medium text-muted-foreground">@config.Key</p>
                                        @if (string.Equals(config.Key, "password", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <HiddenElement>
                                                <span class="text-sm">@config.Value</span>
                                            </HiddenElement>
                                        }
                                        else
                                        {
                                            <span class="truncate text-sm" title="@config.Value">@config.Value</span>
                                        }
                                    </div>
                                }
                            </div>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header="@L["Login"]"
                               Property="@(hoster => hoster.Name)"
                               Width="260px">
                <CellTemplate Context="hoster">
                    <div class="bearcat-hoster-login-actions">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => TryLoginAsync(hoster))">
                            @L["TryLogin"]
                        </BbButton>
                        @if (hoster is { SupportsCaptchaVerification: true, RequiresCaptchaVerification: true })
                        {
                            <BbButton Class="bearcat-captcha-action-button"
                                      Variant="ButtonVariant.Destructive"
                                      Size="ButtonSize.IconSmall"
                                      AriaLabel="@L["SolveCaptcha"]"
                                      title="@L["SolveCaptcha"]"
                                      OnClick="@(() => ShowCaptchaDialogAsync(hoster))">
                                <LucideIcon Name="shield-alert" class="h-4 w-4" />
                                <span>@L["SolveCaptchaShort"]</span>
                            </BbButton>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="HosterRegistrationReadModel" TValue="string"
                               Header=""
                               Property="@(hoster => hoster.Name)"
                               Width="56px">
                <CellTemplate Context="hoster">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenHosterActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End">
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(hoster))">
                                    @L["EditRegistration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ToggleIsActiveAsync(hoster))">
                                    @(hoster.IsActive ? L["Disable"] : L["Enable"]) @L["Registration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(hoster))">
                                    @L["DeleteRegistration"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
