
@if (!isInitialized)
{
    return;
}

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="formModel.Name"
                              Label="@L["Name"]"
                              Placeholder="@L["NameUploadConfigPlaceholder"]" />

            @if (ShowUploadSource)
            {
                <UploadSourceSelect @bind-Value="formModel.UploadSource"
                                    @bind-Value:after="OnUploadSourceChanged"
                                    Disabled="IsEdit" />
            }

            <UploadTargetSelect Choices="uploadTargetChoices"
                                UploadSource="formModel.UploadSource"
                                @bind-Value="formModel.UploadTarget"
                                @bind-Value:after="OnUploadTargetChanged" />

            @if (CanUsePremiumOnlyDownload)
            {
                <BbFormFieldSwitch @bind-Checked="formModel.PremiumOnlyDownload"
                                   Label="@L["PremiumOnlyDownload"]"
                                   HelperText="@L["PremiumOnlyDownloadHelp"]" />
            }

            @if (UsesArchiveFiles)
            {
                <BbFormFieldSelect TValue="int?"
                                   @bind-Value="formModel.ArchiveConfigId"
                                   Label="@L["ArchiveConfiguration"]"
                                   Placeholder="@L["SelectArchiveConfiguration"]"
                                   Options="archiveConfigOptions.OrderBy(config => config.Name).Select(config => new SelectOption<int?>(config.ArchiveConfigId, config.Name))" />
            }
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @L["Save"]
            </BbButton>
        </div>
    </div>
</EditForm>
