@if (!isInitialized)
{
    return;
}

<div class="bearcat-archive-dialog">
    <div class="shrink-0 space-y-3">
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-lg border border-border/70 bg-muted/30 px-3 py-2">
                <p class="text-xs text-muted-foreground">@L["Upload"]</p>
                <p class="text-sm font-medium">#@UploadId</p>
            </div>
            <div class="rounded-lg border border-border/70 bg-muted/30 px-3 py-2">
                <p class="text-xs text-muted-foreground">@L["UploadConfig"]</p>
                <p class="truncate text-sm font-medium" title="@UploadConfigName">@UploadConfigName</p>
            </div>
        </div>

        <div class="bearcat-upload-filter-row justify-end">
            <textarea id="@CopyTextAreaId" hidden readonly>@ContainerLinksText</textarea>

            <button type="button"
                    class="bearcat-copy-button"
                    disabled="@(ContainerLinks.Count == 0)"
                    data-copy-target="@CopyTextAreaId"
                    data-copy-label="@L["CopyAllLinks"]"
                    data-copy-success-label="@L["Copied"]"
                    data-copy-failure-label="@L["CopyFailed"]"
                    onclick="window.bearcat.copyFromTarget(this)">
                <LucideIcon Name="copy" class="h-4 w-4" />
                <span class="bearcat-copy-button-label">@L["CopyAllLinks"]</span>
            </button>
        </div>
    </div>

    <div class="bearcat-archive-dialog-body">
        <BbDataTable TData="ReleaseUploadContainerLinkReadModel"
                     Data="containers"
                     ShowToolbar="false"
                     ShowPagination="false"
                     InitialPageSize="@Math.Max(containers.Count, 5)"
                     IsLoading="isLoading"
                     AriaLabel="@L["ContainerLinks"]"
                     Class="bearcat-upload-links-table bearcat-container-links-table rounded-lg border border-border/70">
            <Columns>
                <BbDataTableColumn TData="ReleaseUploadContainerLinkReadModel" TValue="string"
                                   Header="@L["LinkCrypter"]"
                                   Property="@(container => container.LinkCrypterRegistrationName)"
                                   Width="190px">
                    <CellTemplate Context="container">
                        <div class="grid min-w-0 gap-2">
                            <p class="truncate text-sm font-medium" title="@container.LinkCrypterRegistrationName">
                                @container.LinkCrypterRegistrationName
                            </p>
                            <p class="truncate text-xs text-muted-foreground" title="@container.LinkCrypterClassName">
                                @container.LinkCrypterClassName
                            </p>
                            <div class="flex items-center gap-2">
                                <BbBadge Variant="@GetContainerVariant(container.State)">
                                    @L.Localize(container.State)
                                </BbBadge>
                                @if (container.Scope is LinkCrypterContainerScope.ReleaseCollection)
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">
                                        @L["CollectionContainer"]
                                    </BbBadge>
                                }
                                <ErrorMessagesTooltip Messages="container.Errors" />
                            </div>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="ReleaseUploadContainerLinkReadModel" TValue="string"
                                   Header="@L["ContainerLink"]"
                                   Property="@(container => container.ContainerUrl)"
                                   MinWidth="420px">
                    <CellTemplate Context="container">
                        @if (string.IsNullOrWhiteSpace(container.ContainerUrl))
                        {
                            <span class="text-sm text-muted-foreground">-</span>
                        }
                        else
                        {
                            <a class="bearcat-upload-link bearcat-container-link"
                               href="@container.ContainerUrl"
                               target="_blank"
                               rel="noreferrer noopener"
                               title="@container.ContainerUrl">
                                @container.ContainerUrl
                            </a>
                        }
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="ReleaseUploadContainerLinkReadModel" TValue="string"
                                   Header="@L["LinkCrypterSettings"]"
                                   Property="@(container => container.LinkCrypterRegistrationName)"
                                   Width="140px">
                    <CellTemplate Context="container">
                        <div class="bearcat-container-link-settings">
                            @if (container.SupportsCaptcha)
                            {
                                <div class="bearcat-container-link-setting">
                                    <span class="bearcat-container-link-setting-dot @(container.EnableCaptcha ? "is-enabled" : "is-disabled")"></span>
                                    <span>@L["Captcha"]</span>
                                    <span class="text-muted-foreground">@(container.EnableCaptcha ? L["Enabled"] : L["Disabled"])</span>
                                </div>
                            }
                            @if (container.SupportsContainerDownload)
                            {
                                <div class="bearcat-container-link-setting">
                                    <span class="bearcat-container-link-setting-dot @(container.EnableContainerDownload ? "is-enabled" : "is-disabled")"></span>
                                    <span>@L["ContainerDownloadShort"]</span>
                                    <span class="text-muted-foreground">@(container.EnableContainerDownload ? L["Enabled"] : L["Disabled"])</span>
                                </div>
                            }
                            @if (container.SupportsClickAndLoad)
                            {
                                <div class="bearcat-container-link-setting">
                                    <span class="bearcat-container-link-setting-dot @(container.EnableClickAndLoad ? "is-enabled" : "is-disabled")"></span>
                                    <span>@L["ClickAndLoadShort"]</span>
                                    <span class="text-muted-foreground">@(container.EnableClickAndLoad ? L["Enabled"] : L["Disabled"])</span>
                                </div>
                            }
                            @if (!container.SupportsCaptcha && !container.SupportsContainerDownload && !container.SupportsClickAndLoad)
                            {
                                <span class="text-sm text-muted-foreground">-</span>
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="ReleaseUploadContainerLinkReadModel" TValue="DateTime"
                                   Header="@L["CreatedAt"]"
                                   Property="@(container => container.CreatedAt)"
                                   Width="160px">
                    <CellTemplate Context="container">
                        <span class="text-sm">@container.CreatedAt.ToString("g")</span>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
            <EmptyTemplate>
                <div class="bearcat-release-empty">
                    <LucideIcon Name="inbox" class="h-5 w-5" />
                    <span>@L["NoContainerLinksFound"]</span>
                </div>
            </EmptyTemplate>
        </BbDataTable>
    </div>

    <div class="bearcat-archive-dialog-footer">
        <BbButton Variant="ButtonVariant.Outline" OnClick="CloseAsync">
            @L["Close"]
        </BbButton>
    </div>
</div>
