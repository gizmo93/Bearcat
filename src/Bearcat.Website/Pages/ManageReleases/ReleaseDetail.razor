@page "/releases/{ReleaseId:int}"
@using Bearcat.Website.Pages.ManageArchiveConfigs
@using Bearcat.Website.Pages.ManageImageUploadConfigs
@using Bearcat.Website.Pages.ManageImageUploads
@using Bearcat.Website.Pages.ManagePostedLocations
@using Bearcat.Website.Pages.ManageUploadConfigs
@using Bearcat.Website.Pages.PostQueue
@inherits OwningComponentBase

@if (!isInitialized)
{
    return;
}

<PageTitle>@L["Release"] - @release.Name - Bearcat</PageTitle>

<section class="bearcat-release-shell">
    @if (IsPostQueueWorkflow)
    {
        <PostQueueWorkflowBar Type="PostQueueWorkflowType.Release" CurrentId="@ReleaseId" />
    }

    <div class="bearcat-release-header">
        <div class="min-w-0 space-y-4">
            <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 space-y-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="bearcat-release-title font-semibold">
                            @release.Name
                        </h1>
                        <textarea id="release-title-copy-@ReleaseId" hidden readonly>@release.Name</textarea>
                        <button type="button"
                                class="bearcat-copy-button bearcat-copy-icon-button"
                                aria-label="@L["CopyTitle"]"
                                title="@L["CopyTitle"]"
                                data-copy-target="release-title-copy-@ReleaseId"
                                data-copy-label="@L["CopyTitle"]"
                                data-copy-success-label="@L["Copied"]"
                                data-copy-failure-label="@L["CopyFailed"]"
                                onclick="window.bearcat.copyFromTarget(this)">
                            <LucideIcon Name="copy" class="h-4 w-4" />
                            <span class="sr-only bearcat-copy-button-label">@L["CopyTitle"]</span>
                        </button>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
                            <BbTooltipTrigger>
                                <span class="bearcat-badge-trigger">
                                    <BbBadge Variant="BadgeVariant.Outline">@L.Localize(release.ReleaseType)</BbBadge>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent Class="max-w-xs text-xs">
                                @L.LocalizeDescription(release.ReleaseType)
                            </BbTooltipContent>
                        </BbTooltip>
                        <OnlineStateBadge Value="release.OnlineState" />
                    </div>
                </div>

                <BbDropdownMenu>
                    <BbDropdownMenuTrigger>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenReleaseActions"]">
                            <LucideIcon Name="ellipsis" class="h-4 w-4" />
                        </BbButton>
                    </BbDropdownMenuTrigger>
                    <BbDropdownMenuContent Align="PopoverAlign.End">
                        <BbDropdownMenuItem OnClick="ShowEditReleaseDialogAsync">
                            @L["Edit"]
                        </BbDropdownMenuItem>
                        <BbDropdownMenuItem OnClick="SaveAsTemplateAsync">
                            @L["SaveAsTemplate"]
                        </BbDropdownMenuItem>
                        <BbDropdownMenuItem OnClick="DeleteReleaseAsync">
                            @L["DeleteRelease"]
                        </BbDropdownMenuItem>
                    </BbDropdownMenuContent>
                </BbDropdownMenu>
            </div>
        </div>
    </div>

    <div class="bearcat-release-info-bar">
        <div class="bearcat-release-folder">
            <LucideIcon Name="folder" class="h-4 w-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0">
                <p class="text-xs text-muted-foreground">@L["ReleaseFolder"]</p>
                <p class="bearcat-release-path">@release.ReleaseFolderPath</p>
            </div>
        </div>

        <div class="bearcat-release-folder">
            <LucideIcon Name="layers" class="h-4 w-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0">
                <p class="text-xs text-muted-foreground">@L["ReleaseGroup"]</p>
                <p class="bearcat-release-path">@release.ReleaseGroupName</p>
            </div>
        </div>

        <div class="bearcat-release-folder">
            <LucideIcon Name="clapperboard" class="h-4 w-4 shrink-0 text-muted-foreground" />
            <div class="min-w-0">
                <p class="text-xs text-muted-foreground">@L["ReleaseContentType"]</p>
                <p class="bearcat-release-path">@L.Localize(release.ReleaseContentType)</p>
            </div>
        </div>
    </div>

    <BbTabs @key="ReleaseId" Value="@activeTab" ValueChanged="HandleTabChangedAsync" Class="space-y-4">
        <BbTabsList>
            <BbTabsTrigger Value="overview">@L["ReleaseOverview"]</BbTabsTrigger>
            <BbTabsTrigger Value="release-infos">@L["ReleaseInfo"]</BbTabsTrigger>
            <BbTabsTrigger Value="archives">@L["ArchiveConfigurations"]</BbTabsTrigger>
            <BbTabsTrigger Value="upload-configs">
                <span class="bearcat-tab-label">
                    <span>@L["UploadConfigurations"]</span>
                    <span class="bearcat-tab-meta">@release.ActiveUploadConfigsCount</span>
                </span>
            </BbTabsTrigger>
            <BbTabsTrigger Value="image-upload-configs">
                <span class="bearcat-tab-label">
                    <span>@L["ImageUploadConfigurations"]</span>
                </span>
            </BbTabsTrigger>
            <BbTabsTrigger Value="uploads">
                <span class="bearcat-tab-label">
                    <span>@L["Uploads"]</span>
                    <span class="bearcat-tab-meta">@release.OnlineUploadConfigsCount @L["OnlineState.Online"]</span>
                </span>
            </BbTabsTrigger>
            <BbTabsTrigger Value="image-uploads">
                <span class="bearcat-tab-label">
                    <span>@L["ImageUploads"]</span>
                </span>
            </BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="overview" Class="space-y-4">
            <ReleaseOverview
                @ref="@reloadableComponents[nameof(ReleaseOverview)]"
                ReleaseId="@ReleaseId"
                ReleaseName="@release.Name"
                ReleaseFolderPath="@release.ReleaseFolderPath" />
            <PostedLocations ReleaseId="@ReleaseId" />
        </BbTabsContent>

        <BbTabsContent Value="release-infos" Class="space-y-4">
            <ReleaseInfoPanel ReleaseId="@ReleaseId" ReleaseName="@release.Name" />
        </BbTabsContent>

        <BbTabsContent Value="archives" Class="space-y-4">
            <ArchiveConfigs
                @ref="@reloadableComponents[nameof(ArchiveConfigs)]"
                ReleaseId="ReleaseId"
                ReleaseType="release.ReleaseType"
                FocusArchiveConfigId="@FocusArchiveConfigId"
                OnChangeAffectingOtherComponents="HandleChangeAffectingOtherComponentsAsync" />
        </BbTabsContent>

        <BbTabsContent Value="upload-configs" Class="space-y-4">
            <UploadConfigs
                @ref="@reloadableComponents[nameof(UploadConfigs)]"
                ReleaseId="@ReleaseId"
                FocusUploadConfigId="@FocusUploadConfigId" />
        </BbTabsContent>

        <BbTabsContent Value="image-upload-configs" Class="space-y-4">
            <ImageUploadConfigs ReleaseId="@ReleaseId" />
        </BbTabsContent>

        <BbTabsContent Value="uploads" Class="space-y-4">
            <ReleaseUploads ReleaseId="@ReleaseId" InitialUploadConfigId="@FocusUploadConfigId" />
        </BbTabsContent>

        <BbTabsContent Value="image-uploads" Class="space-y-4">
            <ReleaseImageUploads ReleaseId="@ReleaseId" />
        </BbTabsContent>
    </BbTabs>
</section>
