@page "/releases/create"
@inherits OwningComponentBase

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="space-y-6">
        <div class="space-y-4">
            <BbFormFieldInput TValue="string"
                              @bind-Value="formModel.Name"
                              Label="@L["Name"]"
                              Placeholder="@L["NameYourRelease"]" />

            @if (releaseGroups.Count > 0)
            {
                <BbFormFieldSelect TValue="int"
                                   @bind-Value="formModel.ReleaseGroupId"
                                   Label="@L["ReleaseGroup"]"
                                   Placeholder="@L["SelectReleaseGroup"]"
                                   DisplayTextSelector="GetReleaseGroupDisplayText"
                                   Options="ReleaseGroupOptions" />
            }

            <BbFormFieldSelect TValue="ReleaseType"
                               @bind-Value="formModel.ReleaseType"
                               Label="@L["ReleaseType"]"
                               Disabled="formModel.IsEdit"
                               DisplayTextSelector="GetReleaseTypeDisplayText"
                               Options="ReleaseTypeOptions" />

            <BbFormFieldSelect TValue="ReleaseContentType"
                               @bind-Value="formModel.ReleaseContentType"
                               Label="@L["ReleaseContentType"]"
                               DisplayTextSelector="GetReleaseContentTypeDisplayText"
                               Options="ReleaseContentTypeOptions" />

            @if (ShowFolderSelection)
            {
                <div class="space-y-2">
                    <label class="text-sm font-medium">@FolderLabel</label>
                    <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                        <BbInput Value="@formModel.FolderPath" Disabled="true" Class="sm:flex-1" />
                        <BbButton Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Small"
                                  Class="justify-center whitespace-nowrap"
                                  AriaLabel="@FolderLabel"
                                  OnClick="OpenFolderDialogAsync">
                            <LucideIcon Name="folder-open" class="h-4 w-4" />
                            @L["Browse"]
                        </BbButton>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(folderValidationMessage))
                    {
                        <p class="text-sm text-destructive">@folderValidationMessage</p>
                    }
                </div>
            }

            <div class="rounded-lg border border-border/70 bg-muted/30 px-3 py-2 text-sm text-muted-foreground">
                @L.LocalizeDescription(formModel.ReleaseType)
            </div>
        </div>

        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
                @L["Cancel"]
            </BbButton>
            <BbButton Type="ButtonType.Submit">
                @(formModel.IsEdit ? L["Save"] : L["CreateRelease"])
            </BbButton>
        </div>
    </div>
</EditForm>
