@page "/releases"
@using Bearcat.Website.Pages.ManageReleases.Results
@using Bearcat.Website.Pages.ManageReleases.Search

<PageTitle>@L["Releases"] - Bearcat</PageTitle>

<section class="@SectionClass">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["Releases"]</h1>
            <p class="mt-1 text-sm text-muted-foreground">@ReleaseTotalCountText</p>
        </div>

        <div class="flex flex-wrap gap-2">
            <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddReleaseDialogAsync">
                <LucideIcon Name="plus" class="h-4 w-4" />
                @L["NewRelease"]
            </BbButton>
            <BbButton Variant="ButtonVariant.Secondary" Class="bearcat-page-action" OnClick="ShowAddReleaseFromTemplateDialogAsync">
                <LucideIcon Name="copy" class="h-4 w-4" />
                @L["NewFromTemplate"]
            </BbButton>
        </div>
    </div>

    <div class="space-y-3">
        <ReleaseSearchBar Query="searchQuery"
                          OnQueryChanged="ApplySearchAsync"
                          OnSearchTermTyped="ApplyTypedSearchAsync" />

        <ReleaseSearchFilters Query="searchQuery"
                              HosterRegistrations="hosterRegistrations"
                              Archivers="archiverOptions"
                              ReleaseGroups="releaseGroups"
                              LinkCrypterRegistrations="linkCrypterRegistrations"
                              OnQueryChanged="ApplySearchAsync" />

        <div class="flex flex-wrap items-center justify-between gap-2">
            <ReleaseOnlineStateSegments Counts="onlineStateCounts"
                                        SelectedOnlineState="searchQuery.OnlineState"
                                        SelectedOnlineStateChanged="ApplyOnlineStateAsync" />
            <ReleaseSortOrderSelect Value="searchQuery.SortOrder"
                                    ValueChanged="ApplySortOrderAsync" />
        </div>
    </div>

    <ReleaseSearchResultList Releases="releases"
                             Selection="selection"
                             SearchTerm="@searchQuery.SearchTerm"
                             IsLoading="isLoading"
                             HasActiveFilters="HasActiveFilters"
                             OnResetFilters="ResetFiltersAsync"
                             OnSelectionChanged="StateHasChanged"
                             OnEditRelease="ShowEditReleaseDialogAsync"
                             OnDeleteRelease="DeleteReleaseAsync" />

    <SearchResultsPagination TotalCount="totalCount"
                             PageIndex="pageIndex"
                             PageSize="pageSize"
                             ResultsSummaryResourceKey="ReleaseResultsSummary"
                             GetPageUrl="GetPageUri"
                             PageSizeChanged="ChangePageSize" />

    <ReleaseBulkActionBar Selection="selection"
                          VisibleReleaseIds="VisibleReleaseIds"
                          ReleaseGroups="releaseGroups"
                          OnSelectionChanged="StateHasChanged"
                          OnReleasesUpdated="RefreshReleasesAsync" />
</section>
