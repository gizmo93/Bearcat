@page "/releases"
@inherits OwningComponentBase

<PageTitle>@L["Releases"] - Bearcat</PageTitle>

<section class="bearcat-releases-page space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["Releases"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["ReleasesIntro"]
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddReleaseDialogAsync">
                <LucideIcon Name="plus" class="h-4 w-4" />
                @L["NewRelease"]
            </BbButton>
            <BbButton Variant="ButtonVariant.Secondary" Class="bearcat-page-action" OnClick="ShowAddReleaseFromTemplateDialogAsync">
                <LucideIcon Name="copy" class="h-4 w-4" />
                @L["NewFromTemplate"]
            </BbButton>
        </div>
    </div>

    <ReleaseSearchForm HosterRegistrations="hosterRegistrations"
                       Archivers="archiverOptions"
                       ReleaseGroups="releaseGroups"
                       LinkCrypterRegistrations="linkCrypterRegistrations"
                       OnSearch="ApplySearchAsync" />

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-border/70 bg-muted/25 px-3 py-2">
        @if (selectedReleaseIds.Count > 0)
        {
            <p class="text-sm font-medium">@L["SelectedReleaseCount", selectedReleaseIds.Count]</p>
            <div class="flex flex-wrap items-center gap-2">
                @if (!AreAllVisibleReleasesSelected)
                {
                    <BbButton Variant="ButtonVariant.Secondary"
                              Size="ButtonSize.Small"
                              Disabled="@(releases.Count == 0)"
                              OnClick="SelectAllVisibleReleases">
                        <LucideIcon Name="list-checks" class="h-4 w-4" />
                        @L["SelectAll"]
                    </BbButton>
                }
                <BbButton Variant="ButtonVariant.Secondary"
                          Size="ButtonSize.Small"
                          OnClick="DeselectAllReleases">
                    <LucideIcon Name="list-x" class="h-4 w-4" />
                    @L["DeselectAll"]
                </BbButton>
                <BbSelect TValue="int"
                          @bind-Value="selectedBulkReleaseGroupId"
                          Options="ReleaseGroupOptions"
                          Placeholder="@L["SelectReleaseGroup"]"
                          Class="w-56" />
                <BbButton Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Disabled="@(selectedBulkReleaseGroupId == 0)"
                          OnClick="ApplyBulkReleaseGroupAsync">
                    <LucideIcon Name="layers" class="h-4 w-4" />
                    @L["ChangeReleaseGroup"]
                </BbButton>
            </div>
        }
        else
        {
            <p class="text-sm text-muted-foreground">@L["NoReleasesSelected"]</p>
            <BbButton Variant="ButtonVariant.Secondary"
                      Size="ButtonSize.Small"
                      Disabled="@(releases.Count == 0)"
                      OnClick="SelectAllVisibleReleases">
                <LucideIcon Name="list-checks" class="h-4 w-4" />
                @L["SelectAll"]
            </BbButton>
        }
    </div>

    <BbDataTable TData="ReleaseReadModel"
                 @key="ReleasesTableKey"
                 Data="releases"
                 ShowToolbar="false"
                 ShowPagination="false"
                 InitialPageSize="@pageSize"
                 IsLoading="isLoading"
                 AriaLabel="@L["Releases"]"
                 Class="bearcat-releases-table">
        <Columns>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="bool"
                               Header=""
                               Property="@(release => selectedReleaseIds.Contains(release.ReleaseId))"
                               Width="48px">
                <CellTemplate Context="release">
                    <div class="flex justify-center" @onclick:stopPropagation="true">
                        <BbCheckbox Checked="@selectedReleaseIds.Contains(release.ReleaseId)"
                                    AriaLabel="@L["Selected"]"
                                    CheckedChanged="@((bool selected) => ToggleReleaseSelection(release.ReleaseId, selected))" />
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header="@L["Name"]"
                               Property="@(release => release.Name)">
                <CellTemplate Context="release">
                    <a class="bearcat-release-list-name"
                       href="@($"/releases/{release.ReleaseId}")">
                        @release.Name
                    </a>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header="@L["OnlineState"]"
                               Property="@(release => release.OnlineState.ToString())"
                               Width="140px">
                <CellTemplate Context="release">
                    <OnlineStateBadge Value="@release.OnlineState" />
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header="@L["ReleaseType"]"
                               Property="@(release => release.ReleaseType.ToString())"
                               Width="140px">
                <CellTemplate Context="release">
                    <BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
                        <BbTooltipTrigger>
                            <span class="inline-flex items-center leading-none">
                                <BbBadge Variant="BadgeVariant.Outline">@L.Localize(release.ReleaseType)</BbBadge>
                            </span>
                        </BbTooltipTrigger>
                        <BbTooltipContent Class="max-w-xs text-xs">
                            @L.LocalizeDescription(release.ReleaseType)
                        </BbTooltipContent>
                    </BbTooltip>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header="@L["ReleaseContentType"]"
                               Property="@(release => release.ReleaseContentType.ToString())"
                               Width="150px">
                <CellTemplate Context="release">
                    <BbBadge Variant="BadgeVariant.Secondary">@L.Localize(release.ReleaseContentType)</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header="@L["ReleaseGroup"]"
                               Property="@(release => release.ReleaseGroupName)"
                               Width="180px">
                <CellTemplate Context="release">
                    <BbBadge Variant="BadgeVariant.Outline">@release.ReleaseGroupName</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ReleaseReadModel" TValue="string"
                               Header=""
                               Property="@(release => release.Name)"
                               Width="56px">
                <CellTemplate Context="release">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenReleaseActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End">
                                <BbDropdownMenuItem Href="@($"/releases/{release.ReleaseId}")">
                                    @L["OpenDetails"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditReleaseDialogAsync(release))">
                                    @L["Edit"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteReleaseAsync(release))">
                                    @L["DeleteRelease"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
        <EmptyTemplate>
            <div class="bearcat-release-empty">
                <LucideIcon Name="inbox" class="h-5 w-5" />
                <span>@L["NoReleasesFound"]</span>
            </div>
        </EmptyTemplate>
    </BbDataTable>

    <div class="bearcat-release-pagination">
        <p class="text-sm text-muted-foreground">
            @L["ReleaseResultsSummary", FirstResult, LastResult, totalCount]
        </p>

        <div class="bearcat-release-pagination-controls">
            <label class="bearcat-page-size">
                <span>@L["RowsPerPage"]</span>
                <BbSelect TValue="int"
                          @bind-Value="pageSize"
                          @bind-Value:after="OnPageSizeChangedAsync"
                          Options="PageSizeOptions"
                          Class="w-24" />
            </label>

            @if (TotalPages > 1)
            {
                <BbPagination Class="flex justify-start">
                    <BbPaginationContent>
                        <BbPaginationItem>
                            <BbPaginationPrevious Disabled="@(CurrentPage <= 1)"
                                                  Text="@L["Previous"]"
                                                  OnClick="GoToPreviousPageAsync" />
                        </BbPaginationItem>

                        @foreach (var page in PaginationItems)
                        {
                            <BbPaginationItem>
                                @if (page is null)
                                {
                                    <BbPaginationEllipsis />
                                }
                                else
                                {
                                    <BbPaginationLink IsActive="@(page == CurrentPage)"
                                                      OnClick="@(() => GoToPageAsync(page.Value))">
                                        @(page.Value)
                                    </BbPaginationLink>
                                }
                            </BbPaginationItem>
                        }

                        <BbPaginationItem>
                            <BbPaginationNext Disabled="@(CurrentPage >= TotalPages)"
                                              Text="@L["Next"]"
                                              OnClick="GoToNextPageAsync" />
                        </BbPaginationItem>
                    </BbPaginationContent>
                </BbPagination>
            }
        </div>
    </div>
</section>
