<EditForm Model="this" OnSubmit="ApplyFiltersAsync" class="bearcat-release-search">
    <div class="bearcat-release-search-grid">
        <BbFormFieldInput TValue="string"
                          @bind-Value="searchTerm"
                          Label="@L["SearchReleases"]"
                          Placeholder="@L["ReleaseSearchPlaceholder"]" />

        <BbFormFieldSelect TValue="ReleaseType?"
                           @bind-Value="selectedReleaseType"
                           Label="@L["ReleaseType"]"
                           Options="ReleaseTypeOptions" />

        <BbFormFieldSelect TValue="OnlineState?"
                           @bind-Value="selectedOnlineState"
                           Label="@L["OnlineState"]"
                           Options="OnlineStateOptions" />

        <BbFormFieldSelect TValue="int?"
                           @bind-Value="selectedHosterRegistrationId"
                           Label="@L["HosterRegistration"]"
                           Options="HosterRegistrationOptions" />

        <BbFormFieldSelect TValue="string"
                           @bind-Value="selectedArchiverName"
                           Label="@L["Archiver"]"
                           Options="ArchiverOptions" />

        <BbFormFieldSelect TValue="int?"
                           @bind-Value="selectedLinkCrypterRegistrationId"
                           Label="@L["LinkCrypter"]"
                           Options="LinkCrypterRegistrationOptions" />

        <BbFormFieldSelect TValue="int"
                           @bind-Value="selectedReleaseGroupId"
                           Label="@L["ReleaseGroup"]"
                           Options="ReleaseGroupOptions" />

        <BbFormFieldInput TValue="string"
                          @bind-Value="linksDistributedTo"
                          Label="@L["LinksDistributedTo"]"
                          Placeholder="@L["LinksDistributedToSearchPlaceholder"]" />
    </div>

    <div class="bearcat-release-search-advanced">
        <BbButton Type="ButtonType.Button"
                  Variant="ButtonVariant.Ghost"
                  Size="ButtonSize.Small"
                  Class="@AdvancedSearchToggleClass"
                  OnClick="ToggleAdvancedSearch">
            <LucideIcon Name="sliders-horizontal" class="h-4 w-4" />
            @L["AdvancedSearch"]
            <LucideIcon Name="chevron-down" class="@AdvancedSearchChevronClass" />
        </BbButton>

        @if (showAdvancedSearch)
        {
            <div class="bearcat-release-search-grid bearcat-release-search-advanced-grid">
                <BbFormFieldInput TValue="string"
                                  @bind-Value="downloadLink"
                                  Label="@L["DownloadLink"]"
                                  Placeholder="@L["DownloadLinkSearchPlaceholder"]" />

                <BbFormFieldInput TValue="string"
                                  @bind-Value="archiveFileName"
                                  Label="@L["RarFile"]"
                                  Placeholder="@L["RarFileSearchPlaceholder"]" />

                <BbFormFieldInput TValue="string"
                                  @bind-Value="uploadId"
                                  Label="@L["UploadId"]"
                                  Placeholder="@L["UploadIdSearchPlaceholder"]" />
            </div>
        }
    </div>

    <div class="bearcat-release-search-actions">
        <BbButton Type="ButtonType.Submit"
                  Size="ButtonSize.Small"
                  Class="bearcat-release-search-button"
                  style="@SearchButtonStyle">
            <LucideIcon Name="search" class="h-4 w-4" />
            @L["Search"]
        </BbButton>
        <BbButton Type="ButtonType.Button"
                  Variant="ButtonVariant.Secondary"
                  Size="ButtonSize.Small"
                  Class="bearcat-release-search-button"
                  style="@SearchButtonStyle"
                  OnClick="ResetFiltersAsync">
            <LucideIcon Name="rotate-ccw" class="h-4 w-4" />
            @L["ResetFilters"]
        </BbButton>
    </div>
</EditForm>

@code {
    [Parameter]
    public IReadOnlyList<HosterRegistrationReadModel> HosterRegistrations { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ArchiverDto> Archivers { get; set; } = [];

    [Parameter]
    public IReadOnlyList<LinkCrypterRegistrationReadModel> LinkCrypterRegistrations { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ReleaseGroupReadModel> ReleaseGroups { get; set; } = [];

    [Parameter]
    public EventCallback<ReleaseSearchQuery> OnSearch { get; set; }

    private const string SearchButtonStyle = "width: 8.75rem; min-width: 8.75rem; height: 2.25rem; min-height: 2.25rem; padding: 0 0.85rem; justify-content: center;";

    private string? searchTerm;
    private string? linksDistributedTo;
    private string? downloadLink;
    private string? archiveFileName;
    private string? uploadId;
    private ReleaseType? selectedReleaseType;
    private OnlineState? selectedOnlineState;
    private int? selectedHosterRegistrationId;
    private string selectedArchiverName = string.Empty;
    private int? selectedLinkCrypterRegistrationId;
    private int selectedReleaseGroupId;
    private bool showAdvancedSearch;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm)
        || !string.IsNullOrWhiteSpace(linksDistributedTo)
        || HasActiveAdvancedFilters
        || selectedReleaseType is not null
        || selectedOnlineState is not null
        || selectedHosterRegistrationId is not null
        || !string.IsNullOrWhiteSpace(selectedArchiverName)
        || selectedLinkCrypterRegistrationId is not null
        || selectedReleaseGroupId != 0;

    private bool HasActiveAdvancedFilters =>
        !string.IsNullOrWhiteSpace(downloadLink)
        || !string.IsNullOrWhiteSpace(archiveFileName)
        || !string.IsNullOrWhiteSpace(uploadId);

    private string AdvancedSearchToggleClass =>
        HasActiveAdvancedFilters
            ? "bearcat-release-search-advanced-toggle bearcat-release-search-advanced-toggle-active"
            : "bearcat-release-search-advanced-toggle";

    private string AdvancedSearchChevronClass =>
        showAdvancedSearch
            ? "h-4 w-4 bearcat-release-search-advanced-chevron bearcat-release-search-advanced-chevron-open"
            : "h-4 w-4 bearcat-release-search-advanced-chevron";

    private IEnumerable<SelectOption<OnlineState?>> OnlineStateOptions =>
        new SelectOption<OnlineState?>[]
        {
            new(null, L["AnyOnlineState"]),
            new(OnlineState.Online, L.Localize(OnlineState.Online)),
            new(OnlineState.PartiallyOnline, L.Localize(OnlineState.PartiallyOnline)),
            new(OnlineState.Offline, L.Localize(OnlineState.Offline)),
            new(OnlineState.Unknown, L.Localize(OnlineState.Unknown)),
        };

    private IEnumerable<SelectOption<ReleaseType?>> ReleaseTypeOptions =>
        new SelectOption<ReleaseType?>[] { new(null, L["AnyReleaseType"]) }.Concat(
            Enum.GetValues<ReleaseType>()
                .Select(type => new SelectOption<ReleaseType?>(type, L.Localize(type)))
        );

    private IEnumerable<SelectOption<int?>> HosterRegistrationOptions =>
        new[] { new SelectOption<int?>(null, L["AnyHosterConfig"]) }.Concat(
            HosterRegistrations.Select(h => new SelectOption<int?>(
                h.Id,
                $"{h.Name} ({h.HosterName})"
            ))
        );

    private IEnumerable<SelectOption<string>> ArchiverOptions =>
        new[] { new SelectOption<string>(string.Empty, L["AnyArchiver"]) }.Concat(
            Archivers.Select(a => new SelectOption<string>(
                a.ClassName,
                $"{a.Name} ({a.FileExtension})"
            ))
        );

    private IEnumerable<SelectOption<int?>> LinkCrypterRegistrationOptions =>
        new[] { new SelectOption<int?>(null, L["AnyLinkCrypterConfig"]) }.Concat(
            LinkCrypterRegistrations.Select(l => new SelectOption<int?>(
                l.LinkCrypterRegistrationId,
                $"{l.Name} ({l.CrypterName})"
            ))
        );

    private IEnumerable<SelectOption<int>> ReleaseGroupOptions =>
        new[] { new SelectOption<int>(0, L["AnyReleaseGroup"]) }.Concat(
            ReleaseGroups.Select(group => new SelectOption<int>(
                group.ReleaseGroupId,
                group.Name
            ))
        );

    private async Task ApplyFiltersAsync()
    {
        await OnSearch.InvokeAsync(CreateQuery());
    }

    private async Task ResetFiltersAsync()
    {
        if (!HasActiveFilters)
        {
            return;
        }

        searchTerm = null;
        linksDistributedTo = null;
        downloadLink = null;
        archiveFileName = null;
        uploadId = null;
        selectedReleaseType = null;
        selectedOnlineState = null;
        selectedHosterRegistrationId = null;
        selectedArchiverName = string.Empty;
        selectedLinkCrypterRegistrationId = null;
        selectedReleaseGroupId = 0;
        showAdvancedSearch = false;

        await OnSearch.InvokeAsync(CreateQuery());
    }

    private void ToggleAdvancedSearch()
    {
        showAdvancedSearch = !showAdvancedSearch;
    }

    private ReleaseSearchQuery CreateQuery()
    {
        return new ReleaseSearchQuery(
            SearchTerm: searchTerm,
            ReleaseType: selectedReleaseType,
            OnlineState: selectedOnlineState,
            HosterRegistrationId: selectedHosterRegistrationId,
            ArchiverName: string.IsNullOrWhiteSpace(selectedArchiverName)
                ? null
                : selectedArchiverName,
            LinkCrypterRegistrationId: selectedLinkCrypterRegistrationId,
            ReleaseGroupId: selectedReleaseGroupId == 0 ? null : selectedReleaseGroupId,
            LinksDistributedTo: linksDistributedTo,
            DownloadLink: downloadLink,
            ArchiveFileName: archiveFileName,
            UploadId: uploadId
        );
    }
}
