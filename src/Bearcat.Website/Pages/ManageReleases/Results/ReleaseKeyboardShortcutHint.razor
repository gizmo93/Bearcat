<p class="bearcat-release-keyboard-hint">
    <span class="bearcat-release-keyboard-hint-item">
        <BbKbd Keys="/" Size="KbdSize.Small" />
        @L["KeyboardHintSearch"]
    </span>
    <span aria-hidden="true">·</span>
    <span class="bearcat-release-keyboard-hint-item">
        <BbKbd Keys="J" Size="KbdSize.Small" />
        <BbKbd Keys="K" Size="KbdSize.Small" />
        @L["KeyboardHintMove"]
    </span>
    <span aria-hidden="true">·</span>
    <span class="bearcat-release-keyboard-hint-item">
        <BbKbd Keys="X" Size="KbdSize.Small" />
        @L["KeyboardHintSelect"]
    </span>
    <span aria-hidden="true">·</span>
    <span class="bearcat-release-keyboard-hint-item">
        <BbKbd Keys="@L["KeySpace"]" Size="KbdSize.Small" />
        @L["KeyboardHintQuickLook"]
    </span>
    <span aria-hidden="true">·</span>
    <span class="bearcat-release-keyboard-hint-item">
        <BbKbd Keys="@L["KeyEnter"]" Size="KbdSize.Small" />
        @L["KeyboardHintOpen"]
    </span>
</p>
