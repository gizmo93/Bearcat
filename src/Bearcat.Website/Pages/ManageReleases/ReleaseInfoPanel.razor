@using Bearcat.Website.Pages.ManageReleases.MediaFiles

<section class="bearcat-release-info-section space-y-4">
    <div class="bearcat-section-header">
        <div>
            <h2 class="text-lg font-semibold">@L["ReleaseInfo"]</h2>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Disabled="isLoading"
                      OnClick="ShowEditReleaseInfoDialogAsync">
                <LucideIcon Name="@(releaseInfo is null ? "plus" : "pencil")" class="h-4 w-4" />
                @(releaseInfo is null ? L["AddReleaseInfo"] : L["EditReleaseInfo"])
            </BbButton>

            @if (releaseInfo is null)
            {
                <BbButton Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Disabled="isLoading || isResolving"
                          OnClick="ResolveReleaseInfoAsync">
                    <LucideIcon Name="radar" class="@($"h-4 w-4 {(isResolving ? "animate-spin" : string.Empty)}")" />
                    @L["ResolveReleaseInfo"]
                </BbButton>
            }

            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Disabled="isLoading"
                      OnClick="ShowEditReleaseNfoDialogAsync">
                <LucideIcon Name="@(releaseNfo is null ? "file-plus" : "file-pen")" class="h-4 w-4" />
                @(releaseNfo is null ? L["AddNfo"] : L["EditNfo"])
            </BbButton>

            @if (CanExtractMediaMetadata)
            {
                <BbButton Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Small"
                          Disabled="isLoading || isExtracting"
                          OnClick="ExtractMediaMetadataAsync">
                    <LucideIcon Name="clapperboard" class="@($"h-4 w-4 {(isExtracting ? "animate-spin" : string.Empty)}")" />
                    @L["ExtractMediaMetadata"]
                </BbButton>
            }

            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      Disabled="isLoading"
                      OnClick="LoadReleaseInfoAsync">
                <LucideIcon Name="refresh-cw" class="@($"h-4 w-4 {(isLoading ? "animate-spin" : string.Empty)}")" />
                @L["Refresh"]
            </BbButton>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bearcat-release-info-list">
            <div class="bearcat-release-empty">
                <LucideIcon Name="loader-circle" class="h-5 w-5 animate-spin" />
                <span>@L["Loading"]</span>
            </div>
        </div>
    }
    else if (releaseInfo is null)
    {
        <div class="bearcat-release-info-list">
            <div class="bearcat-release-empty">
                <LucideIcon Name="database" class="h-5 w-5" />
                <span>@L["NoReleaseInfoYet"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="bearcat-release-info-list">
            <article class="bearcat-release-info-item">
                <div class="bearcat-release-info-layout">
                    @if (!string.IsNullOrWhiteSpace(releaseInfo.CoverUrl))
                    {
                        <a href="@releaseInfo.CoverUrl"
                           target="_blank"
                           rel="noreferrer noopener"
                           title="@L["OpenCoverInNewTab"]">
                            <img src="@releaseInfo.CoverUrl"
                                 alt="@releaseInfo.ReleaseName"
                                 class="bearcat-series-cover" />
                        </a>
                    }

                    <div class="bearcat-release-info-content">
                        <div class="min-w-0 space-y-2">
                            <div class="bearcat-release-info-source-row">
                                <span class="bearcat-release-info-source">
                                    <LucideIcon Name="database" class="h-3.5 w-3.5" />
                                    @GetDatabaseDisplayName(releaseInfo.NfoDatabaseClassName)
                                </span>
                                @if (!string.IsNullOrWhiteSpace(releaseInfo.ReleaseDatabaseUrl))
                                {
                                    <a class="bearcat-release-info-source-link"
                                       href="@releaseInfo.ReleaseDatabaseUrl"
                                       target="_blank"
                                       rel="noreferrer noopener"
                                       title="@releaseInfo.ReleaseDatabaseUrl"
                                       aria-label="@L["OpenReleaseDatabase"]">
                                        <LucideIcon Name="external-link" class="h-3.5 w-3.5" />
                                    </a>
                                }
                                @if (releaseInfo.ReleaseInfoId is not null)
                                {
                                    <button type="button"
                                            class="bearcat-release-info-source-link bearcat-release-info-delete-button"
                                            title="@L["DeleteReleaseInfo"]"
                                            aria-label="@L["DeleteReleaseInfo"]"
                                            @onclick="@(async () => await DeleteReleaseInfoAsync(releaseInfo))">
                                        <LucideIcon Name="trash-2" class="h-3.5 w-3.5" />
                                    </button>
                                }
                            </div>

                            <h3 class="bearcat-release-info-title" title="@releaseInfo.ReleaseName">
                                @releaseInfo.ReleaseName
                            </h3>
                        </div>

                        <dl class="bearcat-release-info-facts">
                            <div class="bearcat-release-info-fact">
                                <dt>
                                    <LucideIcon Name="hard-drive" class="h-3.5 w-3.5" />
                                    @L["Size"]
                                </dt>
                                <dd>@GetSizeLabel(releaseInfo)</dd>
                            </div>

                            <div class="bearcat-release-info-fact">
                                <dt>
                                    <LucideIcon Name="video" class="h-3.5 w-3.5" />
                                    @L["VideoType"]
                                </dt>
                                <dd>@GetValueOrDash(releaseInfo.VideoType)</dd>
                            </div>

                            <div class="bearcat-release-info-fact">
                                <dt>
                                    <LucideIcon Name="volume-2" class="h-3.5 w-3.5" />
                                    @L["AudioType"]
                                </dt>
                                <dd>@GetValueOrDash(releaseInfo.AudioType)</dd>
                            </div>

                            <div class="bearcat-release-info-fact">
                                <dt>
                                    <LucideIcon Name="tags" class="h-3.5 w-3.5" />
                                    @L["Genre"]
                                </dt>
                                <dd>@GetValueOrDash(releaseInfo.Genre)</dd>
                            </div>

                            <div class="bearcat-release-info-fact">
                                <dt>
                                    <LucideIcon Name="file-text" class="h-3.5 w-3.5" />
                                    NFO
                                </dt>
                                <dd>@GetNfoFileName()</dd>
                            </div>
                        </dl>

                    @if (!string.IsNullOrWhiteSpace(releaseInfo.Description))
                    {
                        <div class="bearcat-release-info-description">
                            <div class="bearcat-release-info-external-heading">
                                <LucideIcon Name="align-left" class="h-3.5 w-3.5" />
                                <span>@L["Description"]</span>
                            </div>
                            <p>@releaseInfo.Description</p>
                        </div>
                    }

                    <div class="bearcat-release-info-external">
                        <div class="bearcat-release-info-external-heading">
                            <LucideIcon Name="link" class="h-3.5 w-3.5" />
                            <span>@L["ExternalInfos"]</span>
                        </div>

                        @if (releaseInfo.ExternalInfos.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">@L["NoExternalInfos"]</p>
                        }
                        else
                        {
                            <div class="bearcat-release-info-external-list">
                                @foreach (var externalInfo in releaseInfo.ExternalInfos)
                                {
                                    <div class="bearcat-release-info-external-row">
                                        <div class="bearcat-release-info-external-main">
                                            <BbBadge Variant="BadgeVariant.Secondary">
                                                @LocalizeExternalInfoType(externalInfo.Type)
                                            </BbBadge>
                                            <span class="bearcat-release-info-external-title" title="@externalInfo.Title">
                                                @(externalInfo.Title ?? "-")
                                            </span>
                                        </div>

                                        @if (externalInfo.Urls.Count == 0)
                                        {
                                            <p class="text-sm text-muted-foreground">@L["NoUrls"]</p>
                                        }
                                        else
                                        {
                                            <div class="bearcat-release-info-url-list">
                                                @foreach (var url in externalInfo.Urls)
                                                {
                                                    <a class="bearcat-release-info-url"
                                                       href="@url.Url"
                                                       target="_blank"
                                                       rel="noreferrer noopener"
                                                       title="@url.Url"
                                                       aria-label="@L["OpenExternalUrl"]">
                                                        <span>@GetUrlLabel(url)</span>
                                                        <LucideIcon Name="external-link" class="h-3.5 w-3.5" />
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    </div>
                </div>
            </article>
        </div>
    }

    @if (!isLoading)
    {
        <MediaFilesSection MediaFiles="mediaFiles" />
    }
</section>
