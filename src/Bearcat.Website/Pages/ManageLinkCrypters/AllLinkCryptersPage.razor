@page "/link-crypter-registrations"
@inherits OwningComponentBase

<PageTitle>@L["LinkCrypterRegistrations"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["LinkCrypterRegistrations"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["LinkCrypterRegistrationsIntro"]
            </p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewLinkCrypter"]
        </BbButton>
    </div>

    <BbDataTable TData="LinkCrypterRegistrationReadModel"
                 Data="crypters"
                 ShowToolbar="false"
                 ShowPagination="@(crypters.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["LinkCrypterRegistrations"]"
                 Class="bearcat-data-table bearcat-registrations-table">
        <Columns>
            <BbDataTableColumn TData="LinkCrypterRegistrationReadModel" TValue="string"
                               Header="@L["Name"]"
                               Property="@(crypter => crypter.Name)"
                               Sortable="true"
                               Filterable="true"
                               Width="20%" />
            <BbDataTableColumn TData="LinkCrypterRegistrationReadModel" TValue="string"
                               Header="@L["Crypter"]"
                               Property="@(crypter => crypter.CrypterName)"
                               Sortable="true"
                               Filterable="true"
                               Width="16%" />
            <BbDataTableColumn TData="LinkCrypterRegistrationReadModel" TValue="bool"
                               Header="@L["Active"]"
                               Property="@(crypter => crypter.IsActive)"
                               Sortable="true"
                               Width="110px">
                <CellTemplate Context="crypter">
                    <BbBadge Variant="@(crypter.IsActive ? BadgeVariant.Default : BadgeVariant.Outline)">
                        @(crypter.IsActive ? L["Active"] : L["Inactive"])
                    </BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="LinkCrypterRegistrationReadModel" TValue="string"
                               Header="@L["Login"]"
                               Property="@(crypter => crypter.Name)"
                               Width="120px">
                <CellTemplate Context="crypter">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => TryLoginAsync(crypter))">
                        @L["TryLogin"]
                    </BbButton>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="LinkCrypterRegistrationReadModel" TValue="string"
                               Header=""
                               Property="@(crypter => crypter.Name)"
                               Width="56px">
                <CellTemplate Context="crypter">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenLinkCrypterActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End" Strategy="PositioningStrategy.Fixed">
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(crypter))">
                                    @L["EditRegistration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ToggleIsActiveAsync(crypter))">
                                    @(crypter.IsActive ? L["Disable"] : L["Enable"])
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(crypter))">
                                    @L["DeleteRegistration"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
