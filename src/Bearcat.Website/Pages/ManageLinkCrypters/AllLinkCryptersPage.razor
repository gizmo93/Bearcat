@page "/link-crypter-registrations"
@using Bearcat.Domain.UseCases.ManageLinkCrypters.Dto
@using Bearcat.Website.Shared
@inherits OwningComponentBase

<PageTitle>@L["LinkCrypterRegistrations"] - Bearcat</PageTitle>

<section class="space-y-4">
    <div class="bearcat-page-header">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["LinkCrypterRegistrations"]</h1>
            <p class="text-sm text-muted-foreground">
                @L["LinkCrypterRegistrationsIntro"]
            </p>
        </div>

        <BbButton Class="bearcat-page-action bearcat-add-button" OnClick="ShowAddDialogAsync">
            <LucideIcon Name="plus" class="h-4 w-4" />
            @L["NewLinkCrypter"]
        </BbButton>
    </div>

    <BbDataTable TData="LinkCrypterRegistrationDto"
                 Data="crypters"
                 ShowToolbar="false"
                 ShowPagination="@(crypters.Count > 10)"
                 InitialPageSize="10"
                 AriaLabel="@L["LinkCrypterRegistrations"]"
                 Class="bearcat-data-table bearcat-registrations-table">
        <Columns>
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="string"
                               Header="@L["Name"]"
                               Property="@(crypter => crypter.Name)"
                               Sortable="true"
                               Filterable="true"
                               Width="20%" />
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="string"
                               Header="@L["Crypter"]"
                               Property="@(crypter => crypter.CrypterName)"
                               Sortable="true"
                               Filterable="true"
                               Width="16%" />
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="bool"
                               Header="@L["Active"]"
                               Property="@(crypter => crypter.IsActive)"
                               Sortable="true"
                               Width="110px">
                <CellTemplate Context="crypter">
                    <BbBadge Variant="@(crypter.IsActive ? BadgeVariant.Default : BadgeVariant.Outline)">
                        @(crypter.IsActive ? L["Active"] : L["Inactive"])
                    </BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="string"
                               Header="@L["Configuration"]"
                               Property="@(crypter => crypter.Name)"
                               MinWidth="280px">
                <CellTemplate Context="crypter">
                    @{
                        var previewKeys = crypter.Configuration.Keys.OrderBy(key => key).Take(2).ToList();
                        var extraCount = Math.Max(0, crypter.Configuration.Count - previewKeys.Count);
                    }
                    <BbCollapsible Class="bearcat-registration-config">
                        <div class="bearcat-registration-config-summary">
                            <div class="min-w-0">
                                <p class="text-sm font-medium">@L["FieldCount", crypter.Configuration.Count]</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @string.Join(", ", previewKeys)@(extraCount > 0 ? $" +{extraCount}" : string.Empty)
                                </p>
                            </div>
                            <BbCollapsibleTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["ToggleConfigurationDetails"]">
                                    <LucideIcon Name="chevrons-up-down" class="h-4 w-4" />
                                </BbButton>
                            </BbCollapsibleTrigger>
                        </div>
                        <BbCollapsibleContent>
                            <div class="bearcat-registration-config-details">
                                @foreach (var config in crypter.Configuration.OrderBy(config => config.Key))
                                {
                                    <div class="bearcat-registration-config-row">
                                        <p class="text-xs font-medium text-muted-foreground">@config.Key</p>
                                        @if (string.Equals(config.Key, "password", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <HiddenElement>
                                                <span class="text-sm">@config.Value</span>
                                            </HiddenElement>
                                        }
                                        else
                                        {
                                            <span class="truncate text-sm" title="@config.Value">@config.Value</span>
                                        }
                                    </div>
                                }
                            </div>
                        </BbCollapsibleContent>
                    </BbCollapsible>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="string"
                               Header="@L["Login"]"
                               Property="@(crypter => crypter.Name)"
                               Width="120px">
                <CellTemplate Context="crypter">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => TryLoginAsync(crypter))">
                        @L["TryLogin"]
                    </BbButton>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="LinkCrypterRegistrationDto" TValue="string"
                               Header=""
                               Property="@(crypter => crypter.Name)"
                               Width="56px">
                <CellTemplate Context="crypter">
                    <div class="flex justify-end">
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@L["OpenLinkCrypterActions"]">
                                    <LucideIcon Name="ellipsis" class="h-4 w-4" />
                                </BbButton>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Align="PopoverAlign.End">
                                <BbDropdownMenuItem OnClick="@(async _ => await ShowEditDialogAsync(crypter))">
                                    @L["EditRegistration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await ToggleIsActiveAsync(crypter))">
                                    @(crypter.IsActive ? L["Disable"] : L["Enable"]) @L["Registration"]
                                </BbDropdownMenuItem>
                                <BbDropdownMenuItem OnClick="@(async _ => await DeleteAsync(crypter))">
                                    @L["DeleteRegistration"]
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</section>
