@page "/archives/change-part-size"

<PageTitle>@L["ChangeArchivePartSize"] - Bearcat</PageTitle>

@if (partSizeChoices is null)
{
    return;
}

<section class="space-y-8">
    <div class="bearcat-page-header">
        <h1 class="text-3xl font-semibold tracking-tight">@L["ChangeArchivePartSize"]</h1>
    </div>

    <div class="flex items-start gap-2 rounded-md border border-border/70 bg-muted/30 px-3 py-2 text-sm text-muted-foreground">
        <LucideIcon Name="info" class="mt-0.5 h-4 w-4 shrink-0" />
        @L["ChangeArchivePartSizeOnlyFuturePacking"]
    </div>

    @if (partSizeChoices.Count == 0)
    {
        <div class="rounded-lg border border-dashed border-border/70 px-4 py-8 text-sm text-muted-foreground">
            @L["ChangeArchivePartSizeNoChoices"]
        </div>
    }
    else
    {
        <div class="max-w-md space-y-4">
            <BbFormFieldSelect TValue="int?"
                               Value="currentArchiveFileSizeMb"
                               ValueChanged="SetCurrentArchiveFileSizeAsync"
                               Label="@L["ChangeArchivePartSizeCurrent"]"
                               Placeholder="@L["ChangeArchivePartSizeSelectCurrent"]"
                               Options="PartSizeChoiceOptions" />

            <BbFormFieldNumericInput TValue="int"
                                     Value="newArchiveFileSizeMb"
                                     ValueChanged="SetNewArchiveFileSizeAsync"
                                     Label="@L["ChangeArchivePartSizeNew"]"
                                     Min="1"
                                     Step="1"
                                     AllowNegative="false"
                                     ErrorText="@NewArchiveFileSizeErrorText" />

            <BbFormFieldSwitch Checked="includeArchiveConfigTemplates"
                               CheckedChanged="SetIncludeArchiveConfigTemplatesAsync"
                               Label="@L["ChangeArchivePartSizeIncludeTemplates"]"
                               HelperText="@L["ChangeArchivePartSizeIncludeTemplatesDescription"]" />
        </div>
    }

    @if (HasValidInputs)
    {
        <div class="space-y-3">
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-semibold">@L["Preview"]</h2>
                @if (isLoadingPreview)
                {
                    <LucideIcon Name="loader-circle" class="h-4 w-4 animate-spin text-muted-foreground" />
                }
            </div>

            @if (preview is not null)
            {
                <div class="space-y-4">
                    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <div class="rounded-md border border-border/70 px-3 py-2">
                            <dt class="text-xs text-muted-foreground">@L["ChangeArchivePartSizeArchiveConfigsToChange"]</dt>
                            <dd class="text-2xl font-semibold tabular-nums">@preview.ArchiveConfigCountToChange</dd>
                        </div>
                        @if (includeArchiveConfigTemplates)
                        {
                            <div class="rounded-md border border-border/70 px-3 py-2">
                                <dt class="text-xs text-muted-foreground">@L["ChangeArchivePartSizeArchiveConfigsInTemplatesToChange"]</dt>
                                <dd class="text-2xl font-semibold tabular-nums">@preview.ArchiveConfigTemplateCountToChange</dd>
                            </div>
                        }
                    </dl>

                    @if (preview.SkippedArchiveConfigs.Count > 0)
                    {
                        <SkippedArchiveConfigList ArchiveConfigs="preview.SkippedArchiveConfigs" />
                    }

                    @if (preview.SkippedArchiveConfigTemplates.Count > 0)
                    {
                        <SkippedArchiveConfigTemplateList ArchiveConfigTemplates="preview.SkippedArchiveConfigTemplates" />
                    }
                </div>
            }

            <div class="flex justify-end">
                <BbButton Disabled="!CanApply" OnClick="ApplyAsync">
                    @if (isApplying)
                    {
                        <LucideIcon Name="loader-circle" class="h-4 w-4 animate-spin" />
                    }
                    else
                    {
                        <LucideIcon Name="scaling" class="h-4 w-4" />
                    }
                    @L["ChangeArchivePartSize"]
                </BbButton>
            </div>
        </div>
    }
</section>
