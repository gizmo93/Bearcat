<div class="space-y-2">
    <h3 class="flex items-center gap-2 text-sm font-semibold text-destructive">
        <LucideIcon Name="triangle-alert" class="h-4 w-4 shrink-0" />
        @L["ChangeArchivePartSizeSkippedArchiveConfigs", ArchiveConfigs.Count]
    </h3>
    <div class="bearcat-config-list">
        <div class="@($"bearcat-config-header {RowGridClass}")">
            <span>@L["Release"]</span>
            <span>@L["ArchiveConfiguration"]</span>
            <span>@L["ChangeArchivePartSizeSkipReasonHeading"]</span>
        </div>
        @foreach (var archiveConfig in ArchiveConfigs)
        {
            <div class="bearcat-config-item" @key="archiveConfig.ArchiveConfigId">
                <div class="@($"bearcat-config-row {RowGridClass}")">
                    <div class="min-w-0">
                        <a class="block truncate text-sm text-primary hover:underline"
                           href="@($"/releases/{archiveConfig.ReleaseId}")"
                           title="@archiveConfig.ReleaseName">@archiveConfig.ReleaseName</a>
                    </div>
                    <div class="min-w-0">
                        <p class="bearcat-mobile-label">@L["ArchiveConfiguration"]</p>
                        <p class="truncate text-sm" title="@archiveConfig.ArchiveConfigName">@archiveConfig.ArchiveConfigName</p>
                    </div>
                    <div class="min-w-0">
                        <p class="bearcat-mobile-label">@L["ChangeArchivePartSizeSkipReasonHeading"]</p>
                        <p class="text-sm text-muted-foreground">@L["ChangeArchivePartSizeSkipReason", archiveConfig.HosterName, archiveConfig.MaxArchiveFileSize]</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
