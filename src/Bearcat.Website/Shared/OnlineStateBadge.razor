@using Bearcat.Website.Formatting
@using TimeProvider = Bearcat.Domain.Shared.TimeProvider
@inject TimeProvider TimeProvider

@if (Value is not null)
{
    @if (ShowNotFullyOnlineSince)
    {
        <BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
            <BbTooltipTrigger AsChild="false" Class="inline-flex">
                @Badge
            </BbTooltipTrigger>
            <BbTooltipContent Class="max-w-xs text-xs">
                <p class="font-medium">@L["NotFullyOnlineSince"]</p>
                <p>@TimeProvider.Humanize(NotFullyOnlineSince!.Value) (@NotFullyOnlineSince.Value.ToString("g"))</p>
            </BbTooltipContent>
        </BbTooltip>
    }
    else
    {
        @Badge
    }
}

@code {
    [Parameter]
    [EditorRequired]
    public OnlineState? Value { get; set; }

    [Parameter]
    public DateTime? NotFullyOnlineSince { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private bool ShowNotFullyOnlineSince =>
        NotFullyOnlineSince is not null
        && Value is OnlineState.PartiallyOnline or OnlineState.Offline;

    private BadgeVariant variant => Value switch
    {
        OnlineState.Online => BadgeVariant.Default,
        OnlineState.PartiallyOnline => BadgeVariant.Secondary,
        OnlineState.Offline => BadgeVariant.Destructive,
        _ => BadgeVariant.Outline
    };

    private RenderFragment Badge => @<BbBadge Variant="@variant" Class="@Class">@L.Localize(Value!.Value)</BbBadge>;
}
