<div class="bearcat-folder-dialog">
    @if (isInitializing)
    {
        <div class="bearcat-folder-tree flex items-center gap-2 text-sm text-muted-foreground">
            <LucideIcon Name="loader-circle" class="h-4 w-4 animate-spin" />
            @L["Loading"]
        </div>
    }
    else
    {
        <BbTreeView TItem="FolderSelectionNode"
                    Items="rootNodes"
                    TextField="@(node => node.Name)"
                    ValueField="@(node => node.Path)"
                    ChildrenProperty="@(node => node.Children)"
                    HasChildrenField="@(node => node.HasChildren)"
                    IconField='@(node => node.IsFile ? "file" : "folder")'
                    SelectionMode="TreeSelectionMode.Single"
                    @bind-SelectedValue="selectedItem"
                    @bind-ExpandedValues="expandedItems"
                    OnLoadChildren="LoadChildrenForTreeAsync"
                    ShowSearch="true"
                    SearchPlaceholder="@(IncludeFiles ? L["SearchFoldersAndFiles"] : L["SearchFolders"])"
                    AriaLabel="@L["FolderSelectionTree"]"
                    Class="bearcat-folder-tree" />
    }

    @if (loadErrorMessage is not null)
    {
        <p class="text-sm text-destructive">@L["FolderListingFailed", loadErrorMessage]</p>
    }

    @if (!string.IsNullOrWhiteSpace(selectedItem))
    {
        <div class="shrink-0 rounded-lg border border-border/70 bg-muted/30 px-3 py-2 text-sm">
            <span class="text-muted-foreground">@L["Selected"]:</span>
            <span class="ml-2 break-all font-medium">@selectedItem</span>
        </div>
    }

    <div class="bearcat-folder-dialog-footer">
        <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
            @L["Cancel"]
        </BbButton>
        <BbButton Disabled="@string.IsNullOrWhiteSpace(selectedItem)" OnClick="SaveAsync">
            @L["Save"]
        </BbButton>
    </div>
</div>
