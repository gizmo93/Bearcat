<div class="bearcat-folder-dialog">
    <div class="shrink-0">
        <BbFormFieldInput TValue="string"
                          @bind-Value="searchText"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchFolders"]"
                          HelperText="@L["FilterLoadedFolderTree"]" />
    </div>

    <div class="bearcat-folder-tree">
        <div class="bearcat-folder-tree-list" role="tree" aria-label="@L["FolderSelectionTree"]">
            @foreach (var node in filteredRootNodes)
            {
                <FolderSelectionTreeNode Node="node"
                                         Depth="0"
                                         SelectedPath="@selectedItem"
                                         ExpandedItems="expandedItems"
                                         OnSelect="SelectFolderAsync"
                                         OnToggle="ToggleFolderAsync" />
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(selectedItem))
    {
        <div class="shrink-0 rounded-lg border border-border/70 bg-muted/30 px-3 py-2 text-sm">
            <span class="text-muted-foreground">@L["Selected"]:</span>
            <span class="ml-2 break-all font-medium">@selectedItem</span>
        </div>
    }

    <div class="bearcat-folder-dialog-footer">
        <BbButton Variant="ButtonVariant.Outline" OnClick="CancelAsync">
            @L["Cancel"]
        </BbButton>
        <BbButton Disabled="@string.IsNullOrWhiteSpace(selectedItem)" OnClick="SaveAsync">
            @L["Save"]
        </BbButton>
    </div>
</div>
