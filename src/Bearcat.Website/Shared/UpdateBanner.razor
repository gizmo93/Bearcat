@if (status is { IsUpdateAvailable: true })
{
    <a href="@status.ReleaseUrl"
       target="_blank"
       rel="noopener noreferrer"
       class="inline-flex items-center no-underline"
       title="@L["UpdateAvailableTooltip", status.LatestVersion ?? string.Empty]">
        <BbBadge Variant="BadgeVariant.Outline" Class="gap-1.5 whitespace-nowrap px-1.5 font-normal text-muted-foreground hover:text-foreground lg:px-2.5">
            <LucideIcon Name="download" class="h-3.5 w-3.5" />
            <span class="max-lg:hidden">@L["UpdateAvailable", status.LatestVersion ?? string.Empty]</span>
        </BbBadge>
    </a>
}
