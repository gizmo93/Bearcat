@if (TotalPages > 1)
{
    <BbPagination Class="flex justify-start">
        <BbPaginationContent>
            <BbPaginationItem>
                <BbPaginationPrevious Disabled="@(CurrentPage <= 1)"
                                      Text="@L["Previous"]"
                                      Href="@(CurrentPage > 1 ? GetPageUrlOrNull(CurrentPage - 1) : null)"
                                      OnClick="@(() => SelectPageAsync(CurrentPage - 1))" />
            </BbPaginationItem>

            @foreach (var pageLink in PageLinksWithGaps)
            {
                <BbPaginationItem>
                    @if (pageLink.PageNumber is { } pageNumber)
                    {
                        <BbPaginationLink IsActive="@(pageNumber == CurrentPage)"
                                          Href="@GetPageUrlOrNull(pageNumber)"
                                          OnClick="@(() => SelectPageAsync(pageNumber))">
                            @pageNumber
                        </BbPaginationLink>
                    }
                    else
                    {
                        <BbPaginationEllipsis />
                    }
                </BbPaginationItem>
            }

            <BbPaginationItem>
                <BbPaginationNext Disabled="@(CurrentPage >= TotalPages)"
                                  Text="@L["Next"]"
                                  Href="@(CurrentPage < TotalPages ? GetPageUrlOrNull(CurrentPage + 1) : null)"
                                  OnClick="@(() => SelectPageAsync(CurrentPage + 1))" />
            </BbPaginationItem>
        </BbPaginationContent>
    </BbPagination>
}
