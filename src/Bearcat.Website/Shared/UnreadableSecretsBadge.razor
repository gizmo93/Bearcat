<BbTooltip Placement="PopoverPlacement.BottomStart" DelayDuration="150">
    <BbTooltipTrigger Class="inline-flex">
        <BbBadge Variant="BadgeVariant.Destructive"
                 Class="px-1.5"
                 role="img"
                 aria-label="@L["CredentialsMustBeEnteredAgain"]">
            <LucideIcon Name="key-round" class="h-3.5 w-3.5" />
        </BbBadge>
    </BbTooltipTrigger>
    <BbTooltipContent Class="max-w-xs text-xs">
        <p class="font-medium">@L["CredentialsMustBeEnteredAgain"]</p>
        <p>@L["UnreadableSecretsBadgeHint"]</p>
    </BbTooltipContent>
</BbTooltip>
