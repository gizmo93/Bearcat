@using Bearcat.Domain.UseCases.ManageUploadConfigs.Dto
@using Bearcat.Domain.ValueObjects

@{
    var hosterRegistrations = Choices.GetSelectableHosterRegistrations(Value, UploadSource);
    var hosterAccountPools = Choices.GetSelectableHosterAccountPools(UploadSource);
}

<BbFormFieldSelect TValue="UploadTarget"
                   Value="Value"
                   ValueChanged="ValueChanged"
                   ValueExpression="ValueExpression"
                   Label="@L["UploadTarget"]"
                   Placeholder="@L["SelectUploadTarget"]"
                   DisplayTextSelector="Choices.GetName">
    @if (hosterRegistrations.Count > 0)
    {
        <BbSelectGroup>
            <BbSelectLabel>@L["UploadTargetHosterAccounts"]</BbSelectLabel>
            @foreach (var hosterRegistration in hosterRegistrations)
            {
                <BbSelectItem Value="UploadTarget.ForHosterRegistration(hosterRegistration.Id)"
                              Text="@hosterRegistration.Name" />
            }
        </BbSelectGroup>
    }
    @if (hosterAccountPools.Count > 0)
    {
        <BbSelectGroup>
            <BbSelectLabel>@L["HosterAccountPools"]</BbSelectLabel>
            @foreach (var hosterAccountPool in hosterAccountPools)
            {
                <BbSelectItem Value="UploadTarget.ForHosterAccountPool(hosterAccountPool.Id)"
                              Text="@hosterAccountPool.Name">
                    @if (UploadTargetChoices.HasActiveMember(hosterAccountPool))
                    {
                        @hosterAccountPool.Name
                    }
                    else
                    {
                        @L["HosterAccountPoolWithoutActiveAccounts", hosterAccountPool.Name]
                    }
                </BbSelectItem>
            }
        </BbSelectGroup>
    }
</BbFormFieldSelect>

@if (hosterRegistrations.Count == 0 && hosterAccountPools.Count == 0)
{
    <p class="text-xs text-muted-foreground">
        @(UploadSource is UploadSource.VideoFiles ? L["NoVideoHosterAccountsYet"] : L["NoHosterAccountsYet"])
    </p>
}
