@inject IJSRuntime JS

<div class="bearcat-code-editor @Class" style="@HeightStyle">
    <pre @ref="gutterRef" class="bearcat-code-editor-gutter" aria-hidden="true">1</pre>
    <textarea @ref="textareaRef"
              class="bearcat-code-editor-input"
              spellcheck="false"
              placeholder="@Placeholder"
              @bind:get="Value"
              @bind:set="SetValueAsync"
              @bind:event="oninput"></textarea>
    <div @ref="mirrorRef" class="bearcat-code-editor-mirror" aria-hidden="true"></div>
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public int? VisibleLineCount { get; set; }

    [Parameter]
    public string? CursorPositionTargetId { get; set; }

    [Parameter]
    public string? CursorPositionFormat { get; set; }

    [Parameter]
    public IReadOnlyList<int>? ErrorLineNumbers { get; set; }

    private string? HeightStyle =>
        VisibleLineCount is { } lineCount
            ? $"height: calc({lineCount} * 1.25rem + 1rem + 2px);"
            : null;

    private ElementReference textareaRef;
    private ElementReference gutterRef;
    private ElementReference mirrorRef;
    private bool attached;
    private string? lastValue;
    private IReadOnlyList<int> lastErrorLineNumbers = [];

    private IReadOnlyList<int> CurrentErrorLineNumbers => ErrorLineNumbers ?? [];

    public async Task FocusPositionAsync(int line, int column)
    {
        await JS.InvokeVoidAsync(
            "bearcat.lineNumberedTextarea.focusPosition",
            textareaRef,
            line,
            column
        );
    }

    private async Task SetValueAsync(string? value)
    {
        Value = value;
        lastValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync(
                "bearcat.lineNumberedTextarea.attach",
                textareaRef,
                gutterRef,
                mirrorRef,
                CursorPositionTargetId,
                CursorPositionFormat,
                CurrentErrorLineNumbers
            );
            attached = true;
            lastValue = Value;
            lastErrorLineNumbers = CurrentErrorLineNumbers;
            return;
        }

        if (attached && !string.Equals(lastValue, Value, StringComparison.Ordinal))
        {
            lastValue = Value;
            await JS.InvokeVoidAsync("bearcat.lineNumberedTextarea.refresh", textareaRef);
        }

        if (attached && !lastErrorLineNumbers.SequenceEqual(CurrentErrorLineNumbers))
        {
            lastErrorLineNumbers = CurrentErrorLineNumbers;
            await JS.InvokeVoidAsync(
                "bearcat.lineNumberedTextarea.setErrorLines",
                textareaRef,
                CurrentErrorLineNumbers
            );
        }
    }
}
