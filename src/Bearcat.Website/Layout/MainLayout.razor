@inherits LayoutComponentBase
@using Bearcat.Abstractions.Updates
@using Bearcat.Website.Layout.Navigation
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IUpdateChecker UpdateChecker

<BbSidebarProvider DefaultOpen="true" Variant="SidebarVariant.Inset">
    <BbSidebar Class="bearcat-sidebar border-r border-border/70 bg-sidebar text-sidebar-foreground">
        <BbSidebarHeader>
            <BbSidebarHeaderContent>
                <div class="flex h-12 w-12 shrink-0 items-center justify-center">
                    <img src="_content/Bearcat.Website/bearcat.png" alt="Bearcat" class="h-12 w-12 object-contain" />
                </div>
                <BbSidebarHeaderInfo>
                    <span class="truncate text-sm font-semibold">Bearcat</span>
                    <span class="truncate text-xs text-muted-foreground">@($"v{UpdateChecker.CurrentVersion}")</span>
                </BbSidebarHeaderInfo>
            </BbSidebarHeaderContent>
        </BbSidebarHeader>

        <BbSidebarContent>
            <NavMenu />
        </BbSidebarContent>

        <BbSidebarFooter Class="mt-auto">
            <div class="flex justify-center px-2 pb-3">
                <CultureSelector />
            </div>
        </BbSidebarFooter>
    </BbSidebar>

    <BbSidebarInset Class="min-w-0 min-h-screen bg-background">
        <header class="bearcat-app-header sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-border/70 px-4 md:grid md:grid-cols-[1fr_auto_1fr]">
            <div class="flex min-w-0 flex-1 items-center gap-3">
                <BbSidebarTrigger />
                <p class="truncate text-sm font-medium">@CurrentPageTitle</p>
            </div>
            <div class="flex shrink-0 justify-center">
                <NavigationCommandPalette />
            </div>
            <div class="flex shrink-0 items-center justify-end gap-3">
                <UpdateBanner />
                <QualityIssuesIndicator />
                <PostQueueIndicator />
                <NotificationBell />
            </div>
        </header>

        <main class="bearcat-main p-4 md:p-6" data-bearcat-route-focus>
            <BbTooltipProvider DelayDuration="150" SkipDelayDuration="300">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <div class="rounded-lg border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                            @context?.Message
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </BbTooltipProvider>
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

<BbToastProvider Position="ToastPosition.BottomRight" ShowCountdown="true" />
<BbDialogProvider />
<BbPortalHost />

<div id="blazor-error-ui" data-nosnippet>
    @L["UnhandledError"]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">x</span>
</div>

@code {
    private string CurrentPageTitle => GetPageTitle();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetPageTitle()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

        return path switch
        {
            "" => L["Home"],
            "dashboard" => L["Dashboard"],
            "hoster-registrations" => L["HosterRegistrations"],
            "remote-sources" => L["RemoteSources"],
            "remote-source-automations" => L["RemoteSourceAutomations"],
            "remote-source-downloads" => L["RemoteSourceDownloads"],
            "link-crypter-registrations" => L["CrypterRegistrations"],
            "image-hoster-registrations" => L["ImageHosterRegistrations"],
            "nfo-database-registrations" => L["NfoDatabaseRegistrations"],
            "media-database-registrations" => L["MediaDatabaseRegistrations"],
            "notifications" => L["Notifications"],
            var notification when notification.StartsWith("notifications/", StringComparison.OrdinalIgnoreCase) => L["NotificationDetails"],
            "releases" => L["Releases"],
            var release when release.StartsWith("releases/", StringComparison.OrdinalIgnoreCase) => L["ReleaseDetails"],
            "release-templates" => L["ReleaseTemplates"],
            var template when template.StartsWith("release-templates/", StringComparison.OrdinalIgnoreCase) => L["ReleaseTemplate"],
            "release-collections" => L["ReleaseCollections"],
            var collection when collection.StartsWith("release-collections/", StringComparison.OrdinalIgnoreCase) => L["ReleaseCollection"],
            "forum-post-templates" => L["ForumPostTemplates"],
            "release-folder-automations" => L["ReleaseFolderAutomations"],
            "configurations" => L["Configurations"],
            "background-tasks" => L["BackgroundTasks"],
            "release-groups" => L["ReleaseGroups"],
            "quality-issues" => L["QualityIssues"],
            "quality-profiles" => L["QualityProfiles"],
            _ => "Bearcat"
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
