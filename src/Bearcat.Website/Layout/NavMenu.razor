@using BlazorBlueprint.Primitives.Sheet
@implements IDisposable
@inject NavigationManager NavigationManager

<div @onclick="@((MouseEventArgs _) => CloseMobileSidebar())">
    <BbSidebarGroup>
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="@L["Home"]">
                        <LucideIcon Name="house" class="h-4 w-4" />
                        <span>@L["Home"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/dashboard" Match="NavLinkMatch.Prefix" Tooltip="@L["Dashboard"]">
                        <LucideIcon Name="chart-column-stacked" class="h-4 w-4" />
                        <span>@L["Dashboard"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/releases" Match="NavLinkMatch.Prefix" Tooltip="@L["Releases"]">
                        <LucideIcon Name="upload" class="h-4 w-4" />
                        <span>@L["Releases"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-templates" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseTemplates"]">
                        <LucideIcon Name="copy" class="h-4 w-4" />
                        <span>@L["ReleaseTemplates"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-collections" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseCollections"]">
                        <LucideIcon Name="boxes" class="h-4 w-4" />
                        <span>@L["ReleaseCollections"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/forum-post-templates" Match="NavLinkMatch.Prefix" Tooltip="@L["ForumPostTemplates"]">
                        <LucideIcon Name="message-square-text" class="h-4 w-4" />
                        <span>@L["ForumPostTemplates"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-groups" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseGroups"]">
                        <LucideIcon Name="layers" class="h-4 w-4" />
                        <span>@L["ReleaseGroups"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-folder-automations" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseFolderAutomations"]">
                        <LucideIcon Name="folder-cog" class="h-4 w-4" />
                        <span>@L["ReleaseFolderAutomations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/background-tasks" Match="NavLinkMatch.Prefix" Tooltip="@L["BackgroundTasks"]">
                        <LucideIcon Name="activity" class="h-4 w-4" />
                        <span>@L["BackgroundTasks"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>

    <BbSidebarGroup>
        <BbSidebarGroupLabel>@L["Registrations"]</BbSidebarGroupLabel>
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/hoster-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["Hosters"]">
                        <LucideIcon Name="key-round" class="h-4 w-4" />
                        <span>@L["HosterRegistrations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/link-crypter-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["Crypters"]">
                        <LucideIcon Name="shield" class="h-4 w-4" />
                        <span>@L["CrypterRegistrations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/image-hoster-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["ImageHosters"]">
                        <LucideIcon Name="image-up" class="h-4 w-4" />
                        <span>@L["ImageHosterRegistrations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/nfo-database-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["NfoDatabases"]">
                        <LucideIcon Name="database" class="h-4 w-4" />
                        <span>@L["NfoDatabaseRegistrations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/series-database-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["SeriesDatabases"]">
                        <LucideIcon Name="tv" class="h-4 w-4" />
                        <span>@L["SeriesDatabaseRegistrations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>

    <BbSidebarGroup>
        <BbSidebarGroupLabel>@L["Settings"]</BbSidebarGroupLabel>
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/configurations" Match="NavLinkMatch.Prefix" Tooltip="@L["Configurations"]">
                        <LucideIcon Name="settings" class="h-4 w-4" />
                        <span>@L["Configurations"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>
</div>

@code {
    [CascadingParameter]
    private SidebarContext? SidebarContext { get; set; }

    [CascadingParameter]
    private SheetContext? SheetContext { get; set; }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        CloseMobileSidebar();
    }

    private void CloseMobileSidebar()
    {
        SheetContext?.Close();
        SidebarContext?.SetOpenMobile(false);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
