@using Bearcat.Website.Layout.Navigation

<div>
    @foreach (var section in NavigationRegistry.Sections)
    {
        <BbSidebarGroup>
            @switch (section.HeadingKind)
            {
                case NavigationSectionHeadingKind.Collapsible:
                    <BbCollapsible Open="navState.IsOpen(section.Id)" OpenChanged="open => SetOpenAsync(section.Id, open)">
                        <BbCollapsibleTrigger AsChild="false" Class="w-full">
                            <div class="bearcat-nav-group-label">
                                <span>@L[section.HeadingLabelKey]</span>
                                <LucideIcon Name="chevron-down" class="@ChevronClass(navState.IsOpen(section.Id))" />
                            </div>
                        </BbCollapsibleTrigger>
                        <BbCollapsibleContent>
                            @RenderSectionItems(section)
                        </BbCollapsibleContent>
                    </BbCollapsible>
                    break;
                case NavigationSectionHeadingKind.Plain:
                    <div class="bearcat-nav-group-label">
                        <span>@L[section.HeadingLabelKey]</span>
                    </div>
                    @RenderSectionItems(section)
                    break;
                case NavigationSectionHeadingKind.HiddenInSidebar:
                    @RenderSectionItems(section)
                    break;
            }
        </BbSidebarGroup>
    }
</div>

@code {
    private RenderFragment RenderSectionItems(NavigationSection section) =>
        @<BbSidebarGroupContent>
            <BbSidebarMenu>
                @foreach (var item in section.Items)
                {
                    switch (item)
                    {
                        case NavigationEntry entry:
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="@entry.Href" Match="entry.Match" Tooltip="@L[entry.TooltipKey]">
                                    <LucideIcon Name="@entry.IconName" class="h-4 w-4" />
                                    <span>@L[entry.LabelKey]</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            break;
                        case NavigationSubmenu submenu:
                            <BbSidebarMenuItem>
                                <BbCollapsible Open="navState.IsOpen(submenu.Id)" OpenChanged="open => SetOpenAsync(submenu.Id, open)" Disabled="true">
                                    <BbSidebarMenuButton Tooltip="@L[submenu.LabelKey]" OnClick="() => ToggleSubmenuAsync(submenu)">
                                        <LucideIcon Name="@submenu.IconName" class="h-4 w-4" />
                                        <span>@L[submenu.LabelKey]</span>
                                        <BbSidebarMenuChevron>
                                            <LucideIcon Name="chevron-right" class="h-4 w-4" />
                                        </BbSidebarMenuChevron>
                                    </BbSidebarMenuButton>
                                    <BbCollapsibleContent>
                                        <BbSidebarMenuSub>
                                            @foreach (var entry in submenu.Entries)
                                            {
                                                <BbSidebarMenuSubItem>
                                                    <BbSidebarMenuSubButton Href="@entry.Href" Match="entry.Match">
                                                        <LucideIcon Name="@entry.IconName" class="h-4 w-4" />
                                                        <span>@L[entry.LabelKey]</span>
                                                    </BbSidebarMenuSubButton>
                                                </BbSidebarMenuSubItem>
                                            }
                                        </BbSidebarMenuSub>
                                    </BbCollapsibleContent>
                                </BbCollapsible>
                            </BbSidebarMenuItem>
                            break;
                    }
                }
            </BbSidebarMenu>
        </BbSidebarGroupContent>;
}
