@using BlazorBlueprint.Primitives.Sheet
@using Microsoft.AspNetCore.Http
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject PersistentComponentState ApplicationState
@inject IHttpContextAccessor HttpContextAccessor
@inject NavMenuState NavState

<div>
    <BbSidebarGroup>
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="@L["Home"]">
                        <LucideIcon Name="house" class="h-4 w-4" />
                        <span>@L["Home"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/dashboard" Match="NavLinkMatch.Prefix" Tooltip="@L["Dashboard"]">
                        <LucideIcon Name="chart-column-stacked" class="h-4 w-4" />
                        <span>@L["Dashboard"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/releases" Match="NavLinkMatch.Prefix" Tooltip="@L["Releases"]">
                        <LucideIcon Name="upload" class="h-4 w-4" />
                        <span>@L["Releases"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-templates" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseTemplates"]">
                        <LucideIcon Name="copy" class="h-4 w-4" />
                        <span>@L["ReleaseTemplates"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/release-collections" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseCollections"]">
                        <LucideIcon Name="boxes" class="h-4 w-4" />
                        <span>@L["ReleaseCollections"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href="/background-tasks" Match="NavLinkMatch.Prefix" Tooltip="@L["BackgroundTasks"]">
                        <LucideIcon Name="activity" class="h-4 w-4" />
                        <span>@L["BackgroundTasks"]</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>
    
        <BbSidebarGroup>
        <BbCollapsible Open="NavState.ConfigurationOpen" OpenChanged="SetConfigurationOpenAsync">
            <BbCollapsibleTrigger AsChild="false" Class="w-full">
                <div class="bearcat-nav-group-label">
                    <span>@L["Configuration"]</span>
                    <LucideIcon Name="chevron-down" class="@ChevronClass(NavState.ConfigurationOpen)" />
                </div>
            </BbCollapsibleTrigger>
            <BbCollapsibleContent>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/release-groups" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseGroups"]">
                                <LucideIcon Name="layers" class="h-4 w-4" />
                                <span>@L["ReleaseGroups"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/quality-profiles" Match="NavLinkMatch.Prefix" Tooltip="@L["QualityProfiles"]">
                                <LucideIcon Name="shield-check" class="h-4 w-4" />
                                <span>@L["QualityProfiles"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/forum-post-templates" Match="NavLinkMatch.Prefix" Tooltip="@L["ForumPostTemplates"]">
                                <LucideIcon Name="message-square-text" class="h-4 w-4" />
                                <span>@L["ForumPostTemplates"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/release-folder-automations" Match="NavLinkMatch.Prefix" Tooltip="@L["ReleaseFolderAutomations"]">
                                <LucideIcon Name="folder-cog" class="h-4 w-4" />
                                <span>@L["ReleaseFolderAutomations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/configurations" Match="NavLinkMatch.Prefix" Tooltip="@L["Configurations"]">
                                <LucideIcon Name="settings" class="h-4 w-4" />
                                <span>@L["Configurations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbCollapsibleContent>
        </BbCollapsible>
    </BbSidebarGroup>


    <BbSidebarGroup>
        <BbCollapsible Open="NavState.RegistrationsOpen" OpenChanged="SetRegistrationsOpenAsync">
            <BbCollapsibleTrigger AsChild="false" Class="w-full">
                <div class="bearcat-nav-group-label">
                    <span>@L["Registrations"]</span>
                    <LucideIcon Name="chevron-down" class="@ChevronClass(NavState.RegistrationsOpen)" />
                </div>
            </BbCollapsibleTrigger>
            <BbCollapsibleContent>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/hoster-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["Hosters"]">
                                <LucideIcon Name="key-round" class="h-4 w-4" />
                                <span>@L["HosterRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/link-crypter-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["Crypters"]">
                                <LucideIcon Name="shield" class="h-4 w-4" />
                                <span>@L["CrypterRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/image-hoster-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["ImageHosters"]">
                                <LucideIcon Name="image-up" class="h-4 w-4" />
                                <span>@L["ImageHosterRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/distribution-site-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["DistributionSites"]">
                                <LucideIcon Name="send" class="h-4 w-4" />
                                <span>@L["DistributionSiteRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/nfo-database-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["NfoDatabases"]">
                                <LucideIcon Name="database" class="h-4 w-4" />
                                <span>@L["NfoDatabaseRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/media-database-registrations" Match="NavLinkMatch.Prefix" Tooltip="@L["MediaDatabases"]">
                                <LucideIcon Name="tv" class="h-4 w-4" />
                                <span>@L["MediaDatabaseRegistrations"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbCollapsibleContent>
        </BbCollapsible>
    </BbSidebarGroup>
</div>

@code {
    [CascadingParameter]
    private SidebarContext? SidebarContext { get; set; }

    [CascadingParameter]
    private SheetContext? SheetContext { get; set; }

    private const string ConfigurationOpenKey = "bearcat.nav.configurationOpen";
    private const string RegistrationsOpenKey = "bearcat.nav.registrationsOpen";

    private PersistingComponentStateSubscription persistSubscription;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;

        persistSubscription = ApplicationState.RegisterOnPersisting(PersistGroupState);

        if (NavState.Initialized)
        {
            return;
        }

        NavState.ConfigurationOpen = RestoreGroupState(ConfigurationOpenKey) ?? NavState.ConfigurationOpen;
        NavState.RegistrationsOpen = RestoreGroupState(RegistrationsOpenKey) ?? NavState.RegistrationsOpen;
        NavState.Initialized = true;
    }

    private bool? RestoreGroupState(string key)
    {
        if (ApplicationState.TryTakeFromJson<bool>(key, out var persisted))
        {
            return persisted;
        }

        return HttpContextAccessor.HttpContext?.Request.Cookies.TryGetValue(key, out var cookie) == true
            ? cookie == "true"
            : null;
    }

    private Task PersistGroupState()
    {
        ApplicationState.PersistAsJson(ConfigurationOpenKey, NavState.ConfigurationOpen);
        ApplicationState.PersistAsJson(RegistrationsOpenKey, NavState.RegistrationsOpen);

        return Task.CompletedTask;
    }

    private async Task SetConfigurationOpenAsync(bool open)
    {
        NavState.ConfigurationOpen = open;
        await PersistCookieAsync(ConfigurationOpenKey, open);
    }

    private async Task SetRegistrationsOpenAsync(bool open)
    {
        NavState.RegistrationsOpen = open;
        await PersistCookieAsync(RegistrationsOpenKey, open);
    }

    private async Task PersistCookieAsync(string key, bool open)
    {
        try
        {
            await JS.InvokeVoidAsync("bearcat.setCookie", key, open ? "true" : "false");
        }
        catch (JSException)
        {
            // Ignore cookie failures; the menu still works for this session.
        }
    }

    private static string ChevronClass(bool open) =>
        $"h-4 w-4 shrink-0 transition-transform {(open ? "rotate-180" : string.Empty)}";

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        CloseMobileSidebar();
    }

    private void CloseMobileSidebar()
    {
        SheetContext?.Close();
        SidebarContext?.SetOpenMobile(false);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        persistSubscription.Dispose();
    }
}
