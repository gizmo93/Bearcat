{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "System.Net.Http.HttpClient": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Database": {
        "ConnectionString": "<define-per-stage>"
    },
    "Bearcat": {
        "DesktopMode": false
    },
    "Archivers": {
        "RarPath": "rar",
        "SevenZipPath": "7z"
    },
    "ReleaseDataDirectory": "<define-per-stage>",
    "LocalTimezone": "Europe/Zurich"
}
