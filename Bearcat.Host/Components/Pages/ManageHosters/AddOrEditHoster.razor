<EditForm EditContext="editContext" OnValidSubmit="@(() => SaveAsync())">
    <MudDialog>
        <TitleContent>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                @if (FormModel.IsEdit)
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Edit"/>
                }
                else
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Add"/>
                }
                <MudText Typo="Typo.h6">
                    @MudDialog.Title
                </MudText>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudStack>
                <MudTextField
                    Label="Name"
                    Placeholder="Enter a name for the configuration"
                    @bind-Value="FormModel.Name"/>

                <MudSelect
                    Label="Hoster"
                    Placeholder="Select a hoster"
                    Disabled="FormModel.IsEdit"
                    @bind-Value="FormModel.FullClassName"
                    @bind-Value:after="@(OnSelectedHosterChanged)">
                    @foreach (var hoster in hosterReadModels)
                    {
                        <MudSelectItem Value="@hoster.HosterClassName">@hoster.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (selectedHoster is not null)
                {
                    @foreach (var key in selectedHoster.ConfigurationKeys)
                    {
                        var isPasswordField = key.ToLowerInvariant() == "password";
                        
                        <MudStack Row>
                            <MudTextField
                                Label="@key"
                                Value="@FormModel.Configuration.GetValueOrDefault(key)"
                                InputType="@(isPasswordField && !displayedPasswords.Contains(key) ? InputType.Password : InputType.Text)"
                                ValueChanged="@(EventCallback.Factory.Create<string?>(this, value => OnConfigurationValueChanged(key, value)))"/>
                            
                            @if (isPasswordField)
                            {
                                <MudIconButton 
                                    Size="Size.Small"
                                    Icon="@(displayedPasswords.Contains(key)
                                              ? Icons.Material.Filled.VisibilityOff
                                              : Icons.Material.Filled.Visibility)"
                                    OnClick="@(() => ToggleShowHidePassword(key))"/>
                            }
                        </MudStack>
                    }
                }

                <div style="color: red;">
                    <ValidationMessage For="@(() => FormModel.Name)"/>
                    <ValidationMessage For="@(() => FormModel.FullClassName)"/>
                    <ValidationMessage For="@(() => FormModel.Configuration)"/>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => Cancel())" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
                Save
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>