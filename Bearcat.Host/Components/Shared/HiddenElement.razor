<MudStack AlignItems="AlignItems.Center" Spacing="3" Row>
    @if (isVisible)
    {
        @ChildContent
    }
    else
    {
        <p>******</p>
    }
    <MudIconButton
        Size="Size.Small"
        OnClick="@(() => OnToggleVisibilityAsync())"
        Icon="@(isVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"/>
</MudStack>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Inject] 
    public IDialogService DialogService { get; set; } = null!;

    private async Task OnToggleVisibilityAsync()
    {
        if (isVisible)
        {
            isVisible = false;
            return;
        }
        
        var result = await DialogService.ShowMessageBoxAsync(
            title: "Show hidden content",
            message: "Are you sure you want to show this hidden content?", 
            yesText: "Yes", 
            noText: "No");

        if (result == true)
        {
            isVisible = true;
        }
    }

    private bool isVisible;
}