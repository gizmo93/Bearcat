# PostgreSQL Data Directory
# For PostgreSQL 18+, this mounts to /var/lib/postgresql (not /data)
# The database files will be stored in a subdirectory automatically
# Example: POSTGRES_DATA_DIR=/path/to/your/postgres-data
POSTGRES_DATA_DIR=./postgres-data

# PostgreSQL Database Credentials
# These are used for both the Postgres container and the Bearcat connection
POSTGRES_DB=bearcat
POSTGRES_USER=bearcat
POSTGRES_PASSWORD=bearcat123

# PostgreSQL Host Port (external access from your Mac)
# Change this if port 5432 is already in use
# Inside Docker network, PostgreSQL always uses port 5432
POSTGRES_PORT=5432

# Path to your releases directory
RELEASES_DIR=/path/to/your/releases/library1