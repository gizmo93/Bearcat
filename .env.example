# ---------------------------------------------------------------------------
# General settings
# ---------------------------------------------------------------------------

# Path to your releases directory
RELEASES_DIR=/path/to/your/releases/library1

# Bearcat Web Frontend Port (external access from your host)
# Change this if port 8080 is already in use
# Inside Docker container, ASP.NET always uses port 8080
BEARCAT_PORT=8080

# Bearcat application data directory
# Bearcat stores its encryption key in this directory as bearcat.key.
# With the default SQLite setup, the database file bearcat.db is stored here as well.
# Back up this directory. With PostgreSQL, back it up together with your PostgreSQL data.
# Do not place this directory on a network share (NFS/SMB) when using SQLite.
BEARCAT_DATA_DIR=./bearcat-data

# Bearcat REST API key
# Required in the X-Api-Key header for POST endpoints. Leave empty to disable them.
# Generate one with: openssl rand -hex 32
BEARCAT_API_KEY=

# Bearcat image
BEARCAT_IMAGE=ghcr.io/gizmo93/bearcat:latest

BEARCAT_CPU_LIMIT=0.5
BEARCAT_MEMORY_LIMIT=200M

# ---------------------------------------------------------------------------
# Only needed with docker-compose.postgres.yml
# ---------------------------------------------------------------------------
# docker-compose.yml runs Bearcat with SQLite. To use PostgreSQL instead, start with:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
# Or uncomment the following line so that a plain "docker compose up -d" uses PostgreSQL.
# Existing installations that already use PostgreSQL should set this when updating their compose files.
# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# PostgreSQL Data Directory
# For PostgreSQL 18+, this mounts to /var/lib/postgresql (not /data)
# The database files will be stored in a subdirectory automatically
# Example: POSTGRES_DATA_DIR=/path/to/your/postgres-data
POSTGRES_DATA_DIR=./postgres-data

# PostgreSQL Database Credentials
# These are used for both the Postgres container and the Bearcat connection
POSTGRES_DB=bearcat
POSTGRES_USER=bearcat
POSTGRES_PASSWORD=bearcat123
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=200M

# PostgreSQL Host Port (external access from your Mac)
# Change this if port 5432 is already in use
# Inside Docker network, PostgreSQL always uses port 5432
POSTGRES_PORT=5432
