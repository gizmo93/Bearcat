<Project>
    <PropertyGroup>
        <Description>Bearcat</Description>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Overridden by the release workflows via -p:Version=<tag> -->
        <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>S2365,S3220,S1450,NU1902,S8969,S8970,NU1903</NoWarn>
    </PropertyGroup>
    <Import
        Project="Directory.Build.local.props"
        Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')"
    />
    <ItemGroup>
        <PackageReference
            Include="Shane32.Analyzers"
            PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers"
        />
        <PackageReference
            Include="SonarAnalyzer.CSharp"
            PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers"
        />
        <PackageReference Include="CSharpier.MSBuild" PrivateAssets="all" />
    </ItemGroup>
</Project>
