@page "/configurations"
@inherits OwningComponentBase

<PageTitle>@L["Configurations"] - Bearcat</PageTitle>

<section class="mx-auto flex w-full max-w-5xl flex-col gap-4">
    <div class="bearcat-page-header">
        <div class="min-w-0">
            <h1 class="text-3xl font-semibold tracking-tight">@L["Configurations"]</h1>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
                @L["ApplicationConfigurationsIntro"]
            </p>
        </div>
    </div>

    @if (isLoading)
    {
        <BbCard Class="border-border/70 shadow-sm">
            <BbCardContent Class="py-8">
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <BbSpinner Size="SpinnerSize.Small" />
                    <span>@L["Loading"]</span>
                </div>
            </BbCardContent>
        </BbCard>
    }
    else
    {
        @foreach (var configuration in configurations)
        {
            <BbCard Class="border-border/70 shadow-sm">
                <BbCardHeader>
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <LucideIcon Name="settings" class="h-4 w-4 text-muted-foreground" />
                                <BbCardTitle class="text-base">@L[configuration.DisplayName]</BbCardTitle>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(configuration.Description))
                            {
                                <BbCardDescription>@L[configuration.Description]</BbCardDescription>
                            }
                        </div>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <div class="divide-y divide-border/70">
                        @foreach (var property in configuration.Properties)
                        {
                            <div class="grid gap-3 py-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <p class="text-sm font-medium">@L[property.DisplayName]</p>
                                        @if (property.IsOverridden)
                                        {
                                            <BbBadge Variant="BadgeVariant.Secondary">@L["Override"]</BbBadge>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(property.Description))
                                    {
                                        <p class="mt-1 text-xs text-muted-foreground">@L[property.Description]</p>
                                    }
                                    <p class="mt-2 text-xs text-muted-foreground">
                                        @L["DefaultValue"]: @FormatValue(property.DefaultValue, property.ValueType)
                                    </p>
                                </div>

                                <div class="flex flex-wrap items-center gap-2 md:justify-end">
                                    @if (property.ValueType == typeof(bool))
                                    {
                                        <label class="flex items-center gap-2 text-sm">
                                            <BbSwitch Checked="@GetBoolValue(property)"
                                                      CheckedChanged="@(async value => await SaveBoolAsync(property, value))"
                                                      Size="SwitchSize.Small"
                                                      AriaLabel="@L[property.DisplayName]" />
                                            <span>@FormatValue(property.CurrentValue, property.ValueType)</span>
                                        </label>
                                    }
                                    else
                                    {
                                        <input class="h-9 min-w-48 rounded-md border border-input bg-background px-3 text-sm"
                                               value="@GetEditorValue(property)"
                                               @oninput="eventArgs => SetEditorValue(property, eventArgs.Value?.ToString())" />
                                        <BbButton Variant="ButtonVariant.Outline"
                                                  Size="ButtonSize.Small"
                                                  OnClick="@(async () => await SaveEditorValueAsync(property))">
                                            @L["Save"]
                                        </BbButton>
                                    }

                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.IconSmall"
                                              Disabled="@(!property.IsOverridden)"
                                              AriaLabel="@L["ResetToDefault"]"
                                              OnClick="@(async () => await ResetOverrideAsync(property))">
                                        <LucideIcon Name="rotate-ccw" class="h-4 w-4" />
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                </BbCardContent>
            </BbCard>
        }
    }
</section>
