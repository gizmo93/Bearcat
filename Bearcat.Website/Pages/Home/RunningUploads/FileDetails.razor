@using Bearcat.Domain.ValueObjects
<MudTr>
    <td colspan="4">
        <MudCard Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.body1">Upload status</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable
                    Items="@Upload.Archive!.ArchiveFiles.OrderBy(a => a.FullFileName)"
                    Hover="true"
                    Breakpoint="Breakpoint.None"
                    HorizontalScrollbar="true"
                    Elevation="0"
                    Dense="true">

                    <HeaderContent>
                        <MudTh>File</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd>@context.FullFileName</MudTd>
                        <MudTd>
                            @{
                                var uploadedFile = Upload.UploadedFiles.FirstOrDefault(x => x.ArchiveFileId == context.Id);

                                if (uploadedFile is not null)
                                {
                                    <MudIcon
                                        Color="@(uploadedFile.OnlineState == OnlineState.Online ? Color.Success : Color.Error)"
                                        Icon="@(uploadedFile.OnlineState == OnlineState.Online ? Icons.Material.Filled.Check : Icons.Material.Filled.Error)"/>
                                }
                                else
                                {
                                    <MudIcon Color="Color.Default"
                                             Icon="@Icons.Material.Filled.UploadFile"/>
                                }
                            }
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            </MudCardContent>
        </MudCard>
    </td>
</MudTr>
