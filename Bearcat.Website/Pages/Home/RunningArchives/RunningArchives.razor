<MudStack Spacing="2" AlignItems="AlignItems.Start">
    <MudText Typo="Typo.h6">Running archives</MudText>
    <MudTable 
        Items="Archives"
        Elevation="4"
        Dense="true"
        HorizontalScrollbar="true"
        Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Release</MudTh>
            <MudTh>Archive config</MudTh>
            <MudTh>Archiver</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Id</MudTd>
            <MudTd>@context.ArchiveConfig.Release.Name</MudTd>
            <MudTd>@context.ArchiveConfig.Name</MudTd>
            <MudTd>@context.ArchiveConfig.ArchiverName</MudTd>
        </RowTemplate>
    </MudTable>
</MudStack>