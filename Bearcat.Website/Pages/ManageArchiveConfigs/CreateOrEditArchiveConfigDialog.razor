@inherits OwningComponentBase

<EditForm EditContext="editContext" OnValidSubmit="@(() => SaveAsync())">
    <MudDialog>
        <TitleContent>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                @if (isEdit)
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Edit" />
                }
                else
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Add" />
                }
                <MudText Typo="Typo.h6">@MudDialog.Title</MudText>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="4">
                <MudTextField @bind-Value="FormModel.Name" Label="Name" />
                <MudSelect @bind-Value="FormModel.ArchiverName" Label="Archiver" Disabled="isEdit">
                    @foreach (var archiver in archivers)
                    {
                        <MudSelectItem Value="@archiver.ClassName">@archiver.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (FormModel.ArchiverName is not null)
                {
                    <MudStack Row AlignItems="AlignItems.Baseline">
                        <MudTextField
                            @bind-Value="FormModel.ArchiveNamePrefix"
                            Label="Archive name prefix"/>
                        <MudText Typo="Typo.body1">@SelectedArchiver?.FileExtension</MudText>
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption">Archive files folder</MudText>
                        <MudStack Row>
                            <MudTextField @bind-Value="FormModel.ArchiveFilesBasePath" Disabled/>
                            <MudButton
                                OnClick="@(() => ShowSelectFolderDialogAsync())"
                                Variant="Variant.Filled"
                                Size="Size.Small"
                                IconColor="@(string.IsNullOrWhiteSpace(FormModel.ArchiveFilesBasePath) ? Color.Warning : Color.Success)"
                                StartIcon="@(string.IsNullOrWhiteSpace(FormModel.ArchiveFilesBasePath) ? Icons.Material.Filled.Error : Icons.Material.Filled.Check)">
                                Select archive files folder
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    <MudTextField @bind-Value="FormModel.ArchivePassword" Label="Archive password"/>
                    <MudNumericField @bind-Value="@FormModel.ArchiveFileSizeMb" Label="Archive file size (MB)"/>
                }

                <div style="color: red;">
                    <ValidationMessage For="@(() => FormModel.ArchiverName)"/>
                    <ValidationMessage For="@(() => FormModel.ArchiveFilesBasePath)"/>
                    <ValidationMessage For="@(() => FormModel.ArchiveFileSizeMb)"/>
                    <ValidationMessage For="@(() => FormModel.ArchiveNamePrefix)"/>
                    <ValidationMessage For="@(() => FormModel.ArchivePassword)"/>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => MudDialog.Cancel())" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check">
                Save
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>