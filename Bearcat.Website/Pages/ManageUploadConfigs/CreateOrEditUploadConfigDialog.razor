@inherits OwningComponentBase

@if (!isInitialized)
{
    return;
}

<EditForm EditContext="editContext" OnValidSubmit="@(() => SaveAsync())">
    <MudDialog>
        <TitleContent>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                @if (IsEdit)
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Edit" />
                }
                else
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Add" />
                }
                <MudText Typo="Typo.h6">@MudDialog.Title</MudText>
            </MudStack>
        </TitleContent>
        
        <DialogContent>
            <MudStack Spacing="4">
                <MudTextField @bind-Value="@formModel.Name" Label="Name" />
                
                <MudSelect @bind-Value="@formModel.HosterRegistrationId" Label="Hoster registration">
                    @foreach (var (id, name) in hosterRegistrationOptions.OrderBy(kvp => kvp.Value))
                    {
                        <MudSelectItem Value="@((int?)id)">@name</MudSelectItem>
                    }
                </MudSelect>
                
                <MudSelect @bind-Value="@formModel.ArchiveConfigId" Label="Archive configuration">
                    @foreach (var (id, name) in archiveConfigOptions.OrderBy(kvp => kvp.Value))
                    {
                        <MudSelectItem Value="@((int?)id)">@name</MudSelectItem>
                    }
                </MudSelect>
                
                <MudStack Spacing="2">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudTooltip Text="Here you can add for example forum links, where you shared the links of the current upload config to not forget them">
                            <MudText Typo="Typo.caption">
                                Links distributed to
                            </MudText>
                        </MudTooltip>
                        <MudIconButton OnClick="@(() => AddLinkDistributedTo())" Size="Size.Small" Icon="@Icons.Material.Filled.Add" />
                    </MudStack>
                    @foreach (var index in formModel.LinksDistributedTo.Select((_, i) => i))
                    {
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                            <MudTextField @bind-Value="@formModel.LinksDistributedTo[index]" />
                            <MudIconButton OnClick="@(() => DeleteLinkDistributedTo(index))" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" />
                        </MudStack>
                    }
                </MudStack>
                <div style="color: red;">
                    <ValidationMessage For="@(() => formModel.Name)"/>
                    <ValidationMessage For="@(() => formModel.HosterRegistrationId)"/>
                    <ValidationMessage For="@(() => formModel.ArchiveConfigId)"/>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => MudDialog.Cancel())" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check">
                Save
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>