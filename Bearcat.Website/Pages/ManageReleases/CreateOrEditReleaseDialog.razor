@page "/releases/create"
@using Bearcat.Domain.ValueObjects
@inherits OwningComponentBase

<EditForm EditContext="editContext" OnValidSubmit="@(() => SaveAsync())">
    <MudDialog>
        <TitleContent>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                @if (formModel.IsEdit)
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Edit" />
                }
                else
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Add" />
                }
                <MudText Typo="Typo.h6">@MudDialog.Title</MudText>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudStack>
                <MudTextField Label="Name" Placeholder="Name your release" @bind-Value="formModel.Name"/>
                
                <MudSelect
                    Label="Release type"
                    Placeholder="Select a release type"
                    @bind-Value="formModel.ReleaseType">
                    @foreach (var releaseType in Enum.GetValues<ReleaseType>())
                    {
                        <MudSelectItem Value="@((ReleaseType?)releaseType)">
                            <MudStack>
                                <MudText Typo="Typo.body2">@releaseType</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: lighter;">
                                   @releaseType.Description
                                </MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
                
                <MudStack>
                    <MudText Typo="Typo.caption">Release folder</MudText>
                    <MudStack Row>
                        <MudTextField @bind-Value="formModel.FolderPath" Disabled/>
                        <MudButton
                            OnClick="@(() => ShowSelectFolderDialogAsync())"
                            Variant="Variant.Filled"
                            Size="Size.Small"
                            IconColor="@(string.IsNullOrWhiteSpace(formModel.FolderPath) ? Color.Warning : Color.Success)"
                            StartIcon="@(string.IsNullOrWhiteSpace(formModel.FolderPath) ? Icons.Material.Filled.Error : Icons.Material.Filled.Check)">
                            Select release folder
                        </MudButton>
                    </MudStack>
                </MudStack>
                
                <div style="color: red;">
                    <ValidationMessage For="@(() => formModel.Name)"/>
                    <ValidationMessage For="@(() => formModel.ReleaseType)"/>
                    <ValidationMessage For="@(() => formModel.FolderPath)"/>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Secondary" OnClick="@(() => MudDialog.Cancel())" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
                Create release
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>