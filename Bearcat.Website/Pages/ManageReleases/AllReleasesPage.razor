@page "/releases"
@using Bearcat.Domain.UseCases.ManageReleases.Dto
@using Bearcat.Domain.ValueObjects
@using Bearcat.Website.Shared
@inherits OwningComponentBase

<PageTitle>Releases - Bearcat</PageTitle>


<MudStack Spacing="3" AlignItems="AlignItems.Baseline">
    <MudText Typo="Typo.h4">Releases</MudText>
    
    <MudFab
        Size="Size.Small"
        OnClick="@(() => ShowAddReleaseDialogAsync())"
        StartIcon="@Icons.Material.Filled.Add"
        Color="Color.Primary"
        Label="Add release" />
    
    <MudDataGrid
        T="ReleaseDto"
        Items="releases"
        SortMode="SortMode.Multiple"
        Dense="true"
        Elevation="4"
        RowClick="@(args => navigationManager.NavigateTo($"releases/{args.Item.ReleaseId}"))"
        RowClass="cursor-pointer"
        Hover
        RowContextMenuClick="OpenMenuContent">
        <Columns>
            <PropertyColumn Property="@(row => row.Name)" Title="Name" />
            <TemplateColumn>
                <CellTemplate>
                    <OnlineStateBadge Value="@context.Item?.OnlineState" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Release type" Sortable="true" SortBy="@(row => row.ReleaseType.ToString())">
                <CellTemplate>
                    <MudTooltip Text="@context.Item.ReleaseType.Description">
                        @context.Item.ReleaseType
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(row => row.ReleaseFolderPath)" Title="Folder path"/>
        </Columns>
    </MudDataGrid>
    
    <MudMenu PositionAtCursor="true" id="contextMenu" @ref="contextMenu">
        <MudMenuItem
            Icon="@Icons.Material.Filled.Delete"
            OnClick="@(() => DeleteReleaseAsync(contextMenuRow!))">
            Delete Release @contextMenuRow!.Name
        </MudMenuItem>
    </MudMenu>
</MudStack>