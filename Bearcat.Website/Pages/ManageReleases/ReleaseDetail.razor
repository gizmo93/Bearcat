@page "/releases/{releaseId:int}"
@using Bearcat.Website.Pages.ManageArchiveConfigs
@using Bearcat.Website.Pages.ManageUploadConfigs
@inherits OwningComponentBase

@if (!isInitialized)
{
    return;
}

<PageTitle>Release - @release.Name</PageTitle>


<MudStack>
    <MudCard Elevation="3">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@release.Name</MudText>
                    <MudChip T="string" Color="Color.Primary"
                             Variant="Variant.Outlined">@release.ReleaseType</MudChip>
                </MudStack>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudMenu Color="Color.Primary" Icon="@Icons.Material.Filled.Menu" Label="Edit">
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete">Delete release</MudMenuItem>
                </MudMenu>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            <MudStack>
                <MudStack>
                    <MudText Typo="Typo.caption">Release folder</MudText>
                    <MudText Typo="Typo.body1">@release.ReleaseFolderPath</MudText>
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>
    <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <MudTabPanel Text="Configuration">
            <MudGrid>
                <MudItem xl="4" lg="4" md="12" sm="12" xs="12">
                    <ArchiveConfigs 
                        @ref="@reloadableComponents[nameof(ArchiveConfigs)]"
                        ReleaseId="ReleaseId"
                        OnChangeAffectingOtherComponents="HandleChangeAffectingOtherComponentsAsync" />
                </MudItem>
                <MudItem xl="8" lg="8" md="12" sm="12" xs="12">
                    <UploadConfigs 
                        @ref="@reloadableComponents[nameof(UploadConfigs)]"
                        ReleaseId="@ReleaseId" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudStack>
