@using Bearcat.Domain.ValueObjects
@if (Value is null)
{
    return;
}

<MudChip T="OnlineState" Size="@Size" Variant="Variant.Outlined" Color="color">@Value</MudChip>

@code {
    [Parameter]
    [EditorRequired]
    public OnlineState? Value { get; set; }
    
    [Parameter]
    public Size Size { get; set; } = Size.Small;

    private Color color;

    protected override void OnInitialized()
    {
        color = Value switch
        {
            OnlineState.Online => Color.Success,
            OnlineState.PartiallyOnline => Color.Warning,
            OnlineState.Offline => Color.Error,
            _ => Color.Default
        };
    }

}